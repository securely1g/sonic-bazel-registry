#!/bin/bash
# Run the ARM Go test where its child processes can also execute native Bazel.
# The registered ARM binfmt interpreter handles recursively launched ARM tools.
set -euo pipefail
export LC_ALL=C
readelf -h "$1" | grep -Eq 'Machine: +AArch64$'
export QEMU_LD_PREFIX=/opt/sonic-arm64-rootfs
export PATH="$(cd "$(dirname "$0")" && pwd):$PATH"
exec /usr/bin/qemu-aarch64 -L "$QEMU_LD_PREFIX" "$@"
