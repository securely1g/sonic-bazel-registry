# CI cross environment only: do not override explicit configure aliases or
# change native compiler invocations used to build execution tools.
if test -z "${host_alias-}" && test -z "${build_alias-}" \
    && test "$(uname -m)" = x86_64 && test -n "${CC-}"; then
    registry_ci_cc_target=$(eval "$CC -dumpmachine" 2>/dev/null) || registry_ci_cc_target=
    case "$registry_ci_cc_target" in
        aarch64*-linux-gnu*)
            host_alias=$registry_ci_cc_target
            build_alias=x86_64-linux-gnu
            ac_tool_prefix=$host_alias-
            cross_compiling=yes
            echo "registry-ci site: host=$host_alias build=$build_alias cross_compiling=$cross_compiling" >&2
            ;;
    esac
    unset registry_ci_cc_target
fi

# MIT Kerberos 1.21.3 stops configure when these three runtime checks have
# no cross answers. Measure each result on the selected ARM target.
if test "${cross_compiling-}" = yes && test -f "$0" &&
    grep -Fq 'Cannot test for constructor/destructor support when cross compiling' "$0"; then
    case "$host_alias" in
        aarch64*-linux-gnu*)
            registry_ci_krb5_probe=$(mktemp -d "$PWD/krb5-cross-probes.XXXXXXXX") || exit 1
            cat > "$registry_ci_krb5_probe/probe.c" <<'C'
#include <regex.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

static void before_main(void) __attribute__((constructor));
static void after_main(void) __attribute__((destructor));

static void before_main(void) { unlink("conftest.1"); }
static void after_main(void) { unlink("conftest.2"); }

int main(void) {
    regex_t expression;
    regmatch_t match;
    char output[30];
    int regex_ok = regcomp(&expression, "pat.*", 0) == 0 &&
                   regexec(&expression, "pattern", 1, &match, 0) == 0;
    sprintf(output, "%2$x %1$d", 100, 512);
    printf("%s %s\n", regex_ok ? "yes" : "no", strcmp(output, "200 100") == 0 ? "yes" : "no");
    return 0;
}
C
            (
                # Compile in configure's original cwd: its response files and
                # compiler arguments can contain paths relative to that directory.
                $CC ${CFLAGS-} ${CPPFLAGS-} "$registry_ci_krb5_probe/probe.c" ${LDFLAGS-} \
                    -o "$registry_ci_krb5_probe/probe" || exit 1
                LC_ALL=C readelf -h "$registry_ci_krb5_probe/probe" | grep -Eq 'Machine: +AArch64$' || exit 1
                cd "$registry_ci_krb5_probe" || exit 1
                touch conftest.1 conftest.2 || exit 1
                /usr/bin/qemu-aarch64 -L /opt/sonic-arm64-rootfs ./probe > libc-results || exit 1
                read -r regex positional < libc-results || exit 1
                constructor=no; destructor=no
                test -e conftest.1 || constructor=yes
                test -e conftest.2 || destructor=yes
                printf '%s,%s %s %s\n' "$constructor" "$destructor" "$regex" "$positional" > results
            ) || exit 1
            read -r registry_attrs registry_regex registry_positional < "$registry_ci_krb5_probe/results" || exit 1
            : "${krb5_cv_attr_constructor_destructor=$registry_attrs}"
            : "${ac_cv_func_regcomp=$registry_regex}"
            : "${ac_cv_printf_positional=$registry_positional}"
            printf 'Kerberos ARM runtime probes: attributes=%s regcomp=%s positional_printf=%s\n' \
                "$registry_attrs" "$registry_regex" "$registry_positional" >&2
            rm -rf "$registry_ci_krb5_probe"
            unset registry_ci_krb5_probe registry_attrs registry_regex registry_positional
            ;;
    esac
fi
