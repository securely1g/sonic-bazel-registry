#!/bin/sh
# A foreign build may invoke the selected target compiler without Bazel's link
# flags. In particular, libtool filters -B when linking a shared library.
set -eu
driver=$0
case "$driver" in /*) ;; *) driver="$PWD/$driver" ;; esac
adapter=${driver%/*}
sysroot="$adapter/sysroot"
exec "$adapter/compiler/bin/aarch64-linux-gnu-gcc" \
    --sysroot="$sysroot" \
    -B"$sysroot/usr/lib/gcc/aarch64-linux-gnu/14/" \
    -B"$sysroot/usr/lib/aarch64-linux-gnu/" "$@"
