load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# gazelle:prefix github.com/openconfig/goyang
# gazelle:proto disable_global
# gazelle:go_naming_convention import_alias
gazelle(name = "gazelle")

go_library(
    name = "goyang_lib",
    srcs = [
        "annotate.go",
        "tree.go",
        "types.go",
        "yang.go",
    ],
    importpath = "github.com/openconfig/goyang",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/indent",
        "//pkg/yang",
        "@com_github_pborman_getopt//:getopt",
    ],
)

go_binary(
    name = "goyang",
    embed = [":goyang_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "sonic_annotation_test",
    srcs = ["sonic_annotation_test.go"],
    args = ["-test.v"],
    embed = [":goyang_lib"],
    deps = ["//pkg/yang"],
)

filegroup(
    name = "root_testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//pkg/yang:__pkg__"],
)
