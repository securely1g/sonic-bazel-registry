+// orderedDirKeys preserves the declared YANG child order. Some synthetic
+// entries have only a Dir map; append their missing keys in a stable order.
+func (e *Entry) orderedDirKeys() []string {
+	keys := make([]string, 0, len(e.Dir))
+	seen := make(map[string]bool, len(e.Dir))
+	for _, key := range e.DirOKeys {
+		if _, exists := e.Dir[key]; exists && !seen[key] {
+			keys = append(keys, key)
+			seen[key] = true
+		}
+	}
+	var missing []string
+	for key := range e.Dir {
+		if !seen[key] {
+			missing = append(missing, key)
+		}
+	}
+	sort.Strings(missing)
+	return append(keys, missing...)
+}
