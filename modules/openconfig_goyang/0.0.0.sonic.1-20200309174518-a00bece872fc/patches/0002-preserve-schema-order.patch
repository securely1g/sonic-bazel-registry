+// orderedModules gives cross-module augments a stable traversal order while
+// preserving the declaration order of statements within each module.
+func orderedModules(modules map[string]*Module) []*Module {
+	names := make([]string, 0, len(modules))
+	for name := range modules {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	ordered := make([]*Module, 0, len(names))
+	for _, name := range names {
+		ordered = append(ordered, modules[name])
+	}
+	return ordered
+}
