module(
    name = "openconfig_goyang",
    version = "0.0.0.sonic.1-20200309174518-a00bece872fc",
    bazel_compatibility = [">=8.5.1"],
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.9")

# Standard Gazelle mapping makes this Bazel module the owner of this Go path.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_google_go_cmp",
    "com_github_kylelemons_godebug",
    "com_github_openconfig_gnmi",
    "com_github_pborman_getopt",
)
