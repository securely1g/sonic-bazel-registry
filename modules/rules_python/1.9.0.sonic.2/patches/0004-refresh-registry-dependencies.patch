From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH] Refresh rules_python registry dependency versions

The registry dependency refresh selects the newest non-yanked module
versions published at catalog 3d1cc5e8dfd553d2acbe4198e504a245e6bdbddf.
Apply this after the inherited patch series so the fetched MODULE
matches the registry declaration. Package source and behavior patches
remain unchanged. This is a downstream registry integration change.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,6 +1,6 @@
 module(
     name = "rules_python",
-    version = "1.9.0.sonic.1",
+    version = "1.9.0.sonic.2",
     compatibility_level = 1,
 )
 
@@ -226,7 +226,7 @@
 
 # Extra gazelle plugin deps so that WORKSPACE.bzlmod can continue including it for e2e tests.
 # We use `WORKSPACE.bzlmod` because it is impossible to have dev-only local overrides.
-bazel_dep(name = "rules_go", version = "0.41.0", dev_dependency = True, repo_name = "io_bazel_rules_go")
+bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", dev_dependency = True, repo_name = "io_bazel_rules_go")
 
 internal_dev_deps = use_extension(
     "//python/private:internal_dev_deps.bzl",
