diff --git a/tests/tools/wheelmaker_test.py b/tests/tools/wheelmaker_test.py
--- a/tests/tools/wheelmaker_test.py
+++ b/tests/tools/wheelmaker_test.py
@@ -1,7 +1,39 @@
 import io
+import stat
+import tempfile
+import zipfile
+from pathlib import Path
 import unittest
 
 import tools.wheelmaker as wheelmaker
+
+
+class RegularFileModeTest(unittest.TestCase):
+    """Wheel consumers observe declared modes for source and generated members."""
+
+    def test_declared_modes_and_legacy_default(self):
+        for declared, expected in [("", 0o777), ("0644", 0o644), ("0755", 0o755)]:
+            with self.subTest(mode=declared), tempfile.TemporaryDirectory() as temp:
+                source = Path(temp) / "source.py"
+                source.write_text("answer = 42\n")
+                # Archive permissions must follow the declaration, not source mode.
+                source.chmod(0o755 if expected == 0o644 else 0o644)
+                buf = io.BytesIO()
+                with wheelmaker._WhlFile(
+                    buf,
+                    mode="w",
+                    distribution_prefix="example-1.0",
+                    regular_file_mode=declared,
+                ) as whl:
+                    whl.add_file("example/source.py", source)
+                    whl.add_string(whl.distinfo_path("METADATA"), "Name: example\n")
+                    whl.add_recordfile()
+                with zipfile.ZipFile(buf) as archive:
+                    self.assertEqual(len(archive.infolist()), 3)
+                    for member in archive.infolist():
+                        mode = member.external_attr >> 16
+                        self.assertTrue(stat.S_ISREG(mode), member.filename)
+                        self.assertEqual(stat.S_IMODE(mode), expected, member.filename)
 
 
