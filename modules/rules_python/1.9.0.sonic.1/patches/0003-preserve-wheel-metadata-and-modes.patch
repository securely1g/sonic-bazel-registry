diff --git a/tests/py_wheel/py_wheel_tests.bzl b/tests/py_wheel/py_wheel_tests.bzl
--- a/tests/py_wheel/py_wheel_tests.bzl
+++ b/tests/py_wheel/py_wheel_tests.bzl
@@ -212,3 +212,50 @@
         basic_tests = _basic_tests,
         tests = _tests,
     )
+
+
+def _test_missing_license_file(name):
+    rt_util.helper_target(
+        py_wheel,
+        name = name + "_subject",
+        distribution = "example",
+        version = "1.0",
+        license_files = ["LICENSE"],
+    )
+    analysis_test(
+        name = name,
+        impl = _test_missing_license_file_impl,
+        target = name + "_subject",
+        expect_failure = True,
+    )
+
+def _test_missing_license_file_impl(env, target):
+    env.expect.that_target(target).failures().contains_predicate(
+        matching.str_matches("requires extra_distinfo_files destination"),
+    )
+
+_tests.append(_test_missing_license_file)
+
+def _test_invalid_license_path(name):
+    for suffix, path in [("parent", "../LICENSE"), ("absolute", "/LICENSE"), ("backslash", "licenses\\LICENSE"), ("empty", ""), ("directory", ".")]:
+        rt_util.helper_target(
+            py_wheel,
+            name = name + "_" + suffix + "_subject",
+            distribution = "example",
+            version = "1.0",
+            license_files = [path],
+        )
+        analysis_test(
+            name = name + "_" + suffix,
+            impl = _test_invalid_license_path_impl,
+            target = name + "_" + suffix + "_subject",
+            expect_failure = True,
+        )
+    native.test_suite(name = name, tests = [name + "_" + s for s in ["parent", "absolute", "backslash", "empty", "directory"]])
+
+def _test_invalid_license_path_impl(env, target):
+    env.expect.that_target(target).failures().contains_predicate(
+        matching.str_matches("license_files paths must be relative"),
+    )
+
+_tests.append(_test_invalid_license_path)
