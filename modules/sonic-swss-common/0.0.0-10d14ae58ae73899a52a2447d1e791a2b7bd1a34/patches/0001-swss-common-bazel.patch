+"""Compiler and linker flags shared across the sonic-swss-common build."""
+
+load(":bzlmod.bzl", "IS_BZLMOD")
+
+# CXXFLAGS that we need for Bazel specifically. Not present in the Makefile
+CXXFLAGS_COMMON_BAZEL = [
