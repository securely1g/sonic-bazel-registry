module(
    name = "p4c",
    version = "1.2.4.2.sonic.2",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.9")
bazel_dep(name = "sonic-build-infra", version = "0.0.20-28a3aa9b96f1ce66e4ce04f9a7d26c96e3bbb0c6", repo_name = "sonic_build_infra")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc-14.2.0-linux-target-aarch64-host-aarch64", "gcc-14.2.0-linux-target-x86_64-host-x86_64", "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
    "@sonic_build_infra//tools/build_tools:autoconf_toolchain",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "p4c_deps",
    packages = [
        "libboost-graph1.83-dev",
        "libboost-iostreams1.83.0",
        "libboost-iostreams1.83-dev",
        "libboost-regex1.83.0",
        "libboost-serialization1.83.0",
        "libbz2-1.0",
        "libfl-dev",
        "libfl2",
        "libgc-dev",
        "libgc1",
        "libgmp-dev",
        "libgmp10",
        "libgmpxx4ldbl",
        "liblzma5",
        "libzstd1",
        "zlib1g",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "p4c_deps")

p4c_source = use_repo_rule("//:bazel/source.bzl", "p4c_source")

p4c_source(
    name = "p4c_source",
    overlays = {
        "//:bazel/p4c.BUILD.bazel": "BUILD.bazel",
        "//:bazel/runtime.bzl": "bazel/runtime.bzl",
        "//:bazel/python.py": "bazel/python.py",
        "//:bazel/tool.bzl": "bazel/tool.bzl",
        "//:bazel/foreign.cmake": "bazel/foreign.cmake",
        "//:bazel/package_test.py": "bazel/package_test.py",
    },
    patches = [
        "//:bazel/native-protoc.patch",
        "//:bazel/use-boost-1.83.patch",
        "//:bazel/fix-build-for-boost-1.83.patch",
        "//:bazel/update-thrift-dependency.patch",
        "//:bazel/remove-protobuf-from-debian-dependency.patch",
        "//:bazel/remove-scapy-from-debian-dependency.patch",
    ],
)
