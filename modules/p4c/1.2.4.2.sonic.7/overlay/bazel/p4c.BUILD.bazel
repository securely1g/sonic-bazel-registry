genrule(
    name = "controlplane_protos",
    srcs = ["control-plane/google/rpc/status.proto"] + glob([
        "build/_deps/p4runtime-src/proto/**/*.proto",
        "build/_deps/protobuf-src/src/google/protobuf/*.proto",
    ]),
    outs = [
        "control-plane/google/rpc/status.pb.cc",
        "control-plane/google/rpc/status.pb.h",
        "control-plane/google/rpc/status_pb2.py",
        "control-plane/p4/config/v1/p4info.pb.cc",
        "control-plane/p4/config/v1/p4info.pb.h",
        "control-plane/p4/config/v1/p4info_pb2.py",
        "control-plane/p4/config/v1/p4types.pb.cc",
        "control-plane/p4/config/v1/p4types.pb.h",
        "control-plane/p4/config/v1/p4types_pb2.py",
        "control-plane/p4/v1/p4runtime.pb.cc",
        "control-plane/p4/v1/p4runtime.pb.h",
        "control-plane/p4/v1/p4runtime_pb2.py",
        "control-plane/p4/v1/p4data.pb.cc",
        "control-plane/p4/v1/p4data.pb.h",
        "control-plane/p4/v1/p4data_pb2.py",
    ],
    tools = [":protoc_tool"],
    cmd = """runtime="$(location build/_deps/p4runtime-src/proto/p4/config/v1/p4info.proto)"
protobuf="$(location build/_deps/protobuf-src/src/google/protobuf/descriptor.proto)"
status="$(location control-plane/google/rpc/status.proto)"
mkdir -p $(RULEDIR)/control-plane
$(location :protoc_tool) -I "$${runtime%/p4/config/v1/p4info.proto}" -I "$${status%/google/rpc/status.proto}" -I "$${protobuf%/google/protobuf/descriptor.proto}" --cpp_out=$(RULEDIR)/control-plane --python_out=$(RULEDIR)/control-plane --experimental_allow_proto3_optional \
$(location control-plane/google/rpc/status.proto) $(location build/_deps/p4runtime-src/proto/p4/config/v1/p4info.proto) $(location build/_deps/p4runtime-src/proto/p4/config/v1/p4types.proto) $(location build/_deps/p4runtime-src/proto/p4/v1/p4runtime.proto) $(location build/_deps/p4runtime-src/proto/p4/v1/p4data.proto)""",
)

