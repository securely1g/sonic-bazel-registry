exports_files(["debian/control", "debian/changelog"] + glob(["p4include/**"]))

# SONiC's fixed configure inputs; target feature probes are recorded at port time.
expand_template(
    name = "config_header",
    template = "cmake/config.h.cmake",
    out = "config.h",
    substitutions = {
        "#cmakedefine HAVE_LIBGMP 1": "/* #undef HAVE_LIBGMP */",
        "#cmakedefine HAVE_GC_PRINT_STATS 1": "/* #undef HAVE_GC_PRINT_STATS */",
        "#cmakedefine": "#define",
    },
)

cc_library(
    name = "configuration_headers",
    hdrs = ["config.h"],
    includes = ["."],
    defines = [
        "MAX_LOGGING_LEVEL=10",
        "CONFIG_PREFIX='\"/usr\"'",
        "CONFIG_PKGDATADIR='\"/usr/share/p4c\"'",
    ],
)

_SYSTEM_DEPS = [
    "@p4c_deps//libboost-graph1.83-dev:libboost-graph1.83",
    "@p4c_deps//libboost-iostreams1.83-dev:libboost_iostreams_cc",
    "@p4c_deps//libfl-dev:libfl",
    "@p4c_deps//libgc-dev:libgc",
    "@p4c_deps//libgc-dev:libgccpp_cc",
    "@p4c_deps//zlib1g-dev:zlib1g",
]

# Native GCC targets share the original C++17 and hardened release flags.
_SOURCE_ROOT = P4C_SOURCE_ROOT
_COPTS = [
    "-std=gnu++17",
    "-O3",
    "-g",
    "-DNDEBUG",
    "-fstack-protector-strong",
    "-D_FORTIFY_SOURCE=2",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Wno-overloaded-virtual",
    "-Wno-deprecated",
    "-Wno-deprecated-declarations",
    "-pedantic",
    "-fdiagnostics-color=never",
    "-Wdate-time",
    "-ffile-prefix-map=" + _SOURCE_ROOT + "=.",
    "-ffile-prefix-map=$(BINDIR)/" + _SOURCE_ROOT + "=./build",
    "-ffile-prefix-map=/proc/self/cwd=.",
]
_LINKOPTS = ["-pthread", "-Wl,-z,relro,-z,now", "-Wl,--build-id=sha1"]

