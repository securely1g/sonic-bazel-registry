        "usr/share/p4c/p4include/core.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/core.p4)",
        "usr/share/p4c/p4include/dpdk/pna.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/dpdk/pna.p4)",
        "usr/share/p4c/p4include/dpdk/psa.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/dpdk/psa.p4)",
        "usr/share/p4c/p4include/ebpf_model.p4 uid=0 gid=0 type=file mode=0644 content=$(location backends/ebpf/p4include/ebpf_model.p4)",
        "usr/share/p4c/p4include/pna.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/pna.p4)",
        "usr/share/p4c/p4include/tc/pna.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/tc/pna.p4)",
        "usr/share/p4c/p4include/ubpf_model.p4 uid=0 gid=0 type=file mode=0644 content=$(location backends/ubpf/p4include/ubpf_model.p4)",
        "usr/share/p4c/p4include/v1model.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/v1model.p4)",
        "usr/share/p4c/p4include/xdp_model.p4 uid=0 gid=0 type=file mode=0644 content=$(location p4include/xdp_model.p4)",
        "usr/share/p4c/p4c_src/__init__.py uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/__init__.py)",
        "usr/share/p4c/p4c_src/config.py uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/config.py)",
        "usr/share/p4c/p4c_src/driver.py uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/driver.py)",
        "usr/share/p4c/p4c_src/main.py uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/main.py)",
        "usr/share/p4c/p4c_src/util.py uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/util.py)",
        "usr/share/p4c/p4c_src/p4c.bmv2.cfg uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/p4c.bmv2.cfg)",
        "usr/share/p4c/p4c_src/p4c.ebpf.cfg uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/p4c.ebpf.cfg)",
        "usr/share/p4c/p4c_src/p4c.dpdk.cfg uid=0 gid=0 type=file mode=0644 content=$(location tools/driver/p4c_src/p4c.dpdk.cfg)",
        "usr/bin/p4c uid=0 gid=0 type=file mode=0755 content=$(location :installed_driver)",
        "usr/share/doc/p4lang-p4c/copyright uid=0 gid=0 type=file mode=0644 content=$(location debian/copyright)",
        "usr/share/doc/p4lang-p4c/LICENSE uid=0 gid=0 type=file mode=0644 content=$(location LICENSE)",
        "usr/share/doc/p4lang-p4c/changelog.Debian.gz uid=0 gid=0 type=file mode=0644 content=$(location :debian_changelog)",
    ]

[
    sonic_deploy_tar(
        name = "p4lang-p4c.runtime_" + cpu,
        binaries = {"usr/bin/p4c-bm2-ss uid=0 gid=0 type=file mode=0755": ":p4c-bm2-ss", "usr/bin/p4c-bm2-psa uid=0 gid=0 type=file mode=0755": ":p4c-bm2-psa", "usr/bin/p4c-ebpf uid=0 gid=0 type=file mode=0755": ":p4c-ebpf", "usr/bin/p4c-ubpf uid=0 gid=0 type=file mode=0755": ":p4c-ubpf", "usr/bin/p4c-dpdk uid=0 gid=0 type=file mode=0755": ":p4c-dpdk", "usr/bin/p4c-graphs uid=0 gid=0 type=file mode=0755": ":p4c-graphs", "usr/bin/p4c-pna-p4tc uid=0 gid=0 type=file mode=0755": ":p4c-pna-p4tc", "usr/bin/p4test uid=0 gid=0 type=file mode=0755": ":p4test"} | ({"usr/bin/p4testgen uid=0 gid=0 type=file mode=0755": ":p4testgen"} if cpu == "x86_64" else {}),
        srcs = _RUNTIME_FILES,
        mtree = _RUNTIME_MTREE,
        force_debug_build = True,
        target_compatible_with = ["@platforms//cpu:" + cpu],
    )
    for cpu in ["x86_64", "aarch64"]
]

alias(
    name = "p4lang-p4c.runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":p4lang-p4c.runtime_x86_64",
        "@platforms//cpu:aarch64": ":p4lang-p4c.runtime_aarch64",
    }),
)
alias(
    name = "p4lang-p4c.runtime.debug_symbols",
    actual = select({
        "@platforms//cpu:x86_64": ":p4lang-p4c.runtime_x86_64.debug_symbols",
        "@platforms//cpu:aarch64": ":p4lang-p4c.runtime_aarch64.debug_symbols",
    }),
)

alias(name = "p4c_pkg", actual = ":p4lang-p4c.runtime")
alias(name = "p4c_pkg.debug_symbols", actual = ":p4lang-p4c.runtime.debug_symbols")

filegroup(
    name = "gcc_runtime",
    srcs = select({
        "@platforms//cpu:x86_64": ["@gcc-14.2.0-linux-target-x86_64-host-x86_64//:multicall_support_files"],
        "@platforms//cpu:aarch64": ["@gcc-14.2.0-linux-target-aarch64-host-aarch64//:multicall_support_files"],
    }),
)
filegroup(
    name = "cpp",
    srcs = select({
        "@platforms//cpu:x86_64": [bin("x86_64", "14.2.0", "gcc")],
        "@platforms//cpu:aarch64": [bin("aarch64", "14.2.0", "gcc")],
    }),
)
filegroup(name = "p4include", srcs = glob(["p4include/**"]))

p4c_tool(
    name = "p4c_bm2_ss",
    binary = ":p4c-bm2-ss",
    cpp = ":cpp",
    data = [":p4include"],
    runtime = [":gcc_runtime"],
    deps = _SYSTEM_DEPS,
)

alias(name = "p4c_bmv2", actual = ":p4c_bm2_ss")

p4c_tool(
    name = "p4c_graphs",
    binary = ":p4c-graphs",
    cpp = ":cpp",
    data = [":p4include"],
    runtime = [":gcc_runtime"],
    deps = _SYSTEM_DEPS,
)

filegroup(
    name = "configuration",
    srcs = ["config.h", "backends/bmv2/simple_switch/version.h", "ir/ir-generated.h", "ir/gen-tree-macro.h"],
)


# Validate the installed artifact contract without executing target programs.
py_test(
    name = "package_test",
    python_version = "3.11",
    srcs = ["bazel/package_test.py"],
    main = "bazel/package_test.py",
    args = [
        "--runtime", "$(rootpath :p4lang-p4c.runtime)",
        "--debug", "$(rootpath :p4lang-p4c.runtime.debug_symbols)",
        "--metadata", "$(rootpath @p4c//:p4lang-p4c.runtime_metadata)",
        "--readelf", "$(rootpath @sonic_build_infra//toolchains/binutils:readelf)",
        "--objcopy", "$(rootpath @sonic_build_infra//toolchains/binutils:objcopy)",
        "--control", "$(rootpath debian/control)",
        "--changelog", "$(rootpath debian/changelog)",
        "--arch",
    ] + select({
        "@platforms//cpu:x86_64": ["amd64"],
        "@platforms//cpu:aarch64": ["arm64"],
    }),
    data = [
        "debian/control", "debian/changelog",
        ":p4lang-p4c.runtime",
        ":p4lang-p4c.runtime.debug_symbols",
        "@p4c//:p4lang-p4c.runtime_metadata",
        "@sonic_build_infra//toolchains/binutils:readelf",
        "@sonic_build_infra//toolchains/binutils:objcopy",
    ],
    timeout = "long",
)
