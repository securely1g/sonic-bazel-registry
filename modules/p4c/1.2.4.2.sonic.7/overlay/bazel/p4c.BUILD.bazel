genrule(
    name = "ir_parser",
    srcs = ["tools/ir-generator/ir-generator.ypp"],
    outs = ["tools/ir-generator/ir-generator.cpp", "tools/ir-generator/ir-generator.hpp"],
    tools = ["@sonic_build_infra//tools/build_tools:bison", "@sonic_build_infra//tools/build_tools:m4"],
    cmd = 'M4="$(location @sonic_build_infra//tools/build_tools:m4)" ' + "$(location @sonic_build_infra//tools/build_tools:bison) --defines=$(RULEDIR)/tools/ir-generator/ir-generator.hpp --output=$(RULEDIR)/tools/ir-generator/ir-generator.cpp $(location tools/ir-generator/ir-generator.ypp)",
