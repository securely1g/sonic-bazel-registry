# The IR definition set follows SONiC's enabled target backends, including
# P4Tools only for AMD64. The execution-platform generator remains native.
genrule(
    name = "ir_generated",
    srcs = [
        "ir/base.def",
        "ir/type.def",
        "ir/expression.def",
        "ir/ir.def",
        "ir/v1.def",
        "frontends/p4-14/ir-v1.def",
        "backends/bmv2/bmv2.def",
        "backends/dpdk/dpdk.def",
        "backends/tc/tc.def",
    ] + select({
        "@platforms//cpu:x86_64": ["backends/p4tools/p4tools.def"],
        "@platforms//cpu:aarch64": [],
    }),
    outs = ["ir/ir-generated.cpp", "ir/ir-generated.h", "ir/gen-tree-macro.h"],
    tools = [":irgenerator_tool", "@sonic_build_infra//tools/build_tools:gawk"],
    cmd = "$(location :irgenerator_tool) -i $(RULEDIR)/ir/ir-generated.cpp.raw -o $(RULEDIR)/ir/ir-generated.h.raw -t $(RULEDIR)/ir/gen-tree-macro.h.raw " +
          "$(location ir/base.def) $(location ir/type.def) $(location ir/expression.def) $(location ir/ir.def) $(location ir/v1.def) " +
          "$(location frontends/p4-14/ir-v1.def) $(location backends/bmv2/bmv2.def) $(location backends/dpdk/dpdk.def) $(location backends/tc/tc.def)" + select({
              "@platforms//cpu:x86_64": " $(location backends/p4tools/p4tools.def)",
              "@platforms//cpu:aarch64": "",
          }) + """
for name in ir-generated.cpp ir-generated.h gen-tree-macro.h; do
    $(location @sonic_build_infra//tools/build_tools:gawk) -v name="$(RULEDIR)/ir/$$name" '/^#$$/ { printf "#line %d \\"%s\\"\\n", NR+1, name; next } { print }' "$(RULEDIR)/ir/$$name.raw" > "$(RULEDIR)/ir/$$name"
done
""",
)

