load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")

package(default_visibility = ["//visibility:public"])

[
    alias(name = name, actual = "@p4c_source//:" + name)
    for name in [
        "p4lang-p4c.runtime",
        "p4lang-p4c.runtime.debug_symbols",
        "p4c_bm2_ss",
        "configuration",
    ]
]

# Keep published interfaces for existing module consumers.
alias(name = "p4c_pkg", actual = ":p4lang-p4c.runtime")
alias(name = "p4c_pkg.debug_symbols", actual = ":p4lang-p4c.runtime.debug_symbols")
alias(name = "runtime_packages.json", actual = ":p4lang-p4c.runtime_metadata")

test_suite(name = "package_test", tests = ["@p4c_source//:package_test"])
runtime_packages(
    name = "p4lang-p4c.runtime_metadata",
    module_name = "p4c",
    apt_packages = {
        "@p4c_deps//" + package + ":data": "@p4c_deps//" + package + ":control"
        for package in [
            "libboost-iostreams1.83.0",
            "libboost-regex1.83.0",
            "libboost-serialization1.83.0",
            "libgc1",
            "libgmp10",
            "libgmpxx4ldbl",
            "libfl2",
            "liblzma5",
            "libbz2-1.0",
            "libzstd1",
            "zlib1g",
        ]
    },
    changelog = "@p4c_source//:debian/changelog",
    control = "@p4c_source//:debian/control",
    packages = {"p4lang-p4c": ":p4lang-p4c.runtime"},
    required_paths = {"p4lang-p4c": [
        "usr/bin/p4c",
        "usr/bin/p4c-bm2-ss",
        "usr/bin/p4c-bm2-psa",
        "usr/bin/p4c-ebpf",
        "usr/bin/p4c-ubpf",
        "usr/bin/p4c-dpdk",
        "usr/bin/p4c-graphs",
        "usr/bin/p4c-pna-p4tc",
        "usr/bin/p4test",
        "usr/share/p4c/p4include/core.p4",
        "usr/share/p4c/p4c_src/main.py",
    ]},
)

exports_files(["runtime_packages.md"])
