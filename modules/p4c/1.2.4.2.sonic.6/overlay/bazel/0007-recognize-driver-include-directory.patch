+// The driver supplies one include directory, also passed verbatim to cpp's -I.
+// Preserve that spelling so cpp's source filenames and ToP4's system-header
+// prefix agree when a declared loader relocates the compiler execution.
+void useDriverIncludePath(const char *&includePathOut, const char *variable) {
+    if (const char *path = getenv(variable)) {
+        struct stat st;
+        if (stat(path, &st) >= 0 && S_ISDIR(st.st_mode)) includePathOut = strdup(path);
+    }
+}
+
 }  // namespace
 
