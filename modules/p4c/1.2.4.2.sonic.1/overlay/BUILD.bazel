package(default_visibility = ["//visibility:public"])

[
    alias(
        name = name,
        actual = "@p4c_source//:" + name,
    )
    for name in [
        "p4c_pkg",
        "p4c_pkg.debug_symbols",
        "p4c_bm2_ss",
        "configuration",
    ]
]

# Command-line test aliases are not executed by Bazel; expose a real suite.
test_suite(
    name = "package_test",
    tests = ["@p4c_source//:package_test"],
)
