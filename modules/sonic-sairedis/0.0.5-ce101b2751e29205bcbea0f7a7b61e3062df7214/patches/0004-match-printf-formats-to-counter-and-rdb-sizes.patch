From a1a588ffa56438ebbffbdac291469b9632457422 Mon Sep 17 00:00:00 2001
From: Guohan Lu <securely1g@gmail.com>
Date: Tue, 10 Nov 2026 06:39:06 +0000
Subject: [PATCH] Use the declared integer types in counter and dump log
 messages

Log the three vector sizes in FlexCounter with %zu so the logger reads size_t. Remove the space flag from its hexadecimal ENI identifier. In saidump use PRIu64 for the configured JSON size limit, which is stored as uint64_t.

GCC checks these calls when compiling the Syncd library and saidump with -Wformat=2 -Werror.

Signed-off-by: Guohan Lu <securely1g@gmail.com>
---
 saidump/SaiDump.cpp   | 2 +-
 syncd/FlexCounter.cpp | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/saidump/SaiDump.cpp b/saidump/SaiDump.cpp
index 1f0a16366..e144bd8af 100644
--- a/saidump/SaiDump.cpp
+++ b/saidump/SaiDump.cpp
@@ -106,7 +106,7 @@ void SaiDump::handleCmdLine(int argc, char **argv)
                 }
 
                 rdbJSonSizeLimit = result * 1024 * 1024;
-                SWSS_LOG_NOTICE("Configure the RDB JSON MAX size to %llu MB", rdbJSonSizeLimit / 1024 / 1024);
+                SWSS_LOG_NOTICE("Configure the RDB JSON MAX size to %" PRIu64 " MB", rdbJSonSizeLimit / 1024 / 1024);
                 break;
 
             case 'h':
diff --git a/syncd/FlexCounter.cpp b/syncd/FlexCounter.cpp
index 36841a6b7..98ad2e71f 100644
--- a/syncd/FlexCounter.cpp
+++ b/syncd/FlexCounter.cpp
@@ -1026,7 +1026,7 @@ public:
         for (auto &it : m_bulkContexts)
         {
             auto &context = *it.second.get();
-            SWSS_LOG_INFO("%s %s partition %s number of OIDs %d number of counter IDs %d number of counters %d",
+            SWSS_LOG_INFO("%s %s partition %s number of OIDs %zu number of counter IDs %zu number of counters %zu",
                           m_name.c_str(),
                           m_instanceId.c_str(),
                           context.name.c_str(),
@@ -3476,7 +3476,7 @@ private:
 
         if (SAI_STATUS_SUCCESS != status)
         {
-            SWSS_LOG_WARN("Failed to get meter bulk stats for %s: ENI 0x% " PRIx64 ": %u", m_name.c_str(), ctx.eni_vid, status);
+            SWSS_LOG_WARN("Failed to get meter bulk stats for %s: ENI 0x%" PRIx64 ": %u", m_name.c_str(), ctx.eni_vid, status);
             return false;
         }
 
