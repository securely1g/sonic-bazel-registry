diff --git a/tests/consumer/MODULE.bazel b/tests/consumer/MODULE.bazel
new file mode 100644
index 0000000000000000000000000000000000000000..bb02cadda49310438ca70bc865f8fe007315201c
--- /dev/null
+++ b/tests/consumer/MODULE.bazel
@@ -0,0 +1,111 @@
+module(name = "gnmi_external_consumer")
+
+bazel_dep(name = "sonic-gnmi", version = "0.1.1-f611d2cbd20930c0d8c8c666706d39eda524e558", repo_name = "sonic_gnmi")
+bazel_dep(name = "sonic-mgmt-common", version = "1.0.2-68bfd75e9034ac0981c0f431b54cf8a9a868a2ca", repo_name = "sonic_mgmt_common")
+bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")
+bazel_dep(name = "sonic-build-infra", version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de", repo_name = "sonic_build_infra")
+bazel_dep(name = "gazelle", version = "0.54.0.sonic.2")
+bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.2-20200309174518-a00bece872fc", repo_name = "com_github_openconfig_goyang")
+bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.2", repo_name = "com_github_openconfig_ygot")
+bazel_dep(name = "rules_go", version = "0.65.0.sonic.2", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "rules_cc", version = "0.2.22")
+bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
+bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
+bazel_dep(name = "rules_rs", version = "0.1.0")
+bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2")
+
+go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
+go_sdk.download(version = "1.26.7")
+
+python = use_extension("@rules_python//python/extensions:python.bzl", "python")
+python.toolchain(
+    is_default = True,
+    python_version = "3.13",
+)
+
+rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
+use_repo(rules_rust, "rules_rust")
+
+rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
+rust.toolchain(
+    edition = "2021",
+    versions = ["1.90.0"],
+)
+use_repo(rust, "rust_toolchains")
+
+register_toolchains("@rust_toolchains//:all")
+
+go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
+go_deps.from_file(go_work = "@sonic_gnmi//:go.bazel.work")
+use_repo(go_deps, "cc_mvdan_sh_v3", "com_github_agiledragon_gomonkey_v2", "com_github_alicebob_miniredis_v2", "com_github_azure_sonic_mgmt_common", "com_github_c9s_goprocinfo", "com_github_dgrijalva_jwt_go", "com_github_fsnotify_fsnotify", "com_github_go_redis_redismock_v9", "com_github_godbus_dbus_v5", "com_github_gogo_protobuf", "com_github_golang_glog", "com_github_golang_mock", "com_github_golang_protobuf", "com_github_google_gnxi", "com_github_google_go_cmp", "com_github_google_shlex", "com_github_kylelemons_godebug", "com_github_maruel_natural", "com_github_msteinert_pam", "com_github_openconfig_gnmi", "com_github_openconfig_gnoi", "com_github_openconfig_gnsi", "com_github_opencontainers_go_digest", "com_github_opencontainers_image_spec", "com_github_pkg_sftp", "com_github_redis_go_redis_v9", "com_github_stretchr_testify", "com_github_workiva_go_datastructures", "in_gopkg_yaml_v2", "in_gopkg_yaml_v3", "land_oras_oras_go_v2", "org_golang_google_grpc", "org_golang_google_grpc_security_advancedtls", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_mod", "org_golang_x_net", "org_golang_x_sync", "org_golang_x_term", "org_golang_x_text", "org_golang_x_time", "org_golang_x_tools")
+
+go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
+
+# The consuming root selects the owner's existing SONiC Go patches. Public
+# libraries and their consumers share one Go graph and the same Go types.
+go_patches.gazelle_override(
+    directives = ["gazelle:proto disable_global"],
+    path = "github.com/openconfig/gnmi",
+)
+
+# These modules ship C++/proto Bazel files for their own workspace. Generate
+# their checked-in Go bindings as native Go packages for this consuming graph.
+[go_patches.gazelle_override(
+    build_file_generation = "clean",
+    directives = ["gazelle:proto disable_global"],
+    path = path,
+) for path in [
+    "github.com/openconfig/gnoi",
+    "github.com/openconfig/gnsi",
+]]
+
+# These are the existing Make/vendor patches, applied to isolated dependency
+# repositories. Build actions never modify go.mod, vendor, or the checkout.
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:jsonquery.patch"],
+    path = "github.com/antchfx/jsonquery",
+)
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:xmlquery.patch"],
+    path = "github.com/antchfx/xmlquery",
+)
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:xpath.patch"],
+    path = "github.com/antchfx/xpath",
+)
+
+[go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_gnmi//patches/bazel:" + patch] + (["@sonic_gnmi//patches/bazel:" + {
+        "0001-gnxi.patch": "0005-gnxi-build.patch",
+        "0002-gnmi.patch": "0006-gnmi-build.patch",
+    }[patch]] if path in [
+        "github.com/google/gnxi",
+        "github.com/openconfig/gnmi",
+    ] else []),
+    path = path,
+) for path, patch in [
+    ("github.com/google/gnxi", "0001-gnxi.patch"),
+    ("github.com/openconfig/gnmi", "0002-gnmi.patch"),
+    ("github.com/fsnotify/fsnotify", "0003-fsnotify.patch"),
+    ("google.golang.org/grpc/security/advancedtls", "0004-advancedtls.patch"),
+]]
+# Native gNMI deliberately omits Common's glog.patch for glog v1.2.4.
+
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_gnmi//patches/bazel:0007-gnoi-build.patch"],
+    path = "github.com/openconfig/gnoi",
+)
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_gnmi//patches/bazel:0008-pam-build.patch"],
+    path = "github.com/msteinert/pam",
+)
+
+# Select the production lock when gNMI is built as an external module.
+apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
+apt.import_lock(lock = "@sonic_build_infra//apt:apt.lock.json")
