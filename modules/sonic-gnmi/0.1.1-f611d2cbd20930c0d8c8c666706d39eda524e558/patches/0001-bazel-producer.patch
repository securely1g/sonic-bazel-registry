diff --git a/tools/bazel/check_debug.py b/tools/bazel/check_debug.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c5a97dc5a1f347feb267194caeae030ec51e86d
--- /dev/null
+++ b/tools/bazel/check_debug.py
@@ -0,0 +1,69 @@
+"""Prove each installed ELF finds source lines only with its matching debug TAR."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tarfile
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--evidence', type=Path, default=Path('bazel-evidence'))
+    parser.add_argument('--gdb', default='gdb')
+    args = parser.parse_args()
+    evidence = args.evidence.resolve()
+    runtime = evidence / 'runtime.tar'
+    debug = evidence / 'runtime.debug_symbols.tar'
+    gdb = shutil.which(args.gdb)
+    if not gdb:
+        raise FileNotFoundError('Declared validation environment must provide GDB')
+    records = {}
+    with tempfile.TemporaryDirectory(prefix='gnmi-debug-') as directory:
+        root = Path(directory)
+        runtime_root, debug_root = root / 'runtime', root / 'symbols'
+        for archive, destination in [(runtime, runtime_root), (debug, debug_root)]:
+            with tarfile.open(archive) as tar:
+                tar.extractall(destination, filter='data')
+        empty = root / 'without-symbols'
+        empty.mkdir()
+        environment = dict(os.environ, DEBUGINFOD_URLS='', HOME=str(root))
+        binaries = sorted((runtime_root / 'usr/sbin').iterdir())
+        expected = {'telemetry', 'dialout_client_cli', 'gnmi_get', 'gnmi_set', 'gnmi_cli',
+                    'gnmi_dump', 'gnoi_client', 'gnoi_openconfig_client', 'gnoi_sonic_client'}
+        if {p.name for p in binaries} != expected:
+            raise AssertionError('Debug proof requires all nine production executables')
+        for binary in binaries:
+            outputs = {}
+            for case, symbols in [('matching', debug_root / 'usr/lib/debug'), ('missing', empty)]:
+                result = subprocess.run([
+                    gdb, '--batch', '--nx', '--quiet',
+                    '-ex', 'set debuginfod enabled off',
+                    '-ex', 'set auto-load off',
+                    '-ex', 'set debug-file-directory ' + str(symbols),
+                    '-ex', 'file ' + str(binary),
+                    '-ex', 'info line main.main',
+                ], cwd=root, env=environment, stdin=subprocess.DEVNULL,
+                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=30)
+                outputs[case] = result.stdout
+                (evidence / (binary.name + '-gdb-' + case + '.log')).write_text(result.stdout)
+            lines = re.findall(r'Line ([0-9]+) of "([^"]+\.go)"', outputs['matching'])
+            if not lines or re.search(r'Line [0-9]+ of ', outputs['missing']):
+                raise AssertionError('Detached debug positive/negative lookup failed for ' + binary.name)
+            records[binary.name] = {'main_source_line': lines[0], 'missing_debug_rejected': True}
+    receipt = {
+        'binaries': records,
+        'runtime_sha256': hashlib.sha256(runtime.read_bytes()).hexdigest(),
+        'debug_sha256': hashlib.sha256(debug.read_bytes()).hexdigest(),
+        'gdb': subprocess.check_output([gdb, '--version'], text=True).splitlines()[0],
+    }
+    (evidence / 'debug-lookup.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    print(json.dumps(receipt, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/bazel/check_generator_incremental.py b/tools/bazel/check_generator_incremental.py
new file mode 100644
index 0000000000000000000000000000000000000000..95466926e70f3c2ac429d8852d8271e296d1a8d9
--- /dev/null
+++ b/tools/bazel/check_generator_incremental.py
@@ -0,0 +1,126 @@
+"""Prove client-template invalidation without changing unrelated gNMI outputs.
+
+BAZEL_COMMAND and BAZEL_BUILD_FLAGS have the same meaning as in
+check_incremental.py. Equal no-op hashes establish byte stability, not a
+claim that an action ran or that the build was served from a cache.
+"""
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import time
+
+# Load this declared sibling even when PYTHONSAFEPATH omits the script directory.
+_spec = importlib.util.spec_from_file_location(
+    "check_incremental", Path(__file__).with_name("check_incremental.py"))
+_incremental = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_incremental)
+output_file, require, sha = _incremental.output_file, _incremental.require, _incremental.sha
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = "tools/pyang_plugins/templates/client/main.j2"
+ORIGINAL_TEXT = b"Address:port of gNOI Server"
+EDITED_TEXT = b"Address:port of gNOI Server (generator incremental probe)"
+GENERATED_TARGET = "//gnoi_yang:generated"
+GENERATED = {
+    "client/gnoi_openconfig_client/main.go",
+    "client/gnoi_sonic_client/main.go",
+    "proto/sonic_show_techsupport/sonic_show_techsupport.proto",
+    "server/gnoiyang.go",
+    "server/openconfig_register.go",
+    "server/sonic_register.go",
+    "server/sonic_show_techsupport/sonic_show_techsupport.go",
+}
+TARGETS = (
+    "//dist:runtime",
+    "//dist:runtime.debug_symbols",
+    "//gnoi_yang:gnoi_openconfig_client",
+    "//gnoi_yang:gnoi_sonic_client",
+    "//cmd/telemetry",
+    "//gnoi_client",
+    "@sonic_swss_common//dist:libswsscommon_pkg",
+    "//gnoi_yang:generated_proto_source",
+    "//proto:generated_proto_source",
+    "//proto/gnoi:generated_proto_source",
+    "//proto/gnoi/oras:generated_proto_source",
+)
+CHANGED = set(TARGETS[:4]) | {
+    "generated/client/gnoi_openconfig_client/main.go",
+    "generated/client/gnoi_sonic_client/main.go",
+}
+
+
+def snapshot(stage, output, bazel, flags):
+    started = time.monotonic()
+    with (output / (stage + ".log")).open("w") as log:
+        subprocess.run([*bazel, "build", *flags, *TARGETS, GENERATED_TARGET],
+                       cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, check=True)
+    seconds = time.monotonic() - started
+    with (output / (stage + ".queries.log")).open("w") as log:
+        hashes = {target: sha(output_file(target, bazel, flags, log)) for target in TARGETS}
+        paths = subprocess.check_output(
+            [*bazel, "cquery", *flags, "--output=files", "config(" + GENERATED_TARGET + ", target)"],
+            cwd=ROOT, stderr=log, text=True).splitlines()
+        generated = {}
+        for value in paths:
+            marker = "/gnoi_yang/generated/"
+            require(value.count(marker) == 1, "Unexpected generated source location")
+            name = value.split(marker, 1)[1]
+            require(name not in generated, "Duplicate generated source: " + name)
+            generated[name] = sha(ROOT / value)
+        require(set(generated) == GENERATED, "Generated source inventory changed")
+        hashes.update({"generated/" + name: digest for name, digest in generated.items()})
+    return {"seconds": seconds, "sha256": hashes}
+
+
+def run(output, bazel, flags):
+    output.mkdir(parents=True, exist_ok=True)
+    result = {"status": "running", "input": SOURCE, "expected_changed_outputs": sorted(CHANGED)}
+    source = ROOT / SOURCE
+    original = source.read_bytes()
+    try:
+        require(original.count(ORIGINAL_TEXT) == 1 and EDITED_TEXT not in original,
+                "Client template must contain exactly one unmodified target help string")
+        result["source_sha256"] = hashlib.sha256(original).hexdigest()
+        result["baseline"] = snapshot("generator-baseline", output, bazel, flags)
+        result["noop"] = snapshot("generator-noop", output, bazel, flags)
+        baseline = result["baseline"]["sha256"]
+        require(result["noop"]["sha256"] == baseline, "No-op build changed generator or public outputs")
+        try:
+            source.write_bytes(original.replace(ORIGINAL_TEXT, EDITED_TEXT))
+            result["edit"] = snapshot("generator-edit", output, bazel, flags)
+            changed = {key for key, digest in result["edit"]["sha256"].items() if baseline[key] != digest}
+            require(changed == CHANGED, "Unexpected template invalidation: " + repr(sorted(changed)))
+        finally:
+            source.write_bytes(original)
+        result["restore"] = snapshot("generator-restore", output, bazel, flags)
+        require(result["restore"]["sha256"] == baseline, "Restored template did not reproduce outputs")
+        require(source.read_bytes() == original, "Template restoration failed")
+        result["status"] = "passed"
+    finally:
+        if source.read_bytes() != original:
+            source.write_bytes(original)
+        if result["status"] != "passed":
+            result["status"] = "failed"
+        (output / "generator-incremental.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=Path("bazel-evidence"))
+    args = parser.parse_args()
+    bazel = shlex.split(os.environ.get("BAZEL_COMMAND", "bazel"))
+    require(bool(bazel), "BAZEL_COMMAND is empty")
+    flags = ["--jobs=2", *shlex.split(os.environ.get("BAZEL_BUILD_FLAGS", ""))]
+    print(json.dumps(run(args.output.resolve(), bazel, flags), indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/bazel/check_incremental.py b/tools/bazel/check_incremental.py
new file mode 100644
index 0000000000000000000000000000000000000000..d756ec73fe0bf022cafef471c82988e2b17351dd
--- /dev/null
+++ b/tools/bazel/check_incremental.py
@@ -0,0 +1,135 @@
+"""Check public gNMI TAR stability and one telemetry source edit/restoration.
+
+Equal no-op hashes prove output stability, not an executed-action cache hit.
+BAZEL_COMMAND may supply startup options; BAZEL_BUILD_FLAGS selects the same
+platform, repository overrides and dialout setting used by the producer build.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+import time
+
+
+ROOT = Path(__file__).resolve().parents[2]
+TARGETS = (
+    "//dist:runtime",
+    "//dist:runtime.debug_symbols",
+    "//cmd/telemetry",
+    "//gnoi_client",
+    "@sonic_swss_common//dist:libswsscommon_pkg",
+)
+CHANGED = {"//dist:runtime", "//dist:runtime.debug_symbols", "//cmd/telemetry"}
+SOURCE = "cmd/telemetry/main.go"
+ORIGINAL_TEXT = b"invalid shared-memory configuration: %w"
+EDITED_TEXT = b"invalid shared-memory configuration (incremental probe): %w"
+
+
+def sha(path):
+    with path.open("rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def output_file(target, bazel, flags, log):
+    # cquery retains configured instances from previous builds. The TAR's
+    # debug transition and source-test transition may both leave another
+    # instance of this Go target in that graph. Select this invocation's
+    # ordinary target configuration without discarding the cached state.
+    files = subprocess.check_output(
+        [*bazel, "cquery", *flags, "--output=files", "config(" + target + ", target)"], cwd=ROOT,
+        stderr=log, text=True).splitlines()
+    require(len(files) == 1, "Expected one public output for " + target + ": " + repr(files))
+    path = ROOT / files[0]
+    require(path.is_file() and path.stat().st_size, "Missing output for " + target)
+    return path
+
+
+def snapshot(name, output, bazel, flags):
+    started = time.monotonic()
+    with (output / (name + ".log")).open("w") as log:
+        subprocess.run([*bazel, "build", *flags, *TARGETS], cwd=ROOT,
+                       stdout=log, stderr=subprocess.STDOUT, check=True)
+    seconds = time.monotonic() - started
+    hashes = {}
+    with (output / (name + ".queries.log")).open("w") as log:
+        for target in TARGETS:
+            hashes[target] = sha(output_file(target, bazel, flags, log))
+    return {"seconds": seconds, "sha256": hashes}
+
+
+def retain_restored(output, bazel, flags, baseline):
+    """Publish only this invocation's restored TARs, never a later bazel-bin link."""
+    records = {}
+    with tempfile.TemporaryDirectory(prefix=".restored-", dir=output) as temporary, \
+            (output / "retain.queries.log").open("w") as log:
+        for name, target in (("runtime.tar", "//dist:runtime"),
+                             ("runtime.debug_symbols.tar", "//dist:runtime.debug_symbols")):
+            staged = Path(temporary) / name
+            shutil.copyfile(output_file(target, bazel, flags, log), staged)
+            staged.chmod(0o644)
+            digest = sha(staged)
+            require(digest == baseline[target], "Retained TAR differs from restored baseline: " + name)
+            records[name] = {"target": target, "sha256": digest, "bytes": staged.stat().st_size}
+            os.replace(staged, output / name)
+    return records
+
+
+def run(output, bazel, flags):
+    output.mkdir(parents=True, exist_ok=True)
+    result = {"status": "running", "input": SOURCE, "expected_changed_targets": sorted(CHANGED)}
+    source = ROOT / SOURCE
+    original = source.read_bytes()
+    require(original.count(ORIGINAL_TEXT) == 1 and EDITED_TEXT not in original,
+            "Telemetry source probe must match exactly one unmodified error message")
+    result["source_sha256"] = hashlib.sha256(original).hexdigest()
+    try:
+        result["baseline"] = snapshot("baseline", output, bazel, flags)
+        result["noop"] = snapshot("noop", output, bazel, flags)
+        baseline = result["baseline"]["sha256"]
+        require(result["noop"]["sha256"] == baseline, "No-op build changed public outputs")
+        try:
+            source.write_bytes(original.replace(ORIGINAL_TEXT, EDITED_TEXT))
+            result["edit"] = snapshot("telemetry-edit", output, bazel, flags)
+            changed = {target for target in TARGETS if result["edit"]["sha256"][target] != baseline[target]}
+            require(changed == CHANGED, "Unexpected telemetry invalidation: " + repr(sorted(changed)))
+        finally:
+            source.write_bytes(original)
+        result["restore"] = snapshot("telemetry-restore", output, bazel, flags)
+        require(result["restore"]["sha256"] == baseline, "Restored source did not reproduce public outputs")
+        require(source.read_bytes() == original, "Telemetry source restoration failed")
+        result["artifacts"] = retain_restored(output, bazel, flags, baseline)
+        result["status"] = "passed"
+    finally:
+        # Keep the checkout intact even when a build, query or hash check fails.
+        if source.read_bytes() != original:
+            source.write_bytes(original)
+        if result["status"] != "passed":
+            result["status"] = "failed"
+        (output / "incremental.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=Path("bazel-evidence"))
+    args = parser.parse_args()
+    bazel = shlex.split(os.environ.get("BAZEL_COMMAND", "bazel"))
+    require(bool(bazel), "BAZEL_COMMAND is empty")
+    flags = ["--jobs=2", *shlex.split(os.environ.get("BAZEL_BUILD_FLAGS", ""))]
+    result = run(args.output.resolve(), bazel, flags)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/bazel/collect_evidence.py b/tools/bazel/collect_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..651ca1bd7df867f7ff400bc15952d829970f2970
--- /dev/null
+++ b/tools/bazel/collect_evidence.py
@@ -0,0 +1,95 @@
+"""Retain native source, test and installed-payload evidence without environment dumps."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import subprocess
+
+
+def retain_tests(destination):
+    destination.mkdir(parents=True, exist_ok=True)
+    for source in Path('bazel-testlogs').rglob('test.*'):
+        if source.name not in ('test.log', 'test.xml') or not source.is_file():
+            continue
+        target = destination / source.relative_to('bazel-testlogs')
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, target)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--save-testlogs', type=Path)
+    args = parser.parse_args()
+    if args.save_testlogs:
+        retain_tests(args.save_testlogs)
+        return
+    evidence = Path('bazel-evidence')
+    evidence.mkdir(exist_ok=True)
+    for name in ['MODULE.bazel.lock', 'go.mod', 'go.sum', 'go.bazel.work', 'go.bazel.work.sum', 'requirements_lock.txt']:
+        source = Path(name)
+        if source.is_file():
+            shutil.copyfile(source, evidence / source.name)
+    # Save the source test reports before later profiles reuse bazel-testlogs.
+    # On failure, retain whatever the interrupted source invocation produced.
+    if not (evidence / 'tests').exists():
+        retain_tests(evidence / 'tests')
+    results = {name: os.environ.get('CI_' + name.upper() + '_RESULT', 'unknown')
+               for name in ['source_test', 'installed', 'debug', 'generator', 'incremental', 'consumer', 'dialout_disabled']}
+    complete = all(value == 'success' for value in results.values())
+    if results['source_test'] == 'success':
+        required = ['sonic_db_config', 'sonic_service_client', 'sonic_data_client',
+                    'gnmi_server', 'telemetry', 'dialout/dialout_client']
+        for package in required:
+            logs = list((evidence / 'tests' / package).glob('*/test.log'))
+            if not logs or not any('--- PASS:' in p.read_text(errors='replace') for p in logs):
+                raise AssertionError('Missing executed original Go cases for ' + package)
+    payloads = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                for p in evidence.glob('*.tar*') if p.is_file()}
+    if complete:
+        incremental = json.loads((evidence / 'incremental.json').read_text())
+        generator = json.loads((evidence / 'generator-incremental.json').read_text())
+        debug = json.loads((evidence / 'debug-lookup.json').read_text())
+        assert incremental['status'] == generator['status'] == 'passed'
+        package_log = (evidence / 'tests/dist/package_test/test.log').read_text()
+        packages = [json.loads(line) for line in package_log.splitlines()
+                    if line.startswith('{"debug_sha256":')]
+        assert len(packages) == 1 and packages[0]['matching_elf_pairs'] == 9
+        for filename, target, key in [
+            ('runtime.tar', '//dist:runtime', 'runtime_sha256'),
+            ('runtime.debug_symbols.tar', '//dist:runtime.debug_symbols', 'debug_sha256'),
+        ]:
+            digest = payloads[filename]
+            assert incremental['artifacts'][filename]['sha256'] == digest
+            assert all(incremental[stage]['sha256'][target] == digest
+                       for stage in ['baseline', 'noop', 'restore'])
+            assert all(generator[stage]['sha256'][target] == digest
+                       for stage in ['baseline', 'noop', 'restore'])
+            assert debug[key] == packages[0][key] == digest
+        assert len(debug['binaries']) == 9
+    def git(*arguments):
+        return subprocess.check_output(['git', '-c', 'safe.directory=' + str(Path.cwd()), *arguments], text=True).strip()
+    revision = git('rev-parse', 'HEAD')
+    headers = git('cat-file', '-p', 'HEAD').split('\n\n', 1)[0]
+    parents = [line.removeprefix('parent ') for line in headers.splitlines() if line.startswith('parent ')]
+    head, base = os.environ.get('CI_HEAD_SHA', ''), os.environ.get('CI_BASE_SHA', '')
+    if head:
+        assert head == revision or head in parents, 'Tested checkout does not include the PR head'
+    if base and head != revision:
+        assert base in parents, 'Tested merge does not include the intended base'
+    identity = {
+        'checkout': revision, 'commit_headers': headers, 'parents': parents,
+        'pull_request_head': head, 'pull_request_base': base,
+        'machine': platform.machine(), 'os_release': Path('/etc/os-release').read_text(),
+        'target': '@sonic_build_infra//platforms:x86_64_trixie',
+        'bazel': Path('.bazelversion').read_text().strip(), 'go_sdk': '1.26.7',
+        'consumer_compilation_mode': 'fastbuild', 'consumer_strip': 'always',
+        'complete': complete, 'results': results, 'payload_sha256': payloads,
+    }
+    (evidence / 'provenance.json').write_text(json.dumps(identity, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
