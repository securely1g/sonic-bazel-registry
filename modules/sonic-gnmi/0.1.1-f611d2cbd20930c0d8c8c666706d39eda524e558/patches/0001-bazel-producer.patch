new file mode 100644
index 0000000000000000000000000000000000000000..e0747cb04c7bf2747f82d948ba7281c39a7eba3f
--- /dev/null
+++ b/tools/bazel/generate_yang.py
@@ -0,0 +1,47 @@
+"""Run the existing gNMI pyang plugin against the Common-owned model tree."""
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--models', type=Path, required=True)
+    parser.add_argument('--pyang', type=Path, required=True)
+    parser.add_argument('--plugin', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--expected', action='append', required=True)
+    args = parser.parse_args()
+    models = args.models.absolute()
+    env = {key: value for key, value in os.environ.items()
+           if not key.startswith('RUNFILES_') and key not in ('JAVA_RUNFILES', 'PYTHONPATH')}
+    with tempfile.TemporaryDirectory(prefix='gnmi-yang-') as temp:
+        root = Path(temp)
+        common = [str(args.pyang.absolute()), '-f', 'proto',
+                  '--proto-outdir', str(root / 'proto'),
+                  '--plugindir', str(args.plugin.absolute().parent),
+                  '--server-rpc-outdir', str(root / 'server'),
+                  '--client-rpc-outdir', str(root / 'client')]
+        for paths, sources in (
+            ([models / 'common', models / 'extensions'],
+             sorted(models.glob('*.yang')) + sorted((models / 'extensions').glob('*.yang'))),
+            ([models / 'common', models / 'sonic/common'], sorted((models / 'sonic').glob('*.yang'))),
+        ):
+            if not sources:
+                raise ValueError('Missing owner model sources')
+            subprocess.run([*common, '-p', ':'.join(map(str, paths)), *map(str, sources)], check=True, env=env)
+        actual = sorted(p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file())
+        if actual != sorted(args.expected):
+            raise ValueError({'generated': actual, 'declared': sorted(args.expected)})
+        for name in actual:
+            output = args.output / name
+            output.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(root / name, output)
+            output.chmod(0o644)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/bazel/generators.bzl b/tools/bazel/generators.bzl
new file mode 100644
index 0000000000000000000000000000000000000000..820013e9cffe3b27facaa777fa3d4e0eaac6358a
--- /dev/null
+++ b/tools/bazel/generators.bzl
@@ -0,0 +1,39 @@
+"""Declared invocation of the owner's existing gNMI YANG plugin."""
+
+def _gnoi_yang_impl(ctx):
+    prefix = "/".join([part for part in [
+        ctx.bin_dir.path,
+        ctx.label.workspace_root,
+        ctx.label.package,
+        ctx.attr.output_dir,
+    ] if part])
+    args = ctx.actions.args()
+    args.add("--models", ctx.file.models.path)
+    args.add("--pyang", ctx.executable.pyang)
+    args.add("--plugin", ctx.file.plugin)
+    args.add("--output", prefix)
+    args.add_all([f.path.removeprefix(prefix + "/") for f in ctx.outputs.outs], before_each = "--expected")
+    ctx.actions.run(
+        executable = ctx.executable._driver,
+        arguments = [args],
+        inputs = [ctx.file.models, ctx.file.plugin] + ctx.files.templates,
+        tools = [ctx.attr._driver[DefaultInfo].files_to_run, ctx.attr.pyang[DefaultInfo].files_to_run],
+        outputs = ctx.outputs.outs,
+        env = {"PYTHONHASHSEED": "0", "PYTHONNOUSERSITE": "1"},
+        execution_requirements = {"block-network": "1"},
+        mnemonic = "GnmiYangProtobuf",
+    )
+    return [DefaultInfo(files = depset(ctx.outputs.outs))]
+
+gnoi_yang = rule(
+    implementation = _gnoi_yang_impl,
+    attrs = {
+        "models": attr.label(allow_single_file = True, mandatory = True),
+        "pyang": attr.label(executable = True, cfg = "exec", mandatory = True),
+        "plugin": attr.label(allow_single_file = True, mandatory = True),
+        "templates": attr.label_list(allow_files = [".j2"]),
+        "output_dir": attr.string(mandatory = True),
+        "outs": attr.output_list(mandatory = True),
+        "_driver": attr.label(default = "//tools/bazel:generate_yang", executable = True, cfg = "exec"),
+    },
+)
diff --git a/tools/bazel/installed_probe.py b/tools/bazel/installed_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..fb364555645efd802b83d8a75c2358bcf705e5a9
--- /dev/null
+++ b/tools/bazel/installed_probe.py
@@ -0,0 +1,66 @@
+"""Exercise installed telemetry and its client against private Redis."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import socket
+import subprocess
+import time
+
+
+def run(work, environment, native_environment):
+    binaries = work / 'build/bin'
+    # Inspect the installed executable's real flag defaults. An external root
+    # must preserve SONiC's selected write profile without inheriting our rc.
+    help_result = subprocess.run([str(binaries / 'telemetry'), '-help'], cwd=work,
+                                 env=native_environment, capture_output=True,
+                                 text=True, timeout=10, check=True)
+    help_text = help_result.stdout + help_result.stderr
+    for flag in ('gnmi_translib_write', 'gnmi_native_write'):
+        sections = re.findall(r'(?m)^  -' + flag + r'\b[^\n]*\n(?:(?!  -)[^\n]*\n?)*', help_text)
+        if len(sections) != 1 or '(default true)' not in sections[0]:
+            raise AssertionError('Installed telemetry does not enable ' + flag + ':\n' + help_text)
+    with socket.socket() as listener:
+        listener.bind(('127.0.0.1', 0))
+        port = listener.getsockname()[1]
+    address = f'127.0.0.1:{port}'
+    command = [str(binaries / 'telemetry'), '-noTLS', '-bind_address', '127.0.0.1',
+               '-port', str(port), '-client_auth', 'none', '-logtostderr']
+    with (work / 'telemetry.log').open('w+') as log:
+        service = subprocess.Popen(command, cwd=work, env=native_environment,
+                                   stdout=log, stderr=subprocess.STDOUT)
+        try:
+            get = [str(binaries / 'gnmi_get'), '-notls', '-target_addr', address,
+                   '-time_out', '2s', '-xpath', '/sonic-db:CONFIG_DB/localhost/DEVICE_METADATA/localhost/hostname']
+            deadline = time.monotonic() + 30
+            while service.poll() is None and time.monotonic() < deadline:
+                result = subprocess.run(get, cwd=work, env=native_environment, capture_output=True, text=True, timeout=5)
+                if result.returncode == 0:
+                    break
+                time.sleep(0.1)
+            else:
+                log.seek(0)
+                raise AssertionError('Installed telemetry did not answer a real Get:\n' + log.read())
+            # Require two actual database changes, not merely an open socket.
+            values = ['bazel-native-gnmi-one', 'bazel-native-gnmi-two']
+            for value in values:
+                subprocess.run(['redis-cli', '-n', '4', 'HSET', 'DEVICE_METADATA|localhost', 'hostname', value],
+                               cwd=work, env=environment, check=True, capture_output=True)
+                result = subprocess.run(get, cwd=work, env=native_environment, capture_output=True, text=True, timeout=5)
+                if result.returncode or value not in result.stdout + result.stderr:
+                    raise AssertionError('Get did not observe private Redis value: ' + result.stdout + result.stderr)
+            bad = get.copy()
+            bad[bad.index('-xpath') + 1] = '/sonic-db:INVALID_DB/localhost/invalid'
+            result = subprocess.run(bad, cwd=work, env=native_environment, capture_output=True, text=True, timeout=5)
+            if result.returncode == 0:
+                raise AssertionError('Invalid database unexpectedly succeeded')
+            print(json.dumps({'installed_binaries': sorted(p.name for p in binaries.iterdir()),
+                              'write_profile': ['gnmi_translib_write', 'gnmi_native_write'],
+                              'real_get_values': values, 'invalid_database_rejected': True,
+                              'telemetry_sha256': hashlib.sha256((Path(environment['SONIC_TEST_NATIVE_BIN']) / 'telemetry').read_bytes()).hexdigest()}, sort_keys=True))
+        finally:
+            service.terminate()
+            try:
+                service.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                service.kill(); service.wait()
