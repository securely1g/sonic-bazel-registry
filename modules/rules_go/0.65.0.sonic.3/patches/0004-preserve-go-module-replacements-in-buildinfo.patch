+		replacement = moduleReplacement{path: values.Get("go_replace"), version: values.Get("go_replace_version"), sum: values.Get("go_replace_sum")}
+		if replacement != (moduleReplacement{}) {
+			local := strings.HasPrefix(replacement.path, ".") || strings.HasPrefix(replacement.path, "/")
+			if moduleSum != "" || replacement.path == "" || replacement.version == "" ||
+				strings.ContainsAny(replacement.path+replacement.version+replacement.sum, "\t\r\n\x00") ||
+				(local && (replacement.version != "(devel)" || replacement.sum != "")) ||
+				(!local && (!strings.HasPrefix(replacement.version, "v") || !strings.HasPrefix(replacement.sum, "h1:"))) {
