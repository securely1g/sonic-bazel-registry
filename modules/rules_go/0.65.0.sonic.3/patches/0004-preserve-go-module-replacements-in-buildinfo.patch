@@ -384,3 +384,26 @@ func TestShouldEmitBuildInfo(t *testing.T) {
 		})
 	}
 }
+
+func TestGoModuleReplacements(t *testing.T) {
+	for _, replacement := range []moduleReplacement{
+		{path: "../local", version: "(devel)"},
+		{path: "example.com/fork", version: "v1.2.3", sum: "h1:sourcehash="},
+	} {
+		u := "pkg:golang/example.com/original@v1.2.0?go_replace=" + replacement.path + "&go_replace_version=" + replacement.version + "&go_replace_sum=" + replacement.sum
+		module, ok, err := moduleFromPURL(u)
+		if !ok || err != nil {
+			t.Fatalf("%s: %v", u, err)
+		}
+		deps := buildInfoDeps([]moduleInfo{module, module}, moduleInfo{})
+		if len(deps) != 1 || deps[0].Path != "example.com/original" || deps[0].Version != "v1.2.0" || deps[0].Sum != "" {
+			t.Fatalf("wrong original module: %+v", deps)
+		}
+		if r := deps[0].Replace; r == nil || r.Path != replacement.path || r.Version != replacement.version || r.Sum != replacement.sum {
+			t.Fatalf("wrong effective module: %+v", r)
+		}
+	}
+	if _, _, err := moduleFromPURL("pkg:golang/example.com/module@v1?go_replace=../local&go_replace_version=v1.0.0"); err == nil {
+		t.Fatal("accepted an inconsistent replacement for a local source")
+	}
+}
