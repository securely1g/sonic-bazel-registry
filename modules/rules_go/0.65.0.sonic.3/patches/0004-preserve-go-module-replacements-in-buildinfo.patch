-		return unique[i].sum < unique[j].sum
+		if unique[i].sum != unique[j].sum {
+			return unique[i].sum < unique[j].sum
+		}
+		a, b := unique[i].replacement, unique[j].replacement
+		if a.path != b.path {
+			return a.path < b.path
+		}
+		if a.version != b.version {
+			return a.version < b.version
+		}
+		return a.sum < b.sum
 	})
 
