load("//go/tools/bazel_testing:def.bzl", "go_bazel_test")

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

# The original #4583 fixture and test bodies are unchanged. Only the removed
# WorkspaceSuffix API is adapted to ModuleFileSuffix/use_repo_rule.
go_bazel_test(
    name = "cc_header_inputs_test",
    srcs = ["cc_header_inputs_test.go"],
    args = ["-test.v"],
    env = {"USE_BAZEL_VERSION": "8.5.1"},
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "long",
)
