module(
    name = "libyang",
    version = "3.12.2.sonic.2",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "sonic-build-infra", version = "0.0.16-d5cb35774c2c091a57b02386c88d79a96ed894c4", repo_name = "sonic_build_infra")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "pcre2", version = "10.45")
bazel_dep(name = "xxhash", version = "0.8.3")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "rules_python", version = "1.7.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libyang_debian",
    build_file_content = "exports_files(glob([\"**\"]))\nfilegroup(name=\"source_files\", srcs=glob([\"**\"]), visibility=[\"//visibility:public\"])",
    sha256 = "293892af674f2f3224675be815f942ddaef5d1f97548ad7e59092d2f1c55110a",
    strip_prefix = "debian",
    urls = ["https://deb.debian.org/debian/pool/main/liby/libyang/libyang_3.12.2-1.debian.tar.xz"],
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "libyang_package_deps",
    packages = [
        "libc6",
        "libgcc-s1",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "libyang_package_deps")

bsdtar = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(bsdtar, "bsd_tar_toolchains")

bazel_dep(name = "rules_pkg", version = "1.1.0")
