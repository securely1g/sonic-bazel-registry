# Installed public headers use a flat libyang/ namespace, including metadata.h.
[
    cc_library(
        name = "public_headers_" + directory.replace("/", "_"),
        hdrs = [header for header in LIBYANG_HDRS if header.rsplit("/", 1)[0] == directory],
        strip_include_prefix = directory,
        includes = [directory],
        include_prefix = "libyang",
    )
    for directory in ["src", "src/plugins_exts"]
]

cc_library(
    name = "generated_public_headers",
    hdrs = [":config_h", ":version_h"],
    includes = ["libyang"],
    strip_include_prefix = "libyang",
    include_prefix = "libyang",
)

cc_library(
    name = "public_headers",
    deps = [":public_headers_src", ":public_headers_src_plugins_exts", ":generated_public_headers", ":pcre2_headers"],
)

cc_library(
    name = "generated_headers",
    hdrs = [
        ":config_h",
        ":version_h",
    ],
    includes = ["libyang"],
)

cc_library(
    name = "yang_objects",
    srcs = LIBYANG_SRCS,
    hdrs = glob([
        "src/**/*.h",
        "models/*.h",
    ]) + [":compat_h"],
    copts = _DEBIAN_COPTS + [
        "-std=c11",
        "-Wall", "-Wextra", "-Wpedantic", "-O2", "-g",
        "-fvisibility=hidden",
    ],
    includes = [
        "generated",
        "src",
        "src/plugins_exts",
    ],
    local_defines = [
        "LIBYANG_BUILD",
        "LY_XXHASH_SUPPORT",
        "_FILE_OFFSET_BITS=64",
        "NDEBUG",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":generated_headers",
        ":sys_pcre2",
        ":sys_xxhash",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libyang.so.3",
    features = ["-sonic_installed_runtime_paths"],
    linkopts = [
        "-Wl,-soname,libyang.so.3",
        "-Wl,--as-needed",
        "-Wl,-z,relro", "-Wl,-z,now",
        "-lm",
        "-ldl",
        "-pthread",
    ],
    linkshared = True,
    linkstatic = True,
    deps = [":yang_objects"],
)

cc_import(
    name = "yang_shared",
    shared_library = ":libyang.so.3",
)

cc_library(
    name = "libyang",
    deps = [
        ":public_headers",
        ":yang_shared",
        ":sys_pcre2",
        ":sys_xxhash",
    ],
)

# Runtime YANG models.
_MODELS = glob(["models/*.yang"])

gzip_compress(name = "debian_changelog", src = "@libyang_debian//:changelog", level = 9)
gzip_compress(name = "yanglint_man", src = "tools/lint/yanglint.1", level = 9)
gzip_compress(name = "yangre_man", src = "tools/re/yangre.1", level = 9)

_DOCUMENTATION = {
    "usr/share/doc/libyang3/copyright": "@libyang_debian//:copyright",
    "usr/share/doc/libyang3/changelog.Debian.gz": ":debian_changelog",
}

[
    sonic_deploy_tar(
        name = "libyang_pkg_" + cpu,
        debug_symlinks = {"usr/share/doc/libyang3-dbgsym": "libyang3"},
        srcs = _MODELS + _DOCUMENTATION.values(),
        binaries = {"usr/lib/{}/libyang.so.3.9.1 type=file uid=0 gid=0 mode=0644".format(multiarch): ":libyang.so.3"},
        force_debug_build = True,
        mtree = [
            "usr/lib/{}/libyang.so.3 type=link uid=0 gid=0 mode=0777 link=libyang.so.3.9.1".format(multiarch),
        ] + [
            path + " type=file uid=0 gid=0 mode=0644 content=$(location " + source + ")"
            for path, source in _DOCUMENTATION.items()
        ] + [
            "usr/share/yang/modules/libyang/" + source[len("models/"):] + " type=file uid=0 gid=0 mode=0644 content=$(location " + source + ")"
            for source in _MODELS
        ],
        target_compatible_with = ["@platforms//cpu:" + cpu],
    )
    for cpu, multiarch in [
        ("x86_64", "x86_64-linux-gnu"),
        ("aarch64", "aarch64-linux-gnu"),
        ("armv7", "arm-linux-gnueabihf"),
    ]
]

alias(
    name = "libyang_pkg",
    actual = select({
        ":amd64": ":libyang_pkg_x86_64",
        ":arm64": ":libyang_pkg_aarch64",
        ":armhf": ":libyang_pkg_armv7",
    }),
)

alias(
    name = "libyang_pkg.debug_symbols",
    actual = select({
        ":amd64": ":libyang_pkg_x86_64.debug_symbols",
        ":arm64": ":libyang_pkg_aarch64.debug_symbols",
        ":armhf": ":libyang_pkg_armv7.debug_symbols",
    }),
)

py_binary(
    name = "libyang_package_test_runner",
    srcs = ["libyang_package_test.py"],
    main = "libyang_package_test.py",
    deps = ["@sonic_build_infra//deb:elf_metadata"],
)

exec_test(
    name = "libyang_package_test",
    runner = ":libyang_package_test_runner",
    srcs = [
        ":libyang_pkg", ":libyang_pkg.debug_symbols",
        ":development_pkg", ":tools_pkg", ":tools_pkg.debug_symbols",
        "@libyang_debian//:copyright", "@libyang_debian//:changelog",
    ] + _MODELS,
)

cc_binary(
    name = "libyang_test_binary",
    srcs = ["libyang_test.c"],
    deps = [":libyang"],
)

alias(
    name = "pcre2_headers",
    actual = select({
        ":bookworm": "@libyang_system_bookworm//libpcre2-dev:libpcre2_headers",
        "//conditions:default": "@libyang_system//libpcre2-dev:libpcre2_headers",
    }),
)

# Image metadata is derived from the Debian recipe and actual target TAR.
# The image metadata interface supports Trixie AMD64 and ARM64.
_OCI_COMPATIBLE_WITH = select({
    ":bookworm": ["@platforms//:incompatible"],
    ":armhf": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

runtime_packages(
    name = "runtime_packages.json",
    control = "@libyang_debian//:control",
    changelog = "@libyang_debian//:changelog",
    packages = {"libyang3": ":libyang_pkg"},
    apt_packages = {
        ":sys_libpcre2-8-0_data": ":sys_libpcre2-8-0_control",
        ":sys_libxxhash0_data": ":sys_libxxhash0_control",
    },
    required_paths = {"libyang3": ["usr/lib/{multiarch}/libyang.so.3"]},
    target_compatible_with = _OCI_COMPATIBLE_WITH,
)

exports_files(["MODULE.bazel", "runtime_packages.md"])

py_binary(
    name = "runtime_metadata_test_runner",
    srcs = ["runtime_metadata_test.py"],
    main = "runtime_metadata_test.py",
    deps = [
        "@sonic_build_infra//apt:lib",
        "@sonic_build_infra//oci:package_metadata",
    ],
)

exec_test(
    name = "runtime_metadata_test",
    runner = ":runtime_metadata_test_runner",
    srcs = [
        ":runtime_packages.json",
        ":libyang_pkg",
        "MODULE.bazel",
        "@libyang_debian//:control",
        "@libyang_debian//:changelog",
    ],
    checker_args = select({":arm64": ["arm64"], "//conditions:default": ["amd64"]}),
    target_compatible_with = _OCI_COMPATIBLE_WITH,
)

# Interactive yanglint is enabled.
expand_template(
    name = "tools_config_h",
    template = "tools/config.h.in",
    out = "generated/tools/config.h",
    substitutions = {"@LIBYANG_VERSION@": "3.12.2"},
)

cc_library(
    name = "tool_headers",
    hdrs = glob(["tools/lint/*.h", "tools/lint/linenoise/*.h"]) + [":tools_config_h", ":compat_h"],
    includes = ["generated"],
)

cc_binary(
    name = "yanglint",
    srcs = ["compat/compat.c"] + ["tools/lint/" + source for source in [
        "main_ni.c", "cmd.c", "cmd_add.c", "cmd_clear.c", "cmd_data.c",
        "cmd_list.c", "cmd_feature.c", "cmd_load.c", "cmd_print.c", "cmd_searchpath.c",
        "cmd_extdata.c", "cmd_help.c", "cmd_verb.c", "cmd_debug.c", "yl_opt.c",
        "yl_schema_features.c", "common.c", "main.c", "completion.c", "configuration.c",
        "linenoise/linenoise.c", "linenoise/utf8.c",
    ]],
    copts = _DEBIAN_COPTS + ["-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-DNDEBUG", "-D_FILE_OFFSET_BITS=64", "-DLY_XXHASH_SUPPORT"],
    linkopts = ["-Wl,-z,relro", "-Wl,-z,now"],
    deps = [":tool_headers", ":libyang"],
)

cc_binary(
    name = "yangre",
    srcs = ["tools/re/main.c", "compat/compat.c"],
    copts = _DEBIAN_COPTS + ["-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-DNDEBUG", "-D_FILE_OFFSET_BITS=64", "-DLY_XXHASH_SUPPORT"],
    linkopts = ["-Wl,-z,relro", "-Wl,-z,now"],
    deps = [":tool_headers", ":libyang"],
)

[
    sonic_deploy_tar(
        name = "tools_pkg_" + cpu,
        debug_symlinks = {"usr/share/doc/libyang3-tools-dbgsym": "libyang3-tools"},
        binaries = {
            "usr/bin/yanglint type=file uid=0 gid=0 mode=0755 time=0": ":yanglint",
            "usr/bin/yangre type=file uid=0 gid=0 mode=0755 time=0": ":yangre",
        },
        srcs = [":yanglint_man", ":yangre_man", ":debian_changelog", "@libyang_debian//:copyright"] + glob(["tools/lint/examples/*"]),
        mtree = [
            "usr/share/man/man1/yanglint.1.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :yanglint_man)",
            "usr/share/man/man1/yangre.1.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :yangre_man)",
            "usr/share/doc/libyang3-tools/copyright type=file uid=0 gid=0 mode=0644 time=0 content=$(location @libyang_debian//:copyright)",
            "usr/share/doc/libyang3-tools/changelog.Debian.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :debian_changelog)",
        ] + ["usr/share/doc/libyang3-tools/examples/" + source.split("/")[-1] + " type=file uid=0 gid=0 mode=0644 time=0 content=$(location " + source + ")" for source in glob(["tools/lint/examples/*"])],
        force_debug_build = True,
        target_compatible_with = ["@platforms//cpu:" + cpu],
    )
    for cpu in ["x86_64", "aarch64"]
]

alias(name = "tools_pkg", actual = select({":amd64": ":tools_pkg_x86_64", ":arm64": ":tools_pkg_aarch64"}))
alias(name = "tools_pkg.debug_symbols", actual = select({":amd64": ":tools_pkg_x86_64.debug_symbols", ":arm64": ":tools_pkg_aarch64.debug_symbols"}))

[
    expand_template(
        name = "pkgconfig_" + cpu,
        template = "libyang.pc.in",
        out = "pkgconfig/" + cpu + "/libyang.pc",
        substitutions = {
            "@CMAKE_INSTALL_PREFIX@": "/usr",
            "@CMAKE_INSTALL_INCLUDEDIR@": "include",
            "@CMAKE_INSTALL_LIBDIR@": "lib/" + multiarch,
            "@PROJECT_NAME@": "libyang",
            "@LIBYANG_DESCRIPTION@": "libyang is YANG data modelling language parser and toolkit written (and providing API) in C.",
            "@LIBYANG_VERSION@": "3.12.2",
        },
    )
    for cpu, multiarch in [("x86_64", "x86_64-linux-gnu"), ("aarch64", "aarch64-linux-gnu")]
]

[
    tar(
        name = "development_files_pkg_" + cpu,
        srcs = LIBYANG_HDRS + [
            ":config_h", ":version_h", ":pkgconfig_" + cpu,
            ":debian_changelog", "@libyang_debian//:copyright",
        ],
        mtree = [
            "usr/include/libyang/" + header.split("/")[-1] + " type=file uid=0 gid=0 mode=0644 time=0 content=$(location " + header + ")"
            for header in LIBYANG_HDRS
        ] + [
            "usr/include/libyang/ly_config.h type=file uid=0 gid=0 mode=0644 time=0 content=$(location :config_h)",
            "usr/include/libyang/version.h type=file uid=0 gid=0 mode=0644 time=0 content=$(location :version_h)",
            "usr/lib/" + multiarch + "/libyang.so type=link uid=0 gid=0 mode=0777 time=0 link=libyang.so.3",
            "usr/lib/" + multiarch + "/pkgconfig/libyang.pc type=file uid=0 gid=0 mode=0644 time=0 content=$(location :pkgconfig_" + cpu + ")",
            "usr/share/doc/libyang-dev/changelog.Debian.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :debian_changelog)",
            "usr/share/doc/libyang-dev/copyright type=file uid=0 gid=0 mode=0644 time=0 content=$(location @libyang_debian//:copyright)",
        ],
        target_compatible_with = ["@platforms//cpu:" + cpu],
    )
    for cpu, multiarch in [("x86_64", "x86_64-linux-gnu"), ("aarch64", "aarch64-linux-gnu")]
]

alias(name = "development_pkg", actual = select({":amd64": ":development_pkg_x86_64", ":arm64": ":development_pkg_aarch64"}))


