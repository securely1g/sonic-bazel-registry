# Target glibc platforms use little-endian configuration.
config_setting(
    name = "amd64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "arm64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "armhf",
    constraint_values = ["@platforms//cpu:armv7"],
)

# Debian suite hardening flags.
_DEBIAN_COPTS = [
    "-g", "-O2", "-fstack-protector-strong",
    "-D_FORTIFY_SOURCE=2", "-Wdate-time", "-Wformat", "-Werror=format-security",
] + select({
    ":bookworm": [],
    ":trixie_amd64": ["-fstack-clash-protection", "-Werror=implicit-function-declaration", "-fcf-protection"],
    ":trixie_arm64": ["-fstack-clash-protection", "-Werror=implicit-function-declaration", "-mbranch-protection=standard"],
})

