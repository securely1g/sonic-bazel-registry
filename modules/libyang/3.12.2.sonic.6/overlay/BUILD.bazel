        srcs = LIBYANG_HDRS + [
            ":config_h", ":version_h", ":pkgconfig_" + cpu,
            ":debian_changelog", "@libyang_debian//:copyright",
        ] + [":html_docs"],
        mtree = ":development_install_mtree_" + cpu,
        target_compatible_with = ["@platforms//cpu:" + cpu],
    )
    for cpu in ["x86_64", "aarch64"]
]


