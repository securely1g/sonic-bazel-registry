load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "util",
    srcs = [
        "debug.go",
        "errs.go",
        "gnmi.go",
        "path.go",
        "reflect.go",
        "yang.go",
    ],
    importpath = "github.com/openconfig/ygot/util",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_golang_glog//:glog",
        "@com_github_golang_protobuf//proto",
        "@com_github_google_go_cmp//cmp",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

alias(
    name = "go_default_library",
    actual = ":util",
    visibility = ["//visibility:public"],
)

go_test(
    name = "util_test",
    srcs = [
        "debug_test.go",
        "errs_test.go",
        "gnmi_test.go",
        "path_test.go",
        "reflect_test.go",
        "sonic_assignability_test.go",
        "yang_test.go",
    ],
    args = ["-test.v"],
    embed = [":util"],
    deps = [
        "//internal/sonicfixture",
        "//testutil",
        "@com_github_golang_protobuf//proto",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)
