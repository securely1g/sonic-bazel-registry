load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "getting_started_lib",
    srcs = ["interfaces.go"],
    importpath = "github.com/openconfig/ygot/demo/getting_started",
    visibility = ["//visibility:private"],
    deps = [
        "//demo/getting_started/pkg/ocdemo",
        "//ygot",
    ],
)

go_binary(
    name = "getting_started",
    embed = [":getting_started_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "getting_started_test",
    srcs = ["interfaces_test.go"],
    args = ["-test.v"],
    data = glob(["yang/**"]),
    embed = [":getting_started_lib"],
    deps = [
        "//genutil",
        "//ygen",
    ],
)

# Match the original go:generate preparation required by upstream Make/CI.
genrule(
    name = "generated_oc",
    srcs = glob(["yang/**"]),
    outs = ["generated_oc.go"],
    cmd = "$(execpath //generator:generator) -path=$$(dirname $(location yang/openconfig-interfaces.yang)) -output_file=$@ -package_name=ocdemo -generate_fakeroot -fakeroot_name=device -compress_paths=true -exclude_modules=ietf-interfaces $(location yang/openconfig-interfaces.yang) $(location yang/openconfig-if-ip.yang)",
    tools = ["//generator"],
    visibility = ["//visibility:public"],
)
