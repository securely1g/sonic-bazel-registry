load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "path_tests",
    srcs = ["path.go"],
    importpath = "github.com/openconfig/ygot/ypathgen/path_tests",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":path_tests",
    visibility = ["//visibility:public"],
)

go_test(
    name = "path_tests_test",
    srcs = ["path_test.go"],
    args = ["-test.v"],
    embed = [":path_tests"],
    deps = [
        "//exampleoc",
        "//exampleocpath",
        "//ygot",
        "//ypathgen",
        "@com_github_golang_protobuf//proto",
        "@com_github_google_go_cmp//cmp",
    ],
)
