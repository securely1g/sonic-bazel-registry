+// Keep the pre-protocmp public API available to existing SONiC callers.
+var _ func(*gnmipb.TypedValue_JsonIetfVal, *gnmipb.TypedValue_JsonIetfVal) bool = JSONIETFComparer
+
+func TestJSONIETFComparerPublicAPI(t *testing.T) {
+	for _, tt := range []struct {
+		name, a, b string
+		want       bool
+	}{
+		{"object order", `{"a":1,"b":2}`, `{"b":2,"a":1}`, true},
+		{"different value", `{"a":1}`, `{"a":2}`, false},
+		{"invalid first", `{`, `{"a":1}`, false},
+		{"invalid second", `{"a":1}`, `{`, false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			a := &gnmipb.TypedValue_JsonIetfVal{JsonIetfVal: []byte(tt.a)}
+			b := &gnmipb.TypedValue_JsonIetfVal{JsonIetfVal: []byte(tt.b)}
+			if got := JSONIETFComparer(a, b); got != tt.want {
+				t.Errorf("JSONIETFComparer(%q, %q) = %v, want %v", tt.a, tt.b, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNotificationSetEqualDistinctJSONOneof(t *testing.T) {
+	jsonValue := jsonIETF(`{"a":1}`)
+	stringValue := &gnmipb.TypedValue{Value: &gnmipb.TypedValue_StringVal{StringVal: `{"a":1}`}}
+	notifications := func(value *gnmipb.TypedValue) []*gnmipb.Notification {
+		return []*gnmipb.Notification{{Update: []*gnmipb.Update{{Val: value}}}}
+	}
+	for _, values := range [][2]*gnmipb.TypedValue{{jsonValue, stringValue}, {stringValue, jsonValue}} {
+		if NotificationSetEqual(notifications(values[0]), notifications(values[1])) {
+			t.Error("JSON IETF and string oneofs must remain unequal")
+		}
+	}
+}
