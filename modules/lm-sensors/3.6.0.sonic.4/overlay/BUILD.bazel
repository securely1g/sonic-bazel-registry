runtime_packages(
    name = "runtime_packages.json",
    apt_packages = {"@lm_sensors_debian//librrd8t64:data": "@lm_sensors_debian//librrd8t64:control"},
    changelog = "debian/changelog",
    control = "debian/control",
    control_file_helpers = [["dh_installdeb"]],
    control_file_helpers_by_package = {
        "libsensors5": [
            ["dh_makeshlibs"],
            ["dh_installdeb"],
        ],
    } | {
        package: [
            [
                "dh_installinit",
                option,
            ],
            [
                "dh_installsystemd",
                option,
            ],
            ["dh_installdeb"],
        ]
        for package, option in {
            "fancontrol": "--restart-after-upgrade",
            "lm-sensors": "--no-start",
            "sensord": "--no-start",
        }.items()
    },
    debian_files = {p[len("debian/"):]: p for p in glob(
        ["debian/*"],
        exclude = [
            "debian/control",
            "debian/changelog",
        ],
    )},
    packages = {
        "libsensors5": ":libsensors5.runtime",
        "lm-sensors": ":lm-sensors.runtime",
        "fancontrol": ":fancontrol.runtime",
        "sensord": ":sensord.runtime",
    },
    symbols = {"libsensors5": "debian/libsensors5.symbols"},
)

