# Upstream's --version entry point exercises the installed SONAME without
# requiring sensor hardware or consulting the worker's library installation.
native_runtime_test(
    name = "sensors_runtime_test",
    args = ["--version"],
    binary = "@lm_sensors_source//:sensors",
    runtime_payloads = [
        ":libsensors5.runtime",
        "@lm_sensors_debian//libc6:data",
    ],
)

[
    source_package_controls(
        name = package + ".control",
        metadata = ":runtime_packages.json",
        package = package,
    )
    for package in [
        "lm-sensors",
        "libsensors5",
        "fancontrol",
        "sensord",
    ]
]

filegroup(
    name = "debug_sources",
    srcs = ["@lm_sensors_source//:debug_sources"],
)

native_runtime_binary(
    name = "scanner_runner",
    binary = "@lm_sensors_source//:test-scanner",
    runtime_payloads = ["@lm_sensors_debian//libc6:data"],
)

py_test(
    name = "scanner_test",
    srcs = ["scanner_test.py"],
    args = ["$(rootpath :scanner_runner)"],
    data = [":scanner_runner"],
)

native_runtime_test(
