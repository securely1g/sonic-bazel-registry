cc_library(name = "bundled_headers", hdrs = glob(["include/**/*.h"]), strip_include_prefix = "include")
cc_library(
    name = "headers",
    hdrs = glob(["src/**/*.h"]) + [":configuration"],
    includes = [".", "src", "src/compat", "src/lib", "src/daemon", "src/client"],
    deps = [":bundled_headers"],
    defines = ["HAVE_CONFIG_H=1", "_GNU_SOURCE", "SYSCONFDIR=\\\"/etc\\\"", "LLDPCLI_PATH=\\\"/usr/sbin/lldpcli\\\""],
)

cc_library(
    name = "compat",
    srcs = ["src/compat/empty.c"],
    deps = [":headers", "@iproute2_deps//libbsd-dev:pkgconfig/libbsd"],
    copts = _COPTS,
)
cc_library(
    name = "common",
    srcs = ["src/log.c", "src/version.c", "src/marshal.c", "src/ctl.c", "src/lldpd-structs.c"],
    deps = [":compat"],
    copts = _COPTS,
)
cc_library(
    name = "common_client",
    srcs = ["src/log.c", "src/version.c"],
    deps = [":compat"],
    copts = _COPTS,
)
cc_library(name = "fixedpoint", srcs = ["src/lib/fixedpoint.c"], deps = [":headers"], copts = _COPTS)

_ATOMS = ["config", "dot1", "dot3", "interface", "med", "mgmt", "port", "custom", "chassis"]
[cc_preprocess(name = "atom_" + name, src = "src/lib/atoms/" + name + ".c", deps = [":headers", ":compat"], copts = _COPTS) for name in _ATOMS]
run_binary(
    name = "atom_glue",
    tool = "@lldpd//:atom_glue",
    srcs = [":atom_" + name for name in _ATOMS],
    outs = ["src/lib/atom-glue.c"],
    args = ["$(location :atom_" + name + ")" for name in _ATOMS] + ["$(location src/lib/atom-glue.c)"],
)
cc_library(
    name = "liblldpctl_objects",
    srcs = ["src/lib/errors.c", "src/lib/connection.c", "src/lib/atom.c", "src/lib/helpers.c", ":atom_glue"] + ["src/lib/atoms/" + name + ".c" for name in _ATOMS],
    deps = [":common", ":fixedpoint"],
    copts = _COPTS,
)
cc_shared_library(
    name = "liblldpctl",
    deps = [":liblldpctl_objects"],
    shared_lib_name = "liblldpctl.so.4",
    user_link_flags = _LINKOPTS + ["-Wl,-soname,liblldpctl.so.4", "-Wl,--version-script=$(location src/lib/lldpctl.map)"],
    additional_linker_inputs = ["src/lib/lldpctl.map"],
    features = ["-strip_debug_symbols"],
)
shared_library_cc_info(name = "liblldpctl_link", shared_library = ":liblldpctl", runtime_deps = ["@iproute2_deps//libbsd-dev:pkgconfig/libbsd"])
cc_library(name = "lldpctl_headers", hdrs = ["src/lib/lldpctl.h"], strip_include_prefix = "src/lib", deps = [":lldp_constants"])
cc_library(name = "lldp_constants", hdrs = ["src/lldp-const.h"], strip_include_prefix = "src")
cc_library(name = "lldpctl", deps = [":lldpctl_headers", ":liblldpctl_link"])

# Debian net-snmp-config --base-cflags applies only to the two SNMP objects.
# Public include/link paths come from CcInfo; source-package build paths are
# provenance rather than lldpd inputs. Architecture hardening follows the target.
cc_library(
    name = "snmp",
    srcs = ["src/daemon/agent.c", "src/daemon/agent_priv.c"],
    deps = [":common", "@dhcpmon_debian//libevent-dev:pkgconfig/libevent", "@frr_deps//libcap-dev:libcap_cc", "@frr_deps//libsnmp-dev:pkgconfig/netsnmp-agent"],
    copts = _COPTS + ["-Werror=implicit-function-declaration", "-fstack-clash-protection", "-fno-strict-aliasing", "-fwrapv", "-Wdate-time", "-Ulinux", "-Dlinux=linux", "-pipe"] + select({
        "@platforms//cpu:aarch64": ["-mbranch-protection=standard"],
        "//conditions:default": ["-fcf-protection"],
    }),
    local_defines = ["NETSNMP_USE_INLINE", "NETSNMP_ENABLE_IPV6", "NETSNMP_REMOVE_U64", "NETSNMP_NO_INLINE", "_REENTRANT", "_GNU_SOURCE", "DEBIAN", "_LARGEFILE_SOURCE", "_FILE_OFFSET_BITS=64"],
)

filegroup(name = "snmp_objects", srcs = [":snmp"], output_group = "compilation_outputs")
cc_library(
    name = "daemon",
    srcs = [
        "src/daemon/frame.c", "src/daemon/client.c", "src/daemon/priv.c",
        "src/daemon/privsep.c", "src/daemon/privsep_io.c", "src/daemon/privsep_fd.c",
        "src/daemon/interfaces.c", "src/daemon/event.c", "src/daemon/lldpd.c",
        "src/daemon/pattern.c", "src/daemon/bitmap.c",
        "src/daemon/protocols/lldp.c", "src/daemon/protocols/cdp.c",
        "src/daemon/protocols/sonmp.c", "src/daemon/protocols/edp.c",
        "src/daemon/forward-linux.c", "src/daemon/interfaces-linux.c",
        "src/daemon/netlink.c", "src/daemon/dmi-linux.c", "src/daemon/priv-linux.c",
        ":snmp_objects",
    ],
    deps = [":common", "@dhcpmon_debian//libevent-dev:pkgconfig/libevent", "@frr_deps//libcap-dev:libcap_cc", "@frr_deps//libsnmp-dev:pkgconfig/netsnmp-agent"],
    copts = _COPTS,
)
cc_binary(name = "lldpd", srcs = ["src/daemon/main.c"], deps = [":daemon"], copts = _COPTS + ["-fPIE"], linkopts = _LINKOPTS + ["-fPIE", "-pie"], features = ["-strip_debug_symbols"])
cc_binary(
    name = "lldpcli",
    srcs = [
        "src/client/lldpcli.c", "src/client/display.c", "src/client/conf.c",
        "src/client/conf-med.c", "src/client/conf-inv.c", "src/client/conf-dot3.c",
        "src/client/conf-power.c", "src/client/conf-lldp.c", "src/client/conf-system.c",
        "src/client/commands.c", "src/client/show.c", "src/client/misc.c",
        "src/client/tokenizer.c", "src/client/utf8.c", "src/client/text_writer.c",
        "src/client/kv_writer.c", "src/client/json_writer.c", "src/client/xml_writer.c",
    ],
    deps = [":common_client", ":lldpctl", "@frr_deps//libreadline-dev:pkgconfig/readline", "@trixie//libxml2-dev:pkgconfig/libxml-2.0"],
    copts = _COPTS,
    linkopts = _LINKOPTS + ["-fPIE", "-pie"],
    features = ["-strip_debug_symbols"],
)

_CHECKS = ["marshal", "pattern", "bitmap", "fixedpoint", "lldp", "cdp", "sonmp", "edp", "snmp"]
[
    cc_binary(
        name = "check_" + name,
        srcs = ["tests/check_" + name + ".c"] + (["tests/common.c"] if name in ["lldp", "cdp", "sonmp", "edp"] else []) + glob(["tests/*.h"]),
        deps = [":daemon", ":fixedpoint", "@sonic_build_infra//apt/check:check"],
        copts = _COPTS + ["-Wno-format-extra-args"],
        linkopts = _LINKOPTS + ["-fPIE", "-pie"],
        features = ["-strip_debug_symbols"],
    )
    for name in _CHECKS
]
filegroup(name = "upstream_tests", srcs = [":check_" + name for name in _CHECKS])

_TEMPLATE_SUBSTITUTIONS = {
    "@bindir@": "/usr/bin", "@sbindir@": "/usr/sbin", "@sysconfdir@": "/etc",
    "@pkgdatadir@": "/usr/share/lldpd", "@includedir@": "/usr/include",
    "@exec_prefix@": "/usr", "@prefix@": "/usr", "@VERSION@": "1.0.16",
    "@PACKAGE@": "lldpd", "@PACKAGE_NAME@": "lldpd", "@PACKAGE_URL@": "https://lldpd.github.io/",
    "@PRIVSEP_USER@": "_lldpd", "@PRIVSEP_GROUP@": "_lldpd", "@PRIVSEP_CHROOT@": "/run/lldpd",
    "@LLDPD_PID_FILE@": "/run/lldpd.pid", "@LLDPD_CTL_SOCKET@": "/run/lldpd.socket",
}
[
    expand_template(name = name, template = source, out = output, substitutions = select({"@platforms//cpu:aarch64": _TEMPLATE_SUBSTITUTIONS | {"@libdir@": "/usr/lib/aarch64-linux-gnu"}, "//conditions:default": _TEMPLATE_SUBSTITUTIONS | {"@libdir@": "/usr/lib/x86_64-linux-gnu"}}))
    for name, source, output in [
        ("data_1", "src/daemon/lldpd.service.in", "lldpd.service"),
        ("data_2", "src/daemon/lldpd.8.in", "lldpd.8"),
        ("data_3", "src/client/lldpcli.8.in", "lldpcli.8"),
        ("pkgconfig", "src/lib/lldpctl.pc.in", "lldpctl.pc"),
    ]
]
alias(name = "data_0", actual = "src/client/README.conf")
alias(name = "data_5", actual = "src/client/completion/lldpcli")
alias(name = "data_6", actual = "src/client/completion/_lldpcli")
_DOCS = {
    "usr/share/doc/lldpd/NEWS.gz": "NEWS",
    "usr/share/doc/lldpd/README.md.gz": "README.md",
    "usr/share/doc/lldpd/changelog.gz": "ChangeLog",
    "usr/share/doc/lldpd/changelog.Debian.gz": "debian/changelog",
}
[gzip_compress(name = "doc_" + str(index), src = source, level = 9) for index, source in enumerate(_DOCS.values())]
[gzip_compress(name = "manual_" + str(index), src = ":data_" + str(index), level = 9) for index in [2, 3]]
_FILES = {
    "etc/lldpd.d/README.conf": ":data_0",
    "lib/systemd/system/lldpd.service": ":data_1",
    "usr/share/bash-completion/completions/lldpcli": ":data_5",
    "usr/share/zsh/vendor-completions/_lldpcli": ":data_6",
    "usr/share/man/man8/lldpd.8.gz": ":manual_2",
    "usr/share/man/man8/lldpcli.8.gz": ":manual_3",
    "usr/share/doc/lldpd/README.Debian": "debian/README.Debian",
    "usr/share/lintian/overrides/lldpd": "debian/lldpd.lintian-overrides",
    "usr/share/doc/lldpd/copyright": "debian/copyright",
    "usr/share/doc/lldpd/CONTRIBUTE.md": "CONTRIBUTE.md",
    "etc/default/lldpd": "debian/lldpd.default",
} | {path: ":doc_" + str(index) for index, path in enumerate(_DOCS)}
# sonic_deploy_tar's installation mappings are static in the published infra.
# Only package paths vary with the target; all variants consume the same native
# program/library targets and share one source and configuration graph.
[
    sonic_deploy_tar(
        name = "_lldpd_runtime_" + cpu,
        binaries = {
            "usr/sbin/lldpd uid=0 gid=0 mode=0755 type=file": ":lldpd",
            "usr/sbin/lldpcli uid=101 gid=4 mode=04750 type=file": ":lldpcli",
            "usr/lib/" + GCC_METADATA[cpu].multiarch + "/liblldpctl.so.4.9.1 uid=0 gid=0 mode=0644 type=file": ":liblldpctl",
        },
        srcs = _FILES.values() + ["debian/lldpd.init.d"],
        mtree = [path + " uid=0 gid=0 mode=0644 type=file content=$(location " + label + ")" for path, label in _FILES.items()] + [
            "etc/init.d/lldpd uid=0 gid=0 mode=0755 type=file content=$(location debian/lldpd.init.d)",
            "usr/sbin/lldpctl uid=0 gid=0 mode=0777 type=link link=lldpcli",
            "usr/share/man/man8/lldpctl.8.gz uid=0 gid=0 mode=0777 type=link link=lldpcli.8.gz",
            "usr/lib/" + GCC_METADATA[cpu].multiarch + "/liblldpctl.so.4 uid=0 gid=0 mode=0777 type=link link=liblldpctl.so.4.9.1",
        ],
        force_debug_build = True,
        target_compatible_with = ["@platforms//cpu:" + cpu],
        visibility = ["//:__pkg__"],
    )
    for cpu in _INSTALL_CPUS
]
[
    sonic_deploy_tar(
        name = "_liblldpctl_dev_runtime_" + cpu,
        srcs = ["src/lib/lldpctl.h", "src/lldp-const.h", ":pkgconfig"],
        mtree = [
            "usr/include/lldpctl.h uid=0 gid=0 mode=0644 type=file content=$(location src/lib/lldpctl.h)",
            "usr/include/lldp-const.h uid=0 gid=0 mode=0644 type=file content=$(location src/lldp-const.h)",
            "usr/lib/" + GCC_METADATA[cpu].multiarch + "/liblldpctl.so uid=0 gid=0 mode=0777 type=link link=liblldpctl.so.4",
            "usr/lib/" + GCC_METADATA[cpu].multiarch + "/pkgconfig/lldpctl.pc uid=0 gid=0 mode=0644 type=file content=$(location :pkgconfig)",
        ],
        target_compatible_with = ["@platforms//cpu:" + cpu],
        visibility = ["//:__pkg__"],
    )
    for cpu in _INSTALL_CPUS
]
alias(name = "lldpd.runtime", actual = select({"@platforms//cpu:" + cpu: ":_lldpd_runtime_" + cpu for cpu in _INSTALL_CPUS}))
alias(name = "lldpd.runtime.debug_symbols", actual = select({"@platforms//cpu:" + cpu: ":_lldpd_runtime_" + cpu + ".debug_symbols" for cpu in _INSTALL_CPUS}))
alias(name = "liblldpctl-dev.runtime", actual = select({"@platforms//cpu:" + cpu: ":_liblldpctl_dev_runtime_" + cpu for cpu in _INSTALL_CPUS}))
runtime_packages(
    name = "lldpd.runtime_metadata",
    control = "debian/control",
    changelog = "debian/changelog",
    module_name = "lldpd",
    packages = {"lldpd": ":lldpd.runtime", "liblldpctl-dev": ":liblldpctl-dev.runtime"},
    apt_packages = {
        "@frr_deps//libsnmp40t64:data": "@frr_deps//libsnmp40t64:control",
        "@frr_deps//libreadline8t64:data": "@frr_deps//libreadline8t64:control",
        "@frr_deps//libcap2:data": "@frr_deps//libcap2:control",
        "@dhcpmon_debian//libevent-2.1-7t64:data": "@dhcpmon_debian//libevent-2.1-7t64:control",
        "@iproute2_deps//libbsd0:data": "@iproute2_deps//libbsd0:control",
        "@trixie//libxml2:data": "@trixie//libxml2:control",
    },
)
alias(name = "runtime", actual = ":lldpd.runtime")
alias(name = "runtime.debug_symbols", actual = ":lldpd.runtime.debug_symbols")

alias(name = "liblldpctl-dev.runtime_metadata", actual = ":lldpd.runtime_metadata")
