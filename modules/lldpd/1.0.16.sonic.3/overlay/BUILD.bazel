load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@sonic_build_infra//testing:exec_test.bzl", "exec_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_multirun//:defs.bzl", "command")
load("@toolchain_utils//toolchain/info:defs.bzl", "toolchain_info")
package(default_visibility = ["//visibility:public"])
exports_files(glob(["bazel/**"]))
command(name = "reproducible_gzip", command = "@pigz", arguments = ["--no-name"])
toolchain_info(name = "gzip_info", target = ":reproducible_gzip")
toolchain(name = "gzip_toolchain", toolchain = ":gzip_info", toolchain_type = "@rules_gzip//gzip/toolchain/gzip:type")
py_binary(name = "atom_glue", srcs = ["bazel/atom_glue.py"])
[
    alias(name = name, actual = "@lldpd_source//:" + name)
    for name in ["configure", "sources", "configuration", "lldpd", "lldpcli", "liblldpctl", "lldpctl", "upstream_tests", "lldpd.runtime", "lldpd.runtime.debug_symbols", "liblldpctl-dev.runtime", "lldpd.runtime_metadata", "liblldpctl-dev.runtime_metadata", "runtime", "runtime.debug_symbols"]
]

# The shared APT closure is a test runtime only. Compilation consumes CcInfo.
flatten(name = "test_runtime", testonly = True, tars = ["@frr_deps//libsnmp40t64", "@frr_deps//libreadline8t64", "@frr_deps//libcap2", "@dhcpmon_debian//libevent-2.1-7t64", "@iproute2_deps//libbsd0", "@trixie//libxml2", "@trixie//libsubunit0"])
_ARCH_ARGS = select({"@platforms//cpu:aarch64": ["arm64"], "//conditions:default": ["amd64"]})
_CHECKS = ["marshal", "pattern", "bitmap", "fixedpoint", "lldp", "cdp", "sonmp", "edp", "snmp"]
py_binary(name = "upstream_runner", testonly = True, srcs = ["bazel/upstream_test.py", "bazel/package_test.py"], main = "bazel/upstream_test.py")
exec_test(
    name = "upstream_test",
    runner = ":upstream_runner",
    checker_args = _ARCH_ARGS + ["$(location :test_runtime)"] + ["$(location @lldpd_source//:check_" + name + ")" for name in _CHECKS],
    data = [":test_runtime"] + ["@lldpd_source//:check_" + name for name in _CHECKS],
)
_FILES = {
    "etc/lldpd.d/README.conf": "@lldpd_source//:data_0",
    "lib/systemd/system/lldpd.service": "@lldpd_source//:data_1",
    "usr/share/man/man8/lldpd.8.gz": "@lldpd_source//:data_2",
    "usr/share/man/man8/lldpcli.8.gz": "@lldpd_source//:data_3",
    "usr/share/bash-completion/completions/lldpcli": "@lldpd_source//:data_5",
    "usr/share/zsh/vendor-completions/_lldpcli": "@lldpd_source//:data_6",
    "etc/default/lldpd": "@lldpd_source//:debian/lldpd.default",
    "etc/init.d/lldpd": "@lldpd_source//:debian/lldpd.init.d",
    "usr/share/doc/lldpd/README.Debian": "@lldpd_source//:debian/README.Debian",
    "usr/share/lintian/overrides/lldpd": "@lldpd_source//:debian/lldpd.lintian-overrides",
    "usr/share/doc/lldpd/copyright": "@lldpd_source//:debian/copyright",
    "usr/share/doc/lldpd/CONTRIBUTE.md": "@lldpd_source//:CONTRIBUTE.md",
    "usr/share/doc/lldpd/NEWS.gz": "@lldpd_source//:NEWS",
    "usr/share/doc/lldpd/README.md.gz": "@lldpd_source//:README.md",
    "usr/share/doc/lldpd/changelog.gz": "@lldpd_source//:ChangeLog",
    "usr/share/doc/lldpd/changelog.Debian.gz": "@lldpd_source//:debian/changelog",
}
py_binary(name = "package_runner", testonly = True, srcs = ["bazel/package_test.py"], main = "bazel/package_test.py")
exec_test(
    name = "package_test",
    runner = ":package_runner",
    checker_args = ["--architecture"] + _ARCH_ARGS + [
        "--runtime", "$(location :lldpd.runtime)",
        "--debug", "$(location :lldpd.runtime.debug_symbols)",
        "--development", "$(location :liblldpctl-dev.runtime)",
        "--configuration", "$(location :configuration)",
        "--consumer", "$(location :consumer)",
        "--dependencies", "$(location :test_runtime)",
        "--readelf", "$(location @sonic_build_infra//toolchains/binutils:readelf)",
        "--objcopy", "$(location @sonic_build_infra//toolchains/binutils:objcopy)",
    ] + [item for installed, source in _FILES.items() for item in ["--file", installed, "$(location " + source + ")"]],
    data = [":consumer", ":lldpd.runtime", ":lldpd.runtime.debug_symbols", ":liblldpctl-dev.runtime", ":configuration", ":test_runtime", "@sonic_build_infra//toolchains/binutils:readelf", "@sonic_build_infra//toolchains/binutils:objcopy"] + _FILES.values(),
)

cc_binary(
    name = "consumer",
    testonly = True,
    srcs = ["bazel/consumer.c"],
    deps = [":lldpctl"],
)
