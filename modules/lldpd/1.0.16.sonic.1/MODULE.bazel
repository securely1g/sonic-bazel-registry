module(name = "lldpd", version = "1.0.16.sonic.1")

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0.sonic.1")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "pigz", version = "2.8.bcr.2")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "toolchain_utils", version = "1.0.2")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "sonic-build-infra", version = "0.0.25-17a1e555291c64be1a6ff008f33352bffc4f8e5c", repo_name = "sonic_build_infra")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")
register_toolchains("@gcc_toolchains//:all")
register_toolchains("//:gzip_toolchain")
register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
    "@sonic_build_infra//tools/build_tools:autoconf_toolchain",
)

# Target headers/libraries from the shared immutable Debian snapshots.
# Execution tools remain in sonic-build-infra's shared foreign_runtime.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(
    lock = "//:bazel/apt.lock.json",
)
use_repo(apt, "lldpd_deps")

# Both archive identities match lldpd_1.0.16-1+deb12u1.dsc. Source preparation
# applies Debian's recorded quilt series before the SONiC patches. The second
# patch keeps its original changes with corrected counts in one hunk header.
lldpd_source = use_repo_rule("//:bazel/source.bzl", "lldpd_source")
lldpd_source(
    name = "lldpd_source",
    upstream_url = "https://deb.debian.org/debian/pool/main/l/lldpd/lldpd_1.0.16.orig.tar.gz",
    upstream_sha256 = "e3b391650c7ba67cea2fe84d67fdb4d7fc8aa1ec5cf86eb8bb984711df8465a9",
    debian_url = "https://deb.debian.org/debian/pool/main/l/lldpd/lldpd_1.0.16-1+deb12u1.debian.tar.xz",
    debian_sha256 = "8386992f3755e3aef666ef9a9a5e33df95add994e595cffc535645511bcafec9",
    sonic_series = "//:bazel/patch/series",
    sonic_patches = [
        "//:bazel/patch/0001-return-error-when-port-does-not-exist.patch",
        "//:bazel/patch/0002-use-a-different-socket-for-changes-and-queries.patch",
    ],
    overlays = {
        "//:bazel/lldpd.BUILD.bazel": "BUILD.bazel",
        "//:bazel/configure.sh": "bazel/configure.sh",
    },
)
