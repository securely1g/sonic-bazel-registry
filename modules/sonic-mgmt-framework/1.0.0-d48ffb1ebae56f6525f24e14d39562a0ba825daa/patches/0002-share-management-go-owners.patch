From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH 2/2] Contribute Framework dependencies to the consuming Go workspace

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -11,12 +11,12 @@
 bazel_dep(name = "gazelle", version = "0.54.0")
 bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.1-20200309174518-a00bece872fc", repo_name = "com_github_openconfig_goyang")
 bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.1", repo_name = "com_github_openconfig_ygot")
-bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", repo_name = "io_bazel_rules_go")
 bazel_dep(name = "sonic-build-infra", version = "0.0.28-9965823498ab54816de5addb6084638470dd04d7", repo_name = "sonic_build_infra")
 
 single_version_override(
     module_name = "rules_go",
-    version = "0.64.1-sonic.1",
+    version = "0.65.0.sonic.1",
 )
 
 single_version_override(
@@ -25,7 +25,8 @@
 )
 
 go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
-go_deps.from_file(go_work = "//:go.bazel.work")
+# A consuming root owns its Go workspace. Contribute the Framework module dependencies.
+go_deps.from_file(go_mod = "//:go.mod")
 
 # Root-only patch selection, matching the management-common owner.
 go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
