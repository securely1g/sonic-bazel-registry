From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH 2/2] Preserve Framework non-root Go and tool selection

The source already uses the landed Management Common and shared YANG owners.
Retain the existing registry consumer rules_go, Distroless and maintained
infrastructure selections, and use go.mod discovery beneath the consuming
root Go workspace. The source root keeps its separate CLI archive override.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -11,12 +11,12 @@
 bazel_dep(name = "gazelle", version = "0.54.0")
 bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.1-20200309174518-a00bece872fc", repo_name = "com_github_openconfig_goyang")
 bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.1", repo_name = "com_github_openconfig_ygot")
-bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
-bazel_dep(name = "sonic-build-infra", version = "0.0.25-17a1e555291c64be1a6ff008f33352bffc4f8e5c", repo_name = "sonic_build_infra")
+bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "sonic-build-infra", version = "0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e", repo_name = "sonic_build_infra")
 
 single_version_override(
     module_name = "rules_go",
-    version = "0.64.1-sonic.1",
+    version = "0.65.0.sonic.1",
 )
 
 single_version_override(
@@ -25,7 +25,10 @@
 )
 
 go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
-go_deps.from_file(go_work = "//:go.bazel.work")
+
+# The consuming root owns the single Go work-file selection. This module
+# contributes its requirements through standard non-root go.mod discovery.
+go_deps.from_file(go_mod = "//:go.mod")
 
 # Root-only patch selection, matching the management-common owner.
 go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
@@ -75,7 +78,7 @@
 bazel_dep(name = "bazel_skylib", version = "1.9.2")
 bazel_dep(name = "platforms", version = "1.1.0")
 bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
-bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
+bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.16")
 bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
 
 gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
@@ -105,11 +108,3 @@
 use_repo(apt, "framework_cli_target_debian")
 
 bazel_dep(name = "rules_cc", version = "0.2.18")
-
-# Temporary immutable selection for the shared CLI execution-tool extension.
-archive_override(
-    module_name = "sonic-build-infra",
-    integrity = "sha256-U6b0szFANCQXXbl3MmLYjjn8YVze4e8AJ3a5iJS4OSg=",
-    strip_prefix = "sonic-build-infra-f2015163598aee7e8e3df7ee1b2a13969a353236",
-    urls = ["https://github.com/securely1g/sonic-build-infra/archive/f2015163598aee7e8e3df7ee1b2a13969a353236.tar.gz"],
-)
