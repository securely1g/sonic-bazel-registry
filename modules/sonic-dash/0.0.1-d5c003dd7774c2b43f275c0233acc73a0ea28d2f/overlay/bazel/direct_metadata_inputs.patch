+# @brief Resolve declared generator inputs when an input map is supplied.
+my $inputMap;
+if (defined $ENV{SAI_METADATA_INPUTS})
+{
+    open(my $manifest, '<', $ENV{SAI_METADATA_INPUTS})
+        or die "Couldn't open SAI metadata input map: $!";
+    local $/;
+    $inputMap = decode_json(<$manifest>);
+    close $manifest;
+}
+
+sub DeclaredMetadataInput
+{
+    my $file = shift;
+    return $file if not defined $inputMap;
+    return $inputMap->{"."}{$file} if exists $inputMap->{"."}{$file};
+
+    die "SAI metadata input '$file' is missing from the input map";
+}
+
+sub DeclaredFiles
+{
+    my ($dir, $regex) = @_;
+    my $files = $inputMap->{$dir} or die "Unknown SAI metadata input directory '$dir'";
+    return sort grep { /$regex/ } keys %{$files};
+}
+
