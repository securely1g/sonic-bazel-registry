filegroup(
    name = "p4_sources",
    srcs = glob([
        "bmv2/**/*.h",
        "bmv2/**/*.p4",
        "*.p4",
    ], exclude = ["bmv2/dash_pipeline.p4"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "pipeline",
    srcs = [":p4_sources", "bmv2/dash_pipeline.p4"],
    outs = [
        "bmv2/dash_pipeline.bmv2/dash_pipeline.json",
        "bmv2/dash_pipeline.bmv2/dash_pipeline_p4rt.json",
        "bmv2/dash_pipeline.bmv2/dash_pipeline_p4rt.txt",
        "bmv2/dash_pipeline.bmv2/dash_pipeline_ir.json",
    ],
    cmd = '"$(execpath @p4c//:p4c_bm2_ss)" -DTARGET_BMV2_V1MODEL -I "$$(dirname $(execpath bmv2/dash_pipeline.p4))/.." "$(execpath bmv2/dash_pipeline.p4)" ' +
          '-o "$(execpath bmv2/dash_pipeline.bmv2/dash_pipeline.json)" ' +
          '--p4runtime-files "$(execpath bmv2/dash_pipeline.bmv2/dash_pipeline_p4rt.json),$(execpath bmv2/dash_pipeline.bmv2/dash_pipeline_p4rt.txt)" ' +
          '--toJSON "$(execpath bmv2/dash_pipeline.bmv2/dash_pipeline_ir.json)"',
    tools = ["@p4c//:p4c_bm2_ss"],
    visibility = ["//dash-pipeline/SAI:__pkg__"],
)
