load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

py_test(
    name = "archive_contract_test",
    srcs = ["archive_contract_test.py"],
    args = [
        "$(rootpath @sonic-dbsyncd//:sonic_dbsyncd_wheel)",
        "$(rootpath @sonic-dbsyncd//:sonic_dbsyncd_runtime)",
        "$(rootpath @sonic-dbsyncd//:setup.py)",
    ],
    data = [
        "@sonic-dbsyncd//:setup.py",
        "@sonic-dbsyncd//:sonic_dbsyncd_runtime",
        "@sonic-dbsyncd//:sonic_dbsyncd_wheel",
        "@sonic-dbsyncd//:test_sources",
    ],
    legacy_create_init = False,
    python_version = "3.13",
)

py_binary(
    name = "library_probe",
    testonly = True,
    srcs = ["library_probe.py"],
    legacy_create_init = False,
    python_version = "3.13",
    deps = [
        "@sonic-dbsyncd//:lldp_syncd",
        "@sonic-dbsyncd//:sonic_syncd",
    ],
)

sh_test(
    name = "library_test",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath @sonic_swss_common//tools/bazel/runtime:test_runtime)",
        "-",
        "enabled",
        "$(rootpath :library_probe)",
    ],
    data = [
        ":library_probe",
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
    ],
)
