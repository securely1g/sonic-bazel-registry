# The public Common Python binding supplies its own native library runfiles.
# Staging a second libnl-route alongside them crashes during interpreter exit.
py_test(
    name = "library_test",
    srcs = ["library_probe.py"],
    legacy_create_init = False,
    main = "library_probe.py",
    python_version = "3.13",
    deps = [
        "@sonic-dbsyncd//:lldp_syncd",
        "@sonic-dbsyncd//:sonic_syncd",
    ],
)
