py_test(
    name = "sonic_yang_mgmt_runtime_test",
    srcs = ["sonic_yang_mgmt_runtime_test.py"],
    args = ["$(rootpath @sonic_yang_models//:yang_models)"],
    data = ["@sonic_yang_models//:yang_models"],
    python_version = "3.13",
    visibility = ["//visibility:public"],
    deps = [":sonic_yang_mgmt"],
