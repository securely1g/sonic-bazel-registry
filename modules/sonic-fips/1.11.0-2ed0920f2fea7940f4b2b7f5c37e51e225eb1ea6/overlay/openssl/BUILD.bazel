# Debian rules use hardening=+all future=+lfs. Values were obtained with
# locked dpkg-buildflags (dpkg 1.22.22) for two target architectures; the GCC toolchain
# wrapper supplies the equivalent exec-root file-prefix mapping.
_NATIVE_COPTS = [
    "-g", "-O2", "-pthread", "-Werror=implicit-function-declaration",
    "-fstack-protector-strong", "-fstack-clash-protection", "-Wformat",
    "-Werror=format-security", "-Wdate-time", "-D_FORTIFY_SOURCE=2",
] + select({
    "@platforms//cpu:x86_64": ["-m64", "-Wa,--noexecstack", "-Wall", "-fzero-call-used-regs=used-gpr", "-fcf-protection"],
    "@platforms//cpu:aarch64": ["-Wall", "-mbranch-protection=standard"],
})
exports_files(["source.BUILD.bazel"] + glob(["patches/*.patch"]))

