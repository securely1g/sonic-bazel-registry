[
    genrule(
        name = "demo_compressed_" + source.replace("/", "_"),
        srcs = ["@openssl_src//:" + source],
        outs = ["docs/" + source + ".gz"],
        tools = ["@sonic_build_infra//tools/build_tools:pigz"],
        cmd = '"$(location @sonic_build_infra//tools/build_tools:pigz)" -9 -n -c "$(location @openssl_src//:' + source + ')" > "$@"',
    )
    for source, destination, compress in _DEMO_FILES if compress
]
_DEMO_INPUTS = [":demo_compressed_" + source.replace("/", "_") if compress else "@openssl_src//:" + source for source, destination, compress in _DEMO_FILES]
_DEMO_MTREE = [
    destination + (".gz" if compress else "") + " type=file uid=0 gid=0 mode=0644 content=$(location " + (":demo_compressed_" + source.replace("/", "_") if compress else "@openssl_src//:" + source) + ")"
    for source, destination, compress in _DEMO_FILES
]
tar(
    name = "libssl-doc.runtime",
    srcs = _LIBSSL_MAN_INPUTS + _DEMO_INPUTS + ["@openssl_src//:debian/copyright", ":libssl-doc_changelog_compressed", ":changelog_compressed"],
    mtree = _LIBSSL_MAN_MTREE + _DEMO_MTREE + [
        "usr/share/doc/libssl-doc/copyright type=file uid=0 gid=0 mode=0644 content=$(location @openssl_src//:debian/copyright)",
        "usr/share/doc/libssl-doc/changelog.Debian.gz type=file uid=0 gid=0 mode=0644 content=$(location :libssl-doc_changelog_compressed)",
        "usr/share/doc/libssl-doc/changelog.gz type=file uid=0 gid=0 mode=0644 content=$(location :changelog_compressed)",
    ],
)

strip_static_archive(name = "libcrypto_installed_archive", src = ":libcrypto_archive", out = "installed/libcrypto.a")
strip_static_archive(name = "libssl_installed_archive", src = ":libssl_archive", out = "installed/libssl.a")

