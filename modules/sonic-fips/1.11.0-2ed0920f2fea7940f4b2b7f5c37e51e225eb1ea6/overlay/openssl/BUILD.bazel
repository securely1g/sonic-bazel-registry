[
    genrule(
        name = "manual_" + section + "_" + name,
        srcs = [pod],
        outs = ["manuals/" + name + "." + section + "ssl.gz"],
        tools = ["@sonic_build_infra//tools/build_tools:perl", "@sonic_build_infra//tools/build_tools:pigz"],
        cmd = "SOURCE_DATE_EPOCH=1787585182 \"$(location @sonic_build_infra//tools/build_tools:perl)\" -MPod::Man -e 'Pod::Man->new(name => $$ARGV[2], section => $$ARGV[3], center => \"OpenSSL\", date => \"2026-06-09\", release => \"3.5.7\")->parse_from_file($$ARGV[0], $$ARGV[1]);' \"$(location " + pod + ")\" \"$@.tmp\" " + name.upper() + " " + section + "SSL" + "; \"$(location @sonic_build_infra//tools/build_tools:pigz)\" -9 -n -c \"$@.tmp\" > \"$@\"; rm \"$@.tmp\"",
    )
    for pod, section, name, aliases in _MANUALS
]
_OPENSSL_MAN_INPUTS = [":manual_" + section + "_" + name for pod, section, name, aliases in _MANUALS if section != "3"]
_LIBSSL_MAN_INPUTS = [":manual_" + section + "_" + name for pod, section, name, aliases in _MANUALS if section == "3"]
_OPENSSL_MAN_MTREE = [
    "usr/share/man/man" + section + "/" + name + "." + section + "ssl.gz type=file uid=0 gid=0 mode=0644 content=$(location :manual_" + section + "_" + name + ")"
    for pod, section, name, aliases in _MANUALS if section != "3"
] + [
    "usr/share/man/man" + section + "/" + alias + "." + section + "ssl.gz type=link uid=0 gid=0 link=" + name + "." + section + "ssl.gz"
    for pod, section, name, aliases in _MANUALS if section != "3" for alias in aliases
]
_LIBSSL_MAN_MTREE = [
    "usr/share/man/man3/" + name + ".3ssl.gz type=file uid=0 gid=0 mode=0644 content=$(location :manual_3_" + name + ")"
    for pod, section, name, aliases in _MANUALS if section == "3"
] + [
    "usr/share/man/man3/" + alias + ".3ssl.gz type=link uid=0 gid=0 link=" + name + ".3ssl.gz"
    for pod, section, name, aliases in _MANUALS if section == "3" for alias in aliases
]

