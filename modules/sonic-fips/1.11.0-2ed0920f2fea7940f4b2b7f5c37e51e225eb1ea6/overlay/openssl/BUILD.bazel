# Preserve Debian dh_perl -d through its existing substvars input.
# An absent dependency from Essential perl-base is represented explicitly empty.
genrule(name = "openssl_perl_substvars", srcs = [":openssl.runtime", "@openssl_src//:debian/control", "@openssl_src//:debian/changelog"], outs = ["openssl.perl.substvars"], tools = ["@sonic_build_infra//tools/build_tools:kernel_runtime"], cmd = "stage=\"$(@D)/openssl-perl-substvars.stage\"; tools=\"$$PWD/$(execpath @sonic_build_infra//tools/build_tools:kernel_runtime)\"; \"$$tools/bin/mkdir\" -p \"$$stage/debian/openssl\"; \"$$tools/bin/cp\" \"$(location @openssl_src//:debian/control)\" \"$$stage/debian/control\"; \"$$tools/bin/cp\" \"$(location @openssl_src//:debian/changelog)\" \"$$stage/debian/changelog\"; \"$$tools/bin/tar\" --no-same-owner -xf \"$(location :openssl.runtime)\" -C \"$$stage/debian/openssl\"; (cd \"$$stage\"; \"$$tools/bin/dh_perl\" -popenssl -d); if [ -f \"$$stage/debian/openssl.substvars\" ]; then \"$$tools/bin/cat\" \"$$stage/debian/openssl.substvars\" > \"$@\"; else : > \"$@\"; fi; if ! \"$$tools/bin/grep\" -q \"^perl:Depends=\" \"$@\"; then printf \"perl:Depends=\\n\" >> \"$@\"; fi; \"$$tools/bin/rm\" -rf \"$$stage\"")
