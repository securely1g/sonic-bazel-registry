# Original Makefile.pre.in:2016-2021: real dtrace header, then original sed.
# SystemTap's -h path without -C does not invoke a compiler.
genrule(
    name = "pydtrace_raw_header",
    srcs = ["@cpython_src//:Include/pydtrace.d"],
    outs = ["dtrace-raw/pydtrace_probes.h"],
    tools = ["@sonic_build_infra//tools/build_tools:dtrace"],
    cmd = "$(location @sonic_build_infra//tools/build_tools:dtrace) -h -s $(location @cpython_src//:Include/pydtrace.d) -o $@",
)
genrule(
    name = "pydtrace_probes_header",
    srcs = [":pydtrace_raw_header"],
    outs = ["dtrace/pydtrace_probes.h"],
    tools = ["@sonic_build_infra//tools/build_tools:kernel_runtime"],
    cmd = "$(location @sonic_build_infra//tools/build_tools:kernel_runtime)/bin/sed 's/PYTHON_/PyDTrace_/' $< >$@",
)

expand_template(
    name = "static_header",
    template = "@cpython_src//:pyconfig.h.in",
    out = "static/pyconfig.h",
    substitutions = select({"@platforms//cpu:x86_64": CORE_DEFINES, "@platforms//cpu:aarch64": CORE_DEFINES | ARM_CORE_OVERRIDES}),
)
cc_library(
    name = "configuration_static",
    deps = [":pydtrace_headers"],
    hdrs = [":static_header"],
    strip_include_prefix = "static",
)

expand_template(
    name = "shared_header",
    template = "@cpython_src//:pyconfig.h.in",
    out = "shared/pyconfig.h",
    substitutions = select({"@platforms//cpu:x86_64": CORE_DEFINES | {"#undef Py_ENABLE_SHARED\n": "#define Py_ENABLE_SHARED 1\n"}, "@platforms//cpu:aarch64": CORE_DEFINES | ARM_CORE_OVERRIDES | {"#undef Py_ENABLE_SHARED\n": "#define Py_ENABLE_SHARED 1\n"}}),
)
cc_library(
    name = "configuration_shared",
    deps = [":pydtrace_headers"],
    hdrs = [":shared_header"],
    strip_include_prefix = "shared",
)

alias(name = "python3.13", actual = "@cpython_src//:python3.13")
alias(name = "libpython_shared", actual = "@cpython_src//:libpython_shared")
alias(name = "extensions_native", actual = "@cpython_src//:extensions_native")
alias(name = "_testembed", actual = "@cpython_src//:_testembed")
source_build_tool(name = "native_python_tool", binary = "@cpython_src//:python_shared_for_metadata")
expand_template(
    name = "installed_makefile",
    template = "@cpython_src//:Makefile.pre.in",
    out = "installed/Makefile",
    substitutions = select({"@platforms//cpu:x86_64": INSTALLED_CONFIGURATION, "@platforms//cpu:aarch64": INSTALLED_CONFIGURATION | ARM_INSTALLED_OVERRIDES}),
)
genrule(
    name = "sysconfig_data",
    srcs = ["generate_sysconfig.py", ":installed_makefile", ":shared_header", "@cpython_src//:stdlib_sources", "@cpython_src//:Lib/os.py"],
    outs = ["installed/sysconfigdata.py"],
    tools = [":native_python_tool"],
    cmd = "libfile=$(location @cpython_src//:Lib/os.py); PYTHONPATH=$${libfile%/os.py} $(location :native_python_tool) -B -S $(location generate_sysconfig.py) $(location :installed_makefile) $(location :shared_header) $@ $${libfile%/os.py}",
)
