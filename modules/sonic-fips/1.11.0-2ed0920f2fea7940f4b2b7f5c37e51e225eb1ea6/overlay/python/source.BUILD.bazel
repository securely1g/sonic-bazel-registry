    name = "core_shared_sysmodule",
    srcs = ["Python/sysmodule.c"] + glob(["Parser/**/*.h", "Python/**/*.h", "Modules/**/*.h", "Objects/**/*.h"]),
    textual_hdrs = glob(["Objects/mimalloc/**/*.c"]) + ["Objects/typeslots.inc"],
    copts = ["-std=c11", "-O3", "-g", "-fwrapv", "-fno-strict-overflow", "-fno-strict-aliasing", "-fvisibility=hidden", "-flto", "-fuse-linker-plugin", "-ffat-lto-objects"] + ORIGINAL_RECIPE_COPTS,
    local_defines = ["ABIFLAGS='\"\"'", "Py_BUILD_CORE", "Py_BUILD_CORE_BUILTIN", "DATE='\"Jun 26 2025\"'", "TIME='\"18:55:22\"'", "PLATFORM='\"linux\"'", ] + select({
        ":amd64": ["MULTIARCH='\"x86_64-linux-gnu\"'", "SOABI='\"cpython-313-x86_64-linux-gnu\"'"],
