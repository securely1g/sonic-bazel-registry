cc_library(
    name = "headers_static",
    hdrs = glob(["Include/**/*.h"]),
    defines = ["NDEBUG"],
    includes = [".", "Include", "Include/internal", "Include/internal/mimalloc"],
    deps = ["@sonic_fips//python:configuration_static"],
)
# The trampoline uses only compiler predefined architecture/CET macros.  Keep
# its implicit stdc-predef.h dependency out of the assembly action; allocated
# text, CET notes and relocations match the original GCC14 assembly exactly.
cc_library(
    name = "asm_trampoline",
    srcs = ["Python/asm_trampoline.S"],
    copts = ["-O3", "-g", "-flto", "-ffat-lto-objects", "-ffreestanding"],
    alwayslink = True,
    linkstatic = True,
)


cc_library(
    name = "headers_shared",
    hdrs = glob(["Include/**/*.h"]),
    defines = ["NDEBUG"],
    includes = [".", "Include", "Include/internal", "Include/internal/mimalloc"],
    deps = ["@sonic_fips//python:configuration_shared"],
)
