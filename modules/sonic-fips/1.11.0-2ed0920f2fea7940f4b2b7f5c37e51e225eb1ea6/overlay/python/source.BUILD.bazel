# This common input is consumed by the static interpreter and shared ABI library.
# Actual original dpkg flags: original no-pie specs are represented by the
# existing per-variant -fno-PIE/-no-pie and shared/HACL -fPIC choices.
ORIGINAL_RECIPE_COPTS = ['-Wdate-time', '-D_FORTIFY_SOURCE=2', '-g', '-Werror=implicit-function-declaration', '-fstack-protector', '-fstack-clash-protection', '-Wformat', '-Werror=format-security'] + select({":amd64": ["-fcf-protection"], ":arm64": ["-mbranch-protection=standard"]}) + ['-g', '-fwrapv', '-O3', '-flto', '-fuse-linker-plugin', '-ffat-lto-objects', '-Wall', '-std=c11', '-fvisibility=hidden'] + ["-ffile-prefix-map=" + CPYTHON_SOURCE_ROOT + "=."]
ORIGINAL_RECIPE_LINKOPTS = ['-Wl,-z,relro', '-g', '-fwrapv', '-O3', '-flto', '-fuse-linker-plugin', '-ffat-lto-objects', '-Wl,-z,lazy']

PGO_GENERATE = "@$(location @sonic_fips//python:generate_flags)"
PGO_BASE_COPTS = ["-std=c11", "-O3", "-g", "-fwrapv", "-fno-strict-overflow", "-fno-strict-aliasing", "-fvisibility=hidden", "-flto", "-fuse-linker-plugin", "-ffat-lto-objects"] + ORIGINAL_RECIPE_COPTS

