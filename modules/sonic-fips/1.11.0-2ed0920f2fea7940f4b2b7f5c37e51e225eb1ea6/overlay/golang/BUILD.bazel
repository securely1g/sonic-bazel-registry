package(default_visibility = ["//visibility:public"])
exports_files(["fips.series", "patches.BUILD.bazel", "source.BUILD.bazel", "0001-debian-sdk-defaults.patch", "derive_perl_substvars.py"])
expand_template(
    name = "changelog",
    template = "@golang_src//:debian/changelog",
    out = "changelog.fips",
    substitutions = {"1.26.5-1~bpo13+1": "1.26.5-1~bpo13+1+fips"},
)
genrule(
    name = "changelog_compressed",
    srcs = [":changelog"],
    outs = ["changelog.gz"],
    tools = ["@sonic_build_infra//tools/build_tools:pigz"],
    cmd = "$(location @sonic_build_infra//tools/build_tools:pigz) -n -c $(location :changelog) >$@",
)

alias(name = "golang-1.26-src.runtime", actual = "@golang_src//:golang-1.26-src.runtime")
runtime_packages(
    name = "golang-1.26-src.runtime_metadata",
    control = "@golang_src//:debian/control",
    changelog = ":changelog",
    module_name = "sonic-fips",
    packages = {"golang-1.26-src": ":golang-1.26-src.runtime"},
    # Original Debian dh_makeshlibs/dh_shlibdeps both exclude testdata and test.
    symbols_excludes = {"golang-1.26-src": ["testdata", "test"]},
    shlibdeps_excludes = {"golang-1.26-src": ["testdata", "test"]},
    package_roles = {"golang-1.26-src": "source"},
)

alias(name = "golang-1.26-doc.runtime", actual = "@golang_src//:golang-1.26-doc.runtime")
runtime_packages(
    name = "golang-1.26-doc.runtime_metadata",
    control = "@golang_src//:debian/control",
    changelog = ":changelog",
    module_name = "sonic-fips",
    packages = {"golang-1.26-doc": ":golang-1.26-doc.runtime"},
)

alias(name = "golang-1.26.runtime", actual = "@golang_src//:golang-1.26.runtime")
runtime_packages(
    name = "golang-1.26.runtime_metadata",
    control = "@golang_src//:debian/control",
    changelog = ":changelog",
    module_name = "sonic-fips",
    packages = {"golang-1.26": ":golang-1.26.runtime"},
)

