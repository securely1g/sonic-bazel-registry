# debian/rules GENERATED_FILES belong to the compiler package, not -src.
# Archive paths retain upstream Unicode and ! test names. ASCII artifact
# paths avoid Bazel's shell quoting in mtree's content= field.
ARCHIVE_CONTENT = {
    'src/cmd/go/testdata/mod/rsc.io_!c!g!o_v1.0.0.txt': ":escaped_mod0",
    'src/cmd/go/testdata/mod/rsc.io_!q!u!o!t!e_v1.5.2.txt': ":escaped_mod1",
    'src/cmd/go/testdata/mod/rsc.io_!q!u!o!t!e_v1.5.3-!p!r!e.txt': ":escaped_mod2",
    "test/fixedbugs/issue27836.dir/Þfoo.go": ":unicode_foo",
    "test/fixedbugs/issue27836.dir/Þmain.go": ":unicode_main",
}
copy_file(name = "unicode_foo", src = "test/fixedbugs/issue27836.dir/Þfoo.go", out = "archive_inputs/unicode_foo.go", allow_symlink = True)
copy_file(name = "unicode_main", src = "test/fixedbugs/issue27836.dir/Þmain.go", out = "archive_inputs/unicode_main.go", allow_symlink = True)
copy_file(name = "escaped_mod0", src = 'src/cmd/go/testdata/mod/rsc.io_!c!g!o_v1.0.0.txt', out = "archive_inputs/mod0.txt", allow_symlink = True)
copy_file(name = "escaped_mod1", src = 'src/cmd/go/testdata/mod/rsc.io_!q!u!o!t!e_v1.5.2.txt', out = "archive_inputs/mod1.txt", allow_symlink = True)
copy_file(name = "escaped_mod2", src = 'src/cmd/go/testdata/mod/rsc.io_!q!u!o!t!e_v1.5.3-!p!r!e.txt', out = "archive_inputs/mod2.txt", allow_symlink = True)
SOURCE_FILES = glob(
    ["api/**", "lib/**", "misc/**", "src/**", "test/**"],
    exclude = [
        "src/**/*.rc",
        "src/cmd/go/internal/cfg/zdefaultcc.go",
