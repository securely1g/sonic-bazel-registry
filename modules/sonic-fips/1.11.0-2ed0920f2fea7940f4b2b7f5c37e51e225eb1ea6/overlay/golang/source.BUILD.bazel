EXECUTABLE_SOURCES = ['lib/time/update.bash', 'lib/wasm/go_js_wasm_exec', 'lib/wasm/go_wasip1_wasm_exec', 'misc/ios/clangwrap.sh', 'src/all.bash', 'src/all.rc', 'src/bootstrap.bash', 'src/buildall.bash', 'src/clean.bash', 'src/clean.rc', 'src/cmd/compile/internal/ssa/_gen/cover.bash', 'src/crypto/internal/boring/build-boring.sh', 'src/crypto/internal/boring/build-goboring.sh', 'src/crypto/internal/boring/build.sh', 'src/debug/dwarf/testdata/issue57046-clang.elf5', 'src/debug/dwarf/testdata/ranges.elf', 'src/debug/dwarf/testdata/rnglistx.elf', 'src/debug/dwarf/testdata/typedef.elf', 'src/go/doc/comment/mkstd.sh', 'src/make.bash', 'src/make.rc', 'src/os/testdata/dirfs/dir/x', 'src/race.bash', 'src/regexp/syntax/make_perl_groups.pl', 'src/run.bash', 'src/run.rc', 'src/runtime/pprof/testdata/test32', 'src/runtime/pprof/testdata/test32be', 'src/runtime/pprof/testdata/test64', 'src/runtime/pprof/testdata/test64be', 'src/runtime/race/mkcgo.sh', 'src/simd/archsimd/_gen/simdgen/etetest.sh', 'src/syscall/mkall.sh', 'src/syscall/mkerrors.sh', 'src/syscall/mksyscall.pl', 'src/syscall/mksyscall_libc.pl', 'src/syscall/mksysctl_openbsd.pl', 'src/syscall/mksysnum_dragonfly.pl', 'src/syscall/mksysnum_freebsd.pl', 'src/syscall/mksysnum_linux.pl', 'src/syscall/mksysnum_netbsd.pl', 'src/syscall/mksysnum_openbsd.pl', 'src/syscall/mksysnum_plan9.sh']

tar(
    name = "golang-1.26-src.runtime",
    srcs = SOURCE_FILES + ARCHIVE_CONTENT.values() + ["debian/copyright", "@sonic_fips//golang:changelog.gz"],
    mtree = [
        "./usr/share/go-1.26/{} type=file uid=0 gid=0 mode={} time=0 content=$(location {})".format(
            source.replace("Þ", "\\303\\236"),
            "0755" if source.endswith(".sh") or source.endswith(".bash") or source in EXECUTABLE_SOURCES else "0644",
            ARCHIVE_CONTENT.get(source, source),
        )
        for source in SOURCE_FILES
    ] + [
        "./usr/share/doc/golang-1.26-src/copyright type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/copyright)",
        "./usr/share/doc/golang-1.26-src/changelog.Debian.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location @sonic_fips//golang:changelog.gz)",
    ],
)

DOC_FILES = glob(["doc/**"])
tar(
    name = "golang-1.26-doc.runtime",
    srcs = DOC_FILES + ["debian/copyright", "@sonic_fips//golang:changelog.gz"],
    mtree = [
        "./usr/share/doc/golang-1.26-doc/html/{} type=file uid=0 gid=0 mode=0644 time=0 content=$(location {})".format(source[4:], source)
        for source in DOC_FILES
    ] + [
        "./usr/lib/go-1.26/doc type=link uid=0 gid=0 mode=0777 time=0 link=../../share/doc/golang-1.26-doc/html",
        "./usr/share/doc/golang-1.26-doc/copyright type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/copyright)",
        "./usr/share/doc/golang-1.26-doc/changelog.Debian.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location @sonic_fips//golang:changelog.gz)",
    ],
)

