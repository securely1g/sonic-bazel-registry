module(name = "wpa_registry_consumer")

bazel_dep(name = "sonic-wpa-supplicant", version = "2.9.0.sonic.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.26-51c838da6ff57295fde6e0bc3807841cb31a8568", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-43598143ef4a46431eae0859915cd7d951dad1ed", repo_name = "sonic_swss_common")

# Select the same accepted native closure as the MACsec image. These exact
# candidate versions replace older unpublished requests; source archives and
# all production target definitions remain owned by their registered modules.
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.16")
bazel_dep(name = "sonic-fips", version = "0.0.3-e910ec2217bc42aae8a185a398b23a329f482fef", repo_name = "sonic_fips")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# This consumer selects the C++ interface, with no Rust artifacts of its own.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])
