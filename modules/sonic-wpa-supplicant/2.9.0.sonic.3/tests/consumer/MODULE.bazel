module(name = "wpa_registry_consumer")

bazel_dep(name = "sonic-wpa-supplicant", version = "2.9.0.sonic.3")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")

# Match the owner's published dependency selection without copying producers
# or introducing additional review-only module candidates.
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "sonic-fips", version = "1.11.0-2ed0920f2fea7940f4b2b7f5c37e51e225eb1ea6", repo_name = "sonic_fips")
bazel_dep(name = "libnl3", version = "3.7.0.sonic.10")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")
register_toolchains("@sonic_build_infra//tools/gzip:toolchain")
register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
)

# A dependency's development toolchain declarations do not propagate to this
# independent root. Preserve the owner's Rust selection for Common's interface.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(edition = "2021", versions = ["1.90.0"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
