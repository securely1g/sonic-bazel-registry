module(name = "sonic-dhcp-relay", version = "0.1.0-4a224dccc2b3b55f1140dd5072008f8f8079695c", bazel_compatibility = [">=8.5.1", "<=8.5.1"])
bazel_dep(name = "sonic-build-infra", version = "0.0.26-51c838da6ff57295fde6e0bc3807841cb31a8568", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.9-334389eae54afd1f4f5ee69f89c3a7ad2062ee61", repo_name = "sonic_swss_common")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.16")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1", repo_name = "com_google_googletest")
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")
register_toolchains("@gcc_toolchains//:all")
# Extends the shared dated Debian snapshots, never the host's apt sources.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "trixie",
    packages = ['libasan8 (= 14.2.0-19) [amd64]', 'libasan8 (= 14.2.0-19) [arm64]', 'libevent-dev (= 2.1.12-stable-10+b1) [amd64]', 'libevent-dev (= 2.1.12-stable-10+b1) [arm64]', 'libboost-thread-dev (= 1.83.0.2+b2) [amd64]', 'libboost-thread-dev (= 1.83.0.2+b2) [arm64]', 'libboost-system-dev (= 1.83.0.2+b2) [amd64]', 'libboost-system-dev (= 1.83.0.2+b2) [arm64]', 'redis-server (= 5:8.0.2-3+deb13u2) [amd64]', 'redis-server (= 5:8.0.2-3+deb13u2) [arm64]', 'python3 (= 3.13.5-1) [amd64]', 'python3 (= 3.13.5-1) [arm64]'],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "trixie")
# Root-only compatibility selections required by the existing owner modules.
# Stable 0.10.5 otherwise sorts above the patched tar prerelease.
single_version_override(module_name = "tar.bzl", version = "0.10.5-sonic.1")
# Later rules_cc requires a Bazel runtime toolchain unavailable in 8.5.1.
single_version_override(module_name = "rules_cc", version = "0.2.20")
# Common registers Rust consumers; its non-root dev toolchains are not inherited.
bazel_dep(name = "rules_rs", version = "0.1.0")
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(edition = "2021", versions = ["1.90.0"], extra_target_triples = ["aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all", dev_dependency = True)


# Existing source module used by installed-runtime validation.
bazel_dep(name = "libyang", version = "3.12.2.sonic.6")

# apt.lock.json is the canonical reviewed acceptance contract, not an input
# consumed by the facts-mode resolver. validate-apt-lock.py forces fresh
# resolution before comparing (see README.bazel.md).

# PcapPlusPlus has no upstream/BCR Bazel target (inspection in migration evidence).
# Reuse upstream CMake through rules_foreign_cc, and canonical BCR libpcap.
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "libpcap", version = "1.10.5.bcr.4")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
# Same immutable source as the existing gitlink, also available in source archives.
http_archive(
    name = "gmock_global_headers",
    urls = ["https://codeload.github.com/apriorit/gmock-global/tar.gz/6552faa2a94250ed0192dbd62e608d37fafcc216"],
    type = "tar.gz",
    sha256 = "29c753ae56de70e1f558c5f1ef8c16014f27bcf899acb0c41713eb31806e9a81",
    strip_prefix = "gmock-global-6552faa2a94250ed0192dbd62e608d37fafcc216",
    build_file = "//third_party:gmock-global.BUILD.bazel",
)
http_archive(
    name = "pcapplusplus",
    type = "tar.gz",
    urls = ["https://codeload.github.com/seladb/PcapPlusPlus/tar.gz/refs/tags/v24.09"],
    sha256 = "b14998ecf5718c2bfb6f709060e53f7ef67639b98bf2222a3cd23d820d70acdc",
    strip_prefix = "PcapPlusPlus-24.09",
    patches = ["//dhcp4relay/patch:0001-dhcpv4-relay-accept-random-src-port.patch"],
    patch_args = ["-p1"],
    build_file = "//third_party:pcapplusplus.BUILD.bazel",
)

bazel_dep(name = "rules_shell", version = "0.8.0")


apt.import_lock(lock = "//bazel_metadata:apt.lock.json")
use_repo(apt, "relay_metadata_debian")

# Execution-tool gnulib wrappers must precede system headers. These root-only
# BCR source patches do not change runtime sources or compiler selection.
single_version_override(module_name = "m4", version = "1.4.21.bcr.8", patches = ["//third_party/patches:m4-wrapper-headers.patch"], patch_strip = 1)
single_version_override(module_name = "bison", version = "3.8.2.bcr.13", patches = ["//third_party/patches:bison-wrapper-headers.patch"], patch_strip = 1)
single_version_override(module_name = "flex", version = "2.6.4.bcr.10", patches = ["//third_party/patches:flex-wrapper-headers.patch"], patch_strip = 1)
