module(
    name = "hsflowd",
    version = "2.1.26.sonic.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "pigz", version = "2.8.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "toolchain_utils", version = "1.0.2")
bazel_dep(name = "sonic-build-infra", version = "0.0.25-17a1e555291c64be1a6ff008f33352bffc4f8e5c", repo_name = "sonic_build_infra")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# Reuse the shared immutable Trixie snapshot for this external dependency.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "hsflowd_deps",
    packages = [
        "libhiredis-dev",
        "libhiredis1.1.0",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "hsflowd_deps")

# The private integration service reuses the shared execution-package set.
# These inputs are test-only; they are not installed in the hsflowd payload.
apt.install(
    dependency_set = "build_tools",
    packages = [
        "redis-server",
        "redis-tools",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "build_tools")

register_toolchains("//:gzip_toolchain")
