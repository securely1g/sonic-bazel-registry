From: Guohan Lu <lguohan@gmail.com>
Subject: [PATCH] Give the registered sonic-platform-common source its commit-qualified identity

The registry selects the merged owner revision by its full Git commit.
Preserve the owner's build rules and dependencies.

Source commit: 2b84e6a2b24f8e1c937b68140e806a13db302384

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,6 +1,6 @@
 module(
     name = "sonic-platform-common",
-    version = "1.0.1",
+    version = "1.0.1-2b84e6a2b24f8e1c937b68140e806a13db302384",
     bazel_compatibility = [
         ">=8.5.1",
         "<=8.5.1",
