load("@rules_python//python:defs.bzl", "py_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
"""Current Debian native source and the four SONiC patches, directly installed."""
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@tar.bzl", "tar")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
load("@sonic_build_infra//deb:changelogs.bzl", "debian_changelogs")
load("@sonic_build_infra//oci:source_controls.bzl", "source_package_controls")
package(default_visibility = ["//visibility:public"])
exports_files(["MODULE.bazel"] + glob(["debian/**"]))
_CMDLINE = select({"@platforms//cpu:aarch64": {"@KDUMP_CMDLINE_APPEND@": "reset_devices systemd.unit=kdump-tools-dump.service nr_cpus=1"}, "//conditions:default": {"@KDUMP_CMDLINE_APPEND@": "reset_devices systemd.unit=kdump-tools-dump.service nr_cpus=1 irqpoll usbcore.nousb"}})
expand_template(name = 'kdump_config', template = 'debian/kdump-config.in', out = "generated/kdump_config", substitutions = _CMDLINE)
