runtime_packages(name = "kdump-tools.runtime_metadata", debian_files = {"kdump-tools." + name: "debian/kdump-tools." + name for name in ["preinst", "postinst", "postrm", "config", "templates", "init", "service", "kdump-tools-dump.service", "udev"]} | {"kdump-tools.maintscript": "debian/kdump-tools.maintscript.default"} | {path[len("debian/"):]: path for path in glob(["debian/po/**"])}, control_file_helpers = [["dh_installinit"], ["dh_installsystemd", "kdump-tools.service"], ["dh_installsystemd", "--name=kdump-tools-dump", "--no-enable", "kdump-tools-dump.service"], ["dh_installudev", "--priority=50"], ["dh_installinitramfs"], ["dh_installdeb"]], substvars = {"kdump-tools": ":substvars"}, packages = {"kdump-tools": ":kdump-tools.runtime"}, control = "debian/control", changelog = "debian/changelog", required_paths = {"kdump-tools": ["usr/sbin/kdump-config", "etc/kernel/postinst.d/kdump-tools"]})

_SHELLCHECK_INPUTS = glob(["debian/*", "debian/tests/*"])
py_test(name = "shellcheck", srcs = ["bazel/run_shellcheck.py"], main = "bazel/run_shellcheck.py", python_version = "3.13", args = ["$(rootpath @sonic_build_infra//tools/build_tools:shellcheck)"] + ["$(rootpath " + path + ")" for path in _SHELLCHECK_INPUTS], data = _SHELLCHECK_INPUTS + ["@sonic_build_infra//tools/build_tools:shellcheck"])

# Compatibility for existing buildimage consumers; canonical metadata is above.
alias(name = "runtime_packages.json", actual = ":kdump-tools.runtime_metadata")

source_package_controls(
    name = "test_control",
    metadata = ":kdump-tools.runtime_metadata",
    package = "kdump-tools",
    testonly = True,
    visibility = ["//visibility:private"],
)
py_test(
    name = "installation_test",
    srcs = ["bazel/installation_test.py"],
    main = "bazel/installation_test.py",
    python_version = "3.13",
    args = [
        "--archive", "$(rootpath :kdump-tools.runtime)",
        "--metadata", "$(rootpath :kdump-tools.runtime_metadata)",
        "--control", "$(rootpath :test_control)",
        "--source-control", "$(rootpath debian/control)",
    ],
    data = [":kdump-tools.runtime", ":kdump-tools.runtime_metadata", ":test_control"] + glob(["debian/**"]),
