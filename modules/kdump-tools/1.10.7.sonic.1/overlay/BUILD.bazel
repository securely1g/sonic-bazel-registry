    control = "debian/control",
    changelog = "debian/changelog",
    package = "kdump-tools",
    architecture = select({"@platforms//cpu:aarch64": "arm64", "//conditions:default": "amd64"}),
    outs = ["installed-docs/changelog"],
)
genrule(name = 'changelog', srcs = [':installed_changelog'], outs = ["changelog.gz"], tools = ["@sonic_build_infra//tools/build_tools:pigz"], cmd = "$(execpath @sonic_build_infra//tools/build_tools:pigz) -n -9 -c $< > $@")
genrule(name = 'man8', srcs = ['debian/kdump-config.8'], outs = ["man8.gz"], tools = ["@sonic_build_infra//tools/build_tools:pigz"], cmd = "$(execpath @sonic_build_infra//tools/build_tools:pigz) -n -9 -c $< > $@")
genrule(name = 'man5gz', srcs = [':man5'], outs = ["man5gz.gz"], tools = ["@sonic_build_infra//tools/build_tools:pigz"], cmd = "$(execpath @sonic_build_infra//tools/build_tools:pigz) -n -9 -c $< > $@")
tar(name = "kdump-tools.runtime", srcs = [':changelog', ':default_config', ':kdump_config', ':man5gz', ':man8', 'debian/copyright', 'debian/initramfs.hook', 'debian/initramfs.local-bottom', 'debian/kdump-tools.README.Debian', 'debian/kdump-tools.grub.default', 'debian/kdump-tools.init', 'debian/kdump-tools.kdump-tools-dump.service', 'debian/kdump-tools.service', 'debian/kdump-tools.udev', 'debian/kdump_mem_estimator', 'debian/kernel-postinst-generate-initrd', 'debian/kernel-postrm-delete-initrd', 'debian/sysctl.conf'], mtree = ['usr/sbin/kdump-config type=file uid=0 gid=0 mode=0755 time=0 content=$(location :kdump_config)', 'usr/share/kdump-tools/kdump-tools.conf type=file uid=0 gid=0 mode=0644 time=0 content=$(location :default_config)', 'usr/share/kdump-tools/kdump_mem_estimator type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/kdump_mem_estimator)', 'etc/kdump/sysctl.conf type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/sysctl.conf)', 'etc/kernel/postinst.d/kdump-tools type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/kernel-postinst-generate-initrd)', 'etc/kernel/postrm.d/kdump-tools type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/kernel-postrm-delete-initrd)', 'etc/default/grub.d/kdump-tools.cfg type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/kdump-tools.grub.default)', 'etc/init.d/kdump-tools type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/kdump-tools.init)', 'usr/lib/systemd/system/kdump-tools.service type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/kdump-tools.service)', 'usr/lib/systemd/system/kdump-tools-dump.service type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/kdump-tools.kdump-tools-dump.service)', 'usr/lib/udev/rules.d/50-kdump-tools.rules type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/kdump-tools.udev)', 'usr/share/initramfs-tools/hooks/kdump-tools type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/initramfs.hook)', 'usr/share/initramfs-tools/scripts/local-bottom/kdump-sysctl type=file uid=0 gid=0 mode=0755 time=0 content=$(location debian/initramfs.local-bottom)', 'usr/share/doc/kdump-tools/README.Debian type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/kdump-tools.README.Debian)', 'usr/share/doc/kdump-tools/copyright type=file uid=0 gid=0 mode=0644 time=0 content=$(location debian/copyright)', 'usr/share/doc/kdump-tools/changelog.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :changelog)', 'usr/share/man/man8/kdump-config.8.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :man8)', 'usr/share/man/man5/kdump-tools.5.gz type=file uid=0 gid=0 mode=0644 time=0 content=$(location :man5gz)', 'var/lib/kdump type=dir uid=0 gid=0 mode=0755 time=0'])
