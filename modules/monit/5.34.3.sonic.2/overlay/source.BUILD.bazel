# Current Debian hardening/LTO flags and controlled configure additions.
COPTS = [
    "-DHAVE_CONFIG_H",
    "-g",
    "-O2",
    "-flto=auto",
    "-ffat-lto-objects",
    "-fstack-protector-strong",
    "-fstack-clash-protection",
    "-fcf-protection",
    "-Wformat",
    "-Werror=format-security",
    "-Wdate-time",
    "-U_FORTIFY_SOURCE",
    "-D_FORTIFY_SOURCE=2",
    "-Wextra",
    "-fstack-protector-all",
    "-D_GNU_SOURCE",
    "-Wall",
    "-Wunused",
    "-std=c11",
    "-D_REENTRANT",
]

LIBMONIT_INCLUDES = [
    "libmonit/src",
    "libmonit/src/exceptions",
    "libmonit/src/io",
    "libmonit/src/net",
    "libmonit/src/util",
    "libmonit/src/thread",
]

MONIT_INCLUDES = [
    "src",
    "src/device",
    "src/http",
    "src/notification",
    "src/process",
    "src/protocols",
    "src/ssl",
    "src/terminal",
    "libmonit/src",
]

cc_library(
    name = "libmonit",
    srcs = LIBMONIT_SOURCES,
    hdrs = glob([
        "libmonit/src/**/*.h",
        "libmonit/src/**/*.inc",
    ]),
    copts = COPTS + private_includes(LIBMONIT_INCLUDES),
    features = ["-opt"],
    includes = LIBMONIT_INCLUDES,
    deps = [
        "@monit//:config_headers",
        "@monit_build_debian//zlib1g-dev:libz_cc",
    ],
)

cc_library(
    name = "monit_headers",
    hdrs = glob([
        "src/**/*.h",
        "src/**/*.inc",
    ]),
    includes = MONIT_INCLUDES,
    deps = ["@monit//:config_headers"],
)

cc_binary(
    name = "monit",
    srcs = MONIT_SOURCES + [
        # keep
        "@monit//:parser",
        "@monit//:lexer",
    ],
    copts = COPTS + private_includes(MONIT_INCLUDES) + [
        "-DLINUX",
        '-DSYSCONFDIR=\\"/etc/monit\\"',
    ],
    features = [
        "-opt",
        "-strip_debug_symbols",
        "sonic_as_needed",
    ],
    linkopts = [
        "-g",
        "-flto=auto",
        "-Wl,-z,relro",
        "-Wl,-z,now",
        "-rdynamic",
        "-lm",
        "-pthread",
        "-lresolv",
        "-lrt",
    ],
    linkstatic = False,
    deps = [
        # keep
        ":libmonit",
        ":monit_headers",
        "@monit_build_debian//libpam0g-dev:libpam_cc",
        "@monit_build_debian//libssl-dev:libssl_cc",
        "@monit_build_debian//libssl-dev:libcrypto_cc",
        "@monit_build_debian//libcrypt-dev:libcrypt_cc",
    ],
)

[
    cc_binary(
        name = "unittest_" + name,
        srcs = ["libmonit/test/" + name + ".c"],
        copts = COPTS + private_includes(LIBMONIT_INCLUDES),
        features = ["-opt"],
        linkopts = [
            "-g",
            "-flto=auto",
            "-lm",
            "-pthread",
            "-lrt",
        ],
        linkstatic = False,
        deps = [":libmonit"],
    )
    for name in [
        "StrTest",
        "FmtTest",
        "SystemTest",
        "RandomTest",
        "ArrayTest",
        "ListTest",
        "DirTest",
        "StringBufferTest",
        "InputStreamTest",
        "OutputStreamTest",
        "FileTest",
        "ExceptionTest",
        "NetTest",
        "TimeTest",
        "CommandTest",
    ]
]

filegroup(
    name = "original_check_binaries",
    srcs = [":unittest_" + name for name in [
        "StrTest",
        "FmtTest",
        "SystemTest",
        "RandomTest",
        "ArrayTest",
        "ListTest",
        "DirTest",
        "StringBufferTest",
        "InputStreamTest",
        "OutputStreamTest",
        "FileTest",
        "ExceptionTest",
        "NetTest",
        "TimeTest",
        "CommandTest",
    ]],
)
