cc_test(
    name = "libnl3_consumer_test",
    srcs = ["libnl3_consumer_test.c"],
    linkopts = ["-ldl"],
    linkstatic = False,
    visibility = ["//visibility:public"],
    deps = [
        ":libnl_3",
        ":libnl_route_3",
    ],
)

copy_file(
    name = "package_test_script",
    src = "libnl3_package_test.sh",
    out = "libnl3_package_test_runner.sh",
    is_executable = True,
)

sh_test(
    name = "libnl3_package_test",
    srcs = [":package_test_script"],
    args = [
        "$(location libnl3_consumer_test.c)",
        "$(location :libnl-3_pkg)",
        "$(location :libnl-genl-3_pkg)",
        "$(location :libnl-route-3_pkg)",
        "$(location :libnl-nf-3_pkg)",
        "$(location :libnl-cli-3_pkg)",
        "$(location :libnl-3-dev_pkg)",
        "$(location :libnl-genl-3-dev_pkg)",
        "$(location :libnl-route-3-dev_pkg)",
        "$(location :libnl-nf-3-dev_pkg)",
        "$(location :libnl-cli-3-dev_pkg)",
        "$(location :libnl-3_pkg.debug_symbols)",
        "$(location :libnl-genl-3_pkg.debug_symbols)",
        "$(location :libnl-route-3_pkg.debug_symbols)",
        "$(location :libnl-nf-3_pkg.debug_symbols)",
        "$(location :libnl-cli-3_pkg.debug_symbols)",
    ],
    data = [
        "libnl3_consumer_test.c",
        ":libnl-3-dev_pkg",
        ":libnl-3_pkg",
        ":libnl-3_pkg.debug_symbols",
        ":libnl-cli-3-dev_pkg",
        ":libnl-cli-3_pkg",
        ":libnl-cli-3_pkg.debug_symbols",
        ":libnl-genl-3-dev_pkg",
        ":libnl-genl-3_pkg",
        ":libnl-genl-3_pkg.debug_symbols",
        ":libnl-nf-3-dev_pkg",
        ":libnl-nf-3_pkg",
        ":libnl-nf-3_pkg.debug_symbols",
        ":libnl-route-3-dev_pkg",
        ":libnl-route-3_pkg",
        ":libnl-route-3_pkg.debug_symbols",
    ],
    visibility = ["//visibility:public"],
)

