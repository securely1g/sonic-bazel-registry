+        name = path.removesuffix(".c"),
+        srcs = [path],
+        copts = LIBNL_LIBRARY_COPTS,
+        dynamic_deps = [":" + name + "_shared" for name in [
+            "libnl_3",
+            "libnl_genl_3",
+            "libnl_route_3",
+            "libnl_nf_3",
+            "libnl_cli_3",
+            "libnl_idiag_3",
+        ]],
+        linkopts = LIBNL_LINKOPTS + ["-ldl"],
+        visibility = ["//visibility:public"],
+        deps = [
+            ":libnl_cli_3",
+            ":libnl_idiag_3",
+            ":private_headers",
+        ],
+    )
+    for path in glob(["src/*.c"])
+]
+
+filegroup(
+    name = "programs",
+    srcs = [path.removesuffix(".c") for path in glob(["src/*.c"])],
+    visibility = ["//visibility:public"],
+)
+
+# Debian -dev archives contain direct library objects, never transitive libs.
+[
+    direct_linker_inputs(
+        name = name + "_archive_inputs",
+        deps = [":" + name],
+    )
+    for name in [
+        "libnl_genl_3",
+        "libnl_nf_3",
+        "libnl_cli_3",
+        "libnl_idiag_3",
+        "libnl_xfrm_3",
+    ] + [label.removesuffix("_shared").removeprefix(":") for label in CLI_PLUGINS.values()]
+]
+
+[
+    cc_static_library(
+        name = name + "_archive",
+        visibility = ["//visibility:public"],
+        deps = [":" + name + "_archive_inputs"],
+    )
+    for name in [
+        "libnl_genl_3",
+        "libnl_nf_3",
+        "libnl_cli_3",
+        "libnl_idiag_3",
+        "libnl_xfrm_3",
+    ] + [label.removesuffix("_shared").removeprefix(":") for label in CLI_PLUGINS.values()]
+]
+
+
+# Build every unconditional upstream test program.
+[
+    cc_binary(
+        name = path.removesuffix(".c"),
+        srcs = [path],
+        copts = LIBNL_LIBRARY_COPTS,
+        dynamic_deps = [":" + name + "_shared" for name in [
+            "libnl_3",
+            "libnl_genl_3",
+            "libnl_route_3",
+            "libnl_nf_3",
+            "libnl_cli_3",
+        ]],
+        linkopts = LIBNL_LINKOPTS + ["-ldl"],
+        visibility = ["//visibility:public"],
+        deps = [
+            ":libnl_cli_3",
+            ":private_headers",
+        ],
+    )
+    for path in glob(["tests/test-*.c"])
+]
+
+filegroup(
+    name = "check_programs",
+    srcs = [path.removesuffix(".c") for path in glob(["tests/test-*.c"])],
+    visibility = ["//visibility:public"],
+)
+
+exports_files([
+    "ChangeLog",
+])
+
+filegroup(
+    name = "all_libraries",
+    srcs = [":" + name + "_shared" for name in [
+        "libnl_3",
+        "libnl_genl_3",
+        "libnl_route_3",
+        "libnl_nf_3",
+        "libnl_cli_3",
+        "libnl_idiag_3",
+        "libnl_xfrm_3",
+    ]] + [
+        ":core_archive",
+        ":route_archive",
+    ] + [":" + name + "_archive" for name in [
+        "libnl_genl_3",
+        "libnl_nf_3",
+        "libnl_cli_3",
+        "libnl_idiag_3",
+        "libnl_xfrm_3",
+    ]],
+    visibility = ["//visibility:public"],
+)
