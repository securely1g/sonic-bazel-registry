-"""Select the compiled objects belonging to one upstream static archive."""
-
-load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
-load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
-
-def _archive_inputs_impl(ctx):
-    # cc_static_library normally includes transitive libraries. Automake's
-    # libnl-route-3.a contains route and parser objects, but not libnl-3 objects.
-    # Keep the existing libraries unchanged and select their own linker inputs.
-    owners = {dep.label: True for dep in ctx.attr.deps}
-    inputs = {}
-    for dep in ctx.attr.deps:
-        for linker_input in dep[CcInfo].linking_context.linker_inputs.to_list():
-            if linker_input.owner in owners:
-                inputs[linker_input.owner] = linker_input
-    missing = [owner for owner in owners if owner not in inputs]
-    if missing:
-        fail("Missing direct archive objects for %s" % missing)
-    compilation = cc_common.merge_cc_infos(cc_infos = [dep[CcInfo] for dep in ctx.attr.deps])
-    return [CcInfo(
-        compilation_context = compilation.compilation_context,
-        linking_context = cc_common.create_linking_context(linker_inputs = depset(inputs.values())),
-    )]
-
-archive_inputs = rule(
-    implementation = _archive_inputs_impl,
-    attrs = {"deps": attr.label_list(providers = [CcInfo], mandatory = True)},
-)
diff --git a/installed_paths_probe.c b/installed_paths_probe.c
new file mode 100644
index 0000000..b03a72d
--- /dev/null
+++ b/installed_paths_probe.c
@@ -0,0 +1,19 @@
+#include <netlink/cli/utils.h>
+#include <netlink/route/pktloc.h>
+#include <string.h>
+
+int main(int argc, char **argv) {
+    if (argc != 2) return 2;
+    if (!strcmp(argv[1], "config")) {
+        struct rtnl_pktloc *location = NULL;
+        rtnl_pktloc_lookup("ip.ttl", &location);
+        if (location) rtnl_pktloc_put(location);
+        return 0;
+    }
+    if (!strcmp(argv[1], "plugin")) {
+        /* A missing module exposes the actual default dlopen path safely. */
+        nl_cli_load_module("cli/qdisc", "__libnl3_missing_path_probe__");
+        return 3;
+    }
+    return 2;
+}
diff --git a/installed_paths_test.py b/installed_paths_test.py
new file mode 100644
index 0000000..4e682f3
--- /dev/null
+++ b/installed_paths_test.py
@@ -0,0 +1,21 @@
+"""Default config and plugin lookups must agree with the installed TAR layout."""
+import os
+from pathlib import Path, PurePosixPath
+import subprocess
+import sys
+import tarfile
+
+probe = str(Path(sys.argv[1]).absolute())
+with tarfile.open(sys.argv[2]) as archive:
+    configs = [member.name.removeprefix("./") for member in archive if member.name.endswith("/pktloc")]
+with tarfile.open(sys.argv[3]) as archive:
+    plugins = [member.name.removeprefix("./") for member in archive if member.name.endswith("/cli/qdisc/bfifo.so")]
+assert len(configs) == len(plugins) == 1, (configs, plugins)
+environment = dict(os.environ, NLDBG="2")
+environment.pop("NLSYSCONFDIR", None)
+config = subprocess.run([probe, "config"], env=environment, capture_output=True, text=True)
+assert config.returncode == 0, config.stderr
+assert "/" + configs[0] in config.stderr, (configs[0], config.stderr)
+plugin = subprocess.run([probe, "plugin"], env=environment, capture_output=True, text=True)
+expected = "/" + str(PurePosixPath(plugins[0]).parent / "__libnl3_missing_path_probe__.so")
+assert plugin.returncode != 0 and expected in plugin.stderr, (expected, plugin.returncode, plugin.stderr)
