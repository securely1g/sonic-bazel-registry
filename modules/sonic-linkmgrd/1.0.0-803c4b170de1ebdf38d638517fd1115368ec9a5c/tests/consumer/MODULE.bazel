module(
    name = "linkmgrd_external_consumer",
    version = "1.0.0",
)

bazel_dep(name = "sonic-linkmgrd", version = "1.0.0-803c4b170de1ebdf38d638517fd1115368ec9a5c")
bazel_dep(name = "sonic-build-infra", version = "0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_rs", version = "0.1.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# The consumer selects C++ and TAR targets, with no Rust compilation.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])
