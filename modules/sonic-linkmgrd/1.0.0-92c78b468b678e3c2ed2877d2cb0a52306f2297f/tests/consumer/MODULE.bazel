module(
    name = "linkmgrd_external_consumer",
    version = "1.0.0",
)

bazel_dep(name = "sonic-linkmgrd", version = "1.0.0-92c78b468b678e3c2ed2877d2cb0a52306f2297f")
bazel_dep(name = "sonic-build-infra", version = "0.0.37-316e298e77ab5cfa69af9b0c05ec24d5d94bbe1e", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.1")
bazel_dep(name = "rules_rs", version = "0.1.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# The consumer selects C++ and TAR targets, with no Rust compilation.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])
