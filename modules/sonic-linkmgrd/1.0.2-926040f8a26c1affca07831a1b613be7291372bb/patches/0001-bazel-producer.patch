@@ -0,0 +1,32 @@
+"""Use the checked-in registries and preserve setup-bazel caches in CI."""
+
+import os
+from pathlib import Path
+import shlex
+import shutil
+import tempfile
+
+
+configuration = Path('.bazelrc').read_text()
+home = Path.home() / '.bazelrc'
+if home.is_file():
+    caches = [line for line in home.read_text().splitlines()
+              if line.startswith(('build --disk_cache=', 'common --repository_cache='))]
+    configuration += '\n' + '\n'.join(caches) + '\n'
+directory = Path(tempfile.mkdtemp(prefix='linkmgrd-bazel-'))
+rc = directory / 'ci.bazelrc'
+rc.write_text(configuration)
+binary = shutil.which('bazel')
+assert binary
+wrapper = directory / 'bazel'
+wrapper.write_text('#!/bin/sh\nexec ' + shlex.quote(binary) +
+                   ' --host_jvm_args=-Xmx3g --nosystem_rc --nohome_rc --noworkspace_rc --bazelrc=' +
+                   shlex.quote(str(rc)) + ' "$@"\n')
+wrapper.chmod(0o755)
+evidence = Path('bazel-evidence')
+evidence.mkdir(exist_ok=True)
+shutil.copyfile('.bazelrc', evidence / 'registry.bazelrc')
+if os.environ.get('GITHUB_ENV'):
+    with open(os.environ['GITHUB_ENV'], 'a') as environment:
+        environment.write('BAZEL_BINARY=' + str(wrapper) + '\n')
+print(wrapper)
diff --git a/tools/bazel/source_contract_test.py b/tools/bazel/source_contract_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..fb97577e0d040a9a0c51d3d6d111eb0352078c67
--- /dev/null
+++ b/tools/bazel/source_contract_test.py
@@ -0,0 +1,25 @@
+"""Keep the maintained source globs aligned with the original Make inputs."""
+
+from pathlib import Path
+import re
+import unittest
+
+
+class SourceContractTest(unittest.TestCase):
+    def test_original_translation_units_are_preserved(self):
+        root = Path(__file__).parents[2]
+        declared = set()
+        makefiles = [root / "src/subdir.mk", *sorted((root / "src").glob("*/subdir.mk")),
+                     root / "test/subdir.mk"]
+        for path in makefiles:
+            section = path.read_text().split("CPP_SRCS +=", 1)[1].split("\n\n", 1)[0]
+            declared.update(re.findall(r"\./((?:src|test)/[^\s\\]+\.cpp)", section))
+        actual = {str(path.relative_to(root)) for directory in ("src", "test")
+                  for path in (root / directory).rglob("*.cpp")}
+        self.assertEqual(actual, declared)
+        self.assertIn("src/LinkMgrdMain.cpp", declared)
+        self.assertIn("test/LinkMgrdTestMain.cpp", declared)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/bazel/swsscommon.bzl b/tools/bazel/swsscommon.bzl
new file mode 100644
