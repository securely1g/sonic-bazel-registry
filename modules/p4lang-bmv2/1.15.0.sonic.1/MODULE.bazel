module(
    name = "p4lang-bmv2",
    version = "1.15.0.sonic.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.8")
bazel_dep(name = "sonic-build-infra", version = "0.0.18-958263e5a67db4e5fd83459f9172c7643a8b1461", repo_name = "sonic_build_infra")
bazel_dep(name = "p4lang-pi", version = "0.1.3.sonic.1", repo_name = "p4lang_pi")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "bmv2_deps",
    packages = [
        "libboost-filesystem1.83-dev",
        "libboost-program-options1.83-dev",
        "libboost-system1.83-dev",
        "libboost-thread1.83-dev",
        "libboost1.83-dev",
        "libgmp-dev",
        "libgrpc++-dev",
        "libgrpc-dev",
        "libnanomsg-dev",
        "libpcap-dev",
        "libprotobuf-dev",
        "libssl-dev",
        "libthrift-dev",
        "python3-six",
        "python3-thrift",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "bmv2_deps")

bmv2_source = use_repo_rule("//:bazel/source.bzl", "bmv2_source")

bmv2_source(
    name = "bmv2_source",
    debian_sha256 = "30941da6dde4cbbefaa9a12dfffa260115b3b63c6d56b3112b3baee953636179",
    debian_url = "https://github.com/securely1g/sonic-bazel-registry/releases/download/p4-source-inputs-20261021/p4lang-bmv2_1.15.0-9.debian.tar.xz",
    overlays = {
        "//:bazel/bmv2.BUILD.bazel": "BUILD.bazel",
        "//:bazel/configure.sh": "bazel/configure.sh",
        "//:bazel/runtime.bzl": "bazel/runtime.bzl",
    },
    sonic_patches = [
        "//:bazel/use-boost-1.83.patch",
        "//:bazel/remove-unnecessary-dependencies.patch",
    ],
    upstream_sha256 = "083bb907e45597af8e29ef3b0a92d33d282ba23840ddd5cfb8372d2f030ab415",
    upstream_url = "https://github.com/securely1g/sonic-bazel-registry/releases/download/p4-source-inputs-20261021/p4lang-bmv2_1.15.0.orig.tar.gz",
)

register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
    "@sonic_build_infra//tools/build_tools:autoconf_toolchain",
)
