}

exec_test(
    name = "package_contract_test",
    runner = ":package_contract_runner",
    data = [label for pair in _RUNTIME_DEBUG_PAIRS.values() for label in pair],
    checker_args = select({
        "@platforms//cpu:x86_64": ["--machine=62"],
        "@platforms//cpu:aarch64": ["--machine=183"],
    }) + [
        "--" + flag + "=" + name + "=$(location " + label + ")"
        for name, pair in _RUNTIME_DEBUG_PAIRS.items()
        for flag, label in zip(["runtime", "debug"], pair)
    ],
)
