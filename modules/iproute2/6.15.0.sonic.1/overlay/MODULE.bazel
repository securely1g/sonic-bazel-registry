module(name = "iproute2", version = "6.15.0.sonic.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "sonic-build-infra", version = "0.0.16-4429ada56a20a9d9cb01369271766991974472bb", repo_name = "sonic_build_infra")
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")
register_toolchains("@gcc_toolchains//:all")
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "iproute2_deps",
    packages = ["libxtables-dev", "libatm1-dev", "libbsd-dev", "libbpf-dev", "libcap-dev", "libdb-dev", "libelf-dev", "libmnl-dev", "libnsl-dev", "libselinux1-dev", "zlib1g-dev"],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "iproute2_deps")
register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
)
