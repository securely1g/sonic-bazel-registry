)

_DATA_PATHS = {source: "usr/share/iproute2/" + source.removeprefix("etc/iproute2/") for source in glob(["etc/iproute2/*"])}
_DATA_PATHS.update({source: "usr/share/doc/iproute2/" + source for source in glob(["examples/**"])})
_DATA_PATHS.update({
    "COPYING": "usr/share/doc/iproute2/COPYING",
    "debian/copyright": "usr/share/doc/iproute2/copyright",
    "include/bpf_elf.h": "usr/include/iproute2/bpf_elf.h",
    "bash-completion/tc": "usr/share/bash-completion/completions/tc",
    "bash-completion/devlink": "usr/share/bash-completion/completions/devlink",
})
_DATA_PATHS.update({source: "usr/share/" + source for source in glob(["man/man3/*.3", "man/man7/*.7", "man/man8/*.8"], exclude = ["man/man8/ifstat.8"])})
_DATA_PATHS.update({"man/man8/" + name + ".8": "usr/share/man/man8/" + name + ".8" for name in ["ip-address", "ip-link", "ip-netns", "ip-route", "ip-rule"]})
_PROGRAMS = {
    "arpd": "usr/sbin/arpd", "bridge": "usr/sbin/bridge",
    "dcb": "usr/sbin/dcb", "devlink": "usr/sbin/devlink",
    "genl": "usr/sbin/genl", "ip": "usr/bin/ip", "lnstat": "usr/bin/lnstat",
    "nstat": "usr/bin/nstat", "rdma": "usr/bin/rdma", "rtacct": "usr/sbin/rtacct",
    "rtmon": "usr/sbin/rtmon", "ss": "usr/bin/ss", "tc": "usr/sbin/tc",
    "tipc": "usr/sbin/tipc", "vdpa": "usr/sbin/vdpa",
}
[
    sonic_deploy_tar(
        name = "iproute2_pkg_" + arch,
        visibility = ["//visibility:public"],
        binaries = {path + " uid=0 gid=0 type=file mode=0755": ":built_" + name for name, path in _PROGRAMS.items()},
        force_debug_build = True,
        srcs = _DATA_PATHS.keys() + ["ip/routel"] + [":" + name + "_distribution" for name in ["normal", "pareto", "paretonormal", "experimental"]],
        mtree = [path + " uid=0 gid=0 type=file mode=0644 content=$(location " + source + ")" for source, path in _DATA_PATHS.items()] + [
            "usr/bin/routel uid=0 gid=0 type=file mode=0755 content=$(location ip/routel)",
            "usr/bin/ctstat uid=0 gid=0 type=link link=lnstat",
            "usr/bin/rtstat uid=0 gid=0 type=link link=lnstat",
            "usr/sbin/ip uid=0 gid=0 type=link link=../bin/ip",
        ] + ["usr/lib/" + triplet + "/tc/" + name + ".dist uid=0 gid=0 type=file mode=0644 content=$(location :" + name + "_distribution)" for name in ["normal", "pareto", "paretonormal", "experimental"]],
    )
    for arch, triplet in {"amd64": "x86_64-linux-gnu", "arm64": "aarch64-linux-gnu"}.items()
]

alias(
    name = "iproute2_pkg",
    actual = select({"@platforms//cpu:x86_64": ":iproute2_pkg_amd64", "@platforms//cpu:arm64": ":iproute2_pkg_arm64"}),
)

alias(
    name = "iproute2_pkg.debug_symbols",
    actual = select({"@platforms//cpu:x86_64": ":iproute2_pkg_amd64.debug_symbols", "@platforms//cpu:arm64": ":iproute2_pkg_arm64.debug_symbols"}),
)

