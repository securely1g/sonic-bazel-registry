    substitutions = {"@NETNS_ETC_DIR@": "/etc/netns", "@NETNS_RUN_DIR@": "/run/netns", "@SYSCONF_ETC_DIR@": "/etc/iproute2", "@SYSCONF_USR_DIR@": "/usr/share/iproute2"},
)

expand_template(
