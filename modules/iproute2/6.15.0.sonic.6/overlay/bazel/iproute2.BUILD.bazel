package(default_visibility = ["//visibility:public"])

# Source include paths precede dependency system headers, as in upstream Make.
cc_library(
    name = "headers",
    features = ["-external_include_paths"],
    hdrs = glob(["include/*.h", "include/netinet/*.h"]),
    strip_include_prefix = "include",
)
cc_library(
    name = "uapi_headers",
    features = ["-external_include_paths"],
    hdrs = glob(["include/uapi/**/*.h"]),
    strip_include_prefix = "include/uapi",
)

cc_library(
    name = "rdma_headers",
    hdrs = glob(["rdma/include/uapi/**/*.h"]),
    strip_include_prefix = "rdma/include/uapi",
    features = ["-external_include_paths"],
)

# Debian hardening=+all, source feature probes, and fixed SONiC paths.
_COPTS = [
    "-O2", "-pipe", "-g", "-Wall", "-Wstrict-prototypes",
    "-Wmissing-prototypes", "-Wmissing-declarations", "-Wold-style-definition",
    "-Wformat=2", "-Werror=format-security", "-Wdate-time",
    "-Werror=implicit-function-declaration", "-fstack-protector-strong",
    "-fstack-clash-protection", "-D_FORTIFY_SOURCE=2",
] + select({
    "@platforms//cpu:x86_64": ["-fcf-protection"],
    "@platforms//cpu:arm64": ["-mbranch-protection=standard"],
})
_DEFINES = [
    "_GNU_SOURCE", "_FILE_OFFSET_BITS=64", "_LARGEFILE_SOURCE", "_LARGEFILE64_SOURCE",
    "RESOLVE_HOSTNAMES", "CONF_USR_DIR=\\\"/usr/share/iproute2\\\"",
    "CONF_ETC_DIR=\\\"/etc/iproute2\\\"", "NETNS_RUN_DIR=\\\"/run/netns\\\"",
    "NETNS_ETC_DIR=\\\"/etc/netns\\\"", "ARPDDIR=\\\"/var/lib/arpd\\\"",
    "CONF_COLOR=COLOR_OPT_AUTO", "HAVE_SETNS", "HAVE_HANDLE_AT", "HAVE_SELINUX",
    "HAVE_RPC", "HAVE_LIBBPF", "LIBBPF_DYNAMIC", "HAVE_LIBBPF_SECTION_NAME",
    "HAVE_ELF", "HAVE_LIBMNL", "HAVE_LIBCAP", "LIBBPF_VERSION=\\\"1.5.0\\\"",
] + select({
    "@platforms//cpu:x86_64": ["LIBDIR=\\\"/usr/lib/x86_64-linux-gnu\\\""],
    "@platforms//cpu:arm64": ["LIBDIR=\\\"/usr/lib/aarch64-linux-gnu\\\""],
})
_DEPS = [
    ":headers", ":uapi_headers",
    "@iproute2_deps//libbpf-dev:libbpf_cc",
    "@iproute2_deps//libcap-dev:libcap_cc",
    "@iproute2_deps//libelf-dev:libelf_cc",
    "@iproute2_deps//libmnl-dev:libmnl_cc",
    "@iproute2_deps//libtirpc-dev:libtirpc_cc",
    "@iproute2_deps//libselinux1-dev:libselinux_cc",
]

# Retain the public configuration report; these values also select native inputs.
write_file(
    name = "iproute2_config",
    out = "config.mk",
    content = [
        "HAVE_LIBBPF:=y", "HAVE_ELF:=y", "HAVE_MNL:=y", "HAVE_BERKELEY_DB:=y",
        "HAVE_RPC:=y", "HAVE_SELINUX:=y", "HAVE_CAP:=y", "TC_CONFIG_XT:=y",
        "TC_CONFIG_IPSET:=y", "IP_CONFIG_SETNS:=y", "CONF_COLOR:=COLOR_OPT_AUTO",
    ],
)
expand_template(
    name = "package_changelog",
    template = "debian/changelog",
    out = "package.changelog",
    substitutions = {"(6.15.0-1)": "(6.15.0-1+sonic.0)"},
)

# tc's lexer consumes the parser header generated by this Bison action.
genrule(
    name = "ematch_parser",
    srcs = ["tc/emp_ematch.y"],
    outs = ["tc/emp_ematch.tab.c", "tc/emp_ematch.tab.h", "tc/emp_ematch.output"],
    tools = ["@sonic_build_infra//tools/build_tools:bison", "@sonic_build_infra//tools/build_tools:m4"],
    cmd = 'M4="$(location @sonic_build_infra//tools/build_tools:m4)" "$(location @sonic_build_infra//tools/build_tools:bison)" -d -t -v -p ematch_ -b "$(RULEDIR)/tc/emp_ematch" "$(location tc/emp_ematch.y)"',
)
genrule(
    name = "ematch_lexer",
    srcs = ["tc/emp_ematch.l", "tc/emp_ematch.tab.h"],
    outs = ["tc/emp_ematch.lex.c"],
    tools = ["@sonic_build_infra//tools/build_tools:flex"],
    cmd = '"$(location @sonic_build_infra//tools/build_tools:flex)" -o$@ "$(location tc/emp_ematch.l)"',
)
genrule(
    name = "ss_parser",
    srcs = ["misc/ssfilter.y"],
    outs = ["misc/ssfilter.tab.c"],
    tools = ["@sonic_build_infra//tools/build_tools:bison", "@sonic_build_infra//tools/build_tools:m4"],
    cmd = 'M4="$(location @sonic_build_infra//tools/build_tools:m4)" "$(location @sonic_build_infra//tools/build_tools:bison)" -b "$(@D)/ssfilter" "$(location misc/ssfilter.y)"',
)

