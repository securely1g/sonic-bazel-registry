module(
    name = "sonic-mgmt-common",
    version = "1.0.0-af147e78654ad423ea0a2af268dfd0b71092b38b",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "libyang", version = "3.12.2.sonic.5")
bazel_dep(name = "oc-pyang", version = "0.1.10.sonic.1", repo_name = "oc_pyang")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.25-17a1e555291c64be1a6ff008f33352bffc4f8e5c", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-yang-models", version = "1.0.1-b0a9362a7a1b4b5e1b7188c019d256f7c8aaff9f", repo_name = "sonic_yang_models")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")

# Reuse SONiC's reviewed CGo/header repair and TAR toolchain selection.
single_version_override(
    module_name = "rules_go",
    version = "0.64.1-sonic.1",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.9")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Shared Go module overrides belong to the consuming root. When this repository
# is the root, apply the same owner patches; downstream roots select these
# exported patches explicitly without creating a second Go dependency graph.
go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_patches.gazelle_override(
    directives = ["gazelle:proto disable_global"],
    path = "github.com/openconfig/gnmi",
)

# These are the existing Make/vendor patches, applied to isolated dependency
# repositories. Build actions never modify go.mod, vendor, or the checkout.
go_patches.module_override(
    patch_strip = 1,
    patches = [
        "//patches:ygot/ygot.patch",
        "//patches:0001-ygot-declare-patched-value-dependency.patch",
        "//patches:0003-ygot-preserve-union-enum-order.patch",
    ],
    path = "github.com/openconfig/ygot",
)
go_patches.module_override(
    patch_strip = 1,
    patches = [
        "//patches:goyang/goyang.patch",
        "//patches:0002-goyang-preserve-declared-schema-order.patch",
    ],
    path = "github.com/openconfig/goyang",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:jsonquery.patch"],
    path = "github.com/antchfx/jsonquery",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:xmlquery.patch"],
    path = "github.com/antchfx/xmlquery",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:xpath.patch"],
    path = "github.com/antchfx/xpath",
)
go_patches.module_override(
    patch_strip = 1,
    patches = ["//patches:glog.patch"],
    path = "github.com/golang/glog",
)

use_repo(go_deps, "af_inet_netaddr", "com_github_antchfx_jsonquery", "com_github_antchfx_xmlquery", "com_github_antchfx_xpath", "com_github_go_redis_redis_v7", "com_github_godbus_dbus_v5", "com_github_golang_glog", "com_github_google_go_cmp", "com_github_kylelemons_godebug", "com_github_maruel_natural", "com_github_openconfig_gnmi", "com_github_openconfig_goyang", "com_github_openconfig_ygot", "com_github_philopon_go_toposort", "com_github_pkg_profile", "com_github_redis_go_redis_v9", "com_github_workiva_go_datastructures", "org_golang_google_grpc", "org_golang_x_text")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
use_repo(python, "python_3_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mgmt_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "mgmt_pip")

# Private test service, using the same immutable Debian snapshot as the shared
# toolchain. Redis is a declared test runtime, never a worker-owned service.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(lock = "//tools/test:apt.lock.json")
use_repo(apt, "mgmt_test_deps")

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all")
