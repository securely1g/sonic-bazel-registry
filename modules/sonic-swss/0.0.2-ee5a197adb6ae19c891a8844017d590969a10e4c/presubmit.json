      "repo_name": "sonic_build_infra"
    },
    {
      "name": "tar.bzl",
      "version": "0.10.5-sonic.1"
    },
    {
      "name": "rules_distroless",
      "version": "0.9.4.sonic.16"
    },
    {
      "name": "rules_cc",
      "version": "0.2.20"
    },
    {
      "name": "rules_rs",
      "version": "0.1.0"
    },
    {
      "name": "libnl3",
      "version": "3.7.0.sonic.7"
    },
    {
      "name": "patchelf",
      "version": "0.18.0.bcr.1"
    }
  ],
  "platforms": {
