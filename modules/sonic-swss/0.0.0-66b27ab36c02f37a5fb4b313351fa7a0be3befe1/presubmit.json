{
  "architectures": [
    "amd64",
    "arm64"
  ],
  "consumer_deps": [
    {
      "name": "sonic-build-infra",
      "version": "0.0.25-1341eaf4a7759ef0121ae7c17edcd0000d063038",
      "repo_name": "sonic_build_infra"
    },
    {
      "name": "tar.bzl",
      "version": "0.10.5-sonic.1"
    },
    {
      "name": "rules_rs",
      "version": "0.1.0"
    },
    {
      "name": "rules_cc",
      "version": "0.2.20"
    }
  ],
  "platforms": {
    "amd64": "@sonic_build_infra//platforms:x86_64_trixie",
    "arm64": "@sonic_build_infra//platforms:aarch64_trixie"
