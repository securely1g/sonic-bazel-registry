    "@sonic-swss//crates/countersyncd:common_rust_test"
  ],
  "rust_toolchain": {
    "version": "1.90.0",
    "mangled_allocator_libraries": true,
    "bindgen": true
  },
  "host_platforms": {
    "amd64": "@sonic_build_infra//platforms:x86_64_trixie",
    "arm64": "@sonic_build_infra//platforms:aarch64_trixie"
  }
