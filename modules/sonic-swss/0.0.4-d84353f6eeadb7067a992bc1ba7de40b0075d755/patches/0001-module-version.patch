 module(
     name = "sonic-swss",
-    version = "0.0.4",
+    version = "0.0.4-d84353f6eeadb7067a992bc1ba7de40b0075d755",
     bazel_compatibility = [
         ">=8.5.1",
         "<=8.5.1",
