{
  "architectures": [
    "amd64",
    "arm64"
  ],
  "consumer_deps": [
    {
      "name": "tar.bzl",
      "version": "0.10.5-sonic.1"
    }
  ],
  "platforms": {
    "amd64": "@sonic-build-infra//platforms:x86_64_trixie",
    "arm64": "@sonic-build-infra//platforms:aarch64_trixie"
  },
  "build_targets": [
    "@sonic-build-infra//tar:timestamp_default_tar",
    "@sonic-build-infra//tests:timestamp_deploy_tar",
    "@sonic-build-infra//tests:timestamp_deploy_tar.debug_symbols"
  ],
  "test_targets": [
    "@sonic-build-infra//tests:deploy_tar_timestamps_test",
    "@sonic-build-infra//tests:hello_deploy_tar_content_test",
    "@sonic-build-infra//tests:hello_deploy_tar_provides_debug_symbols_test",
    "@sonic-build-infra//tar:root_owned_tar_test",
    "@sonic-build-infra//tar:debug_symbols_ownership_test",
    "@sonic-build-infra//python:py_native_library_test",
    "@sonic-build-infra//python:wheel_layer_test"
  ]
}
