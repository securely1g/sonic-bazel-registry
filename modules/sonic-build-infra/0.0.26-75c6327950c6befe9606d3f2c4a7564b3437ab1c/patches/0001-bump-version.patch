     name = "sonic-build-infra",
-    version = "0.0.26",
+    version = "0.0.26-75c6327950c6befe9606d3f2c4a7564b3437ab1c",
     bazel_compatibility = [
         ">=8.5.1",
         "<=8.5.1",
