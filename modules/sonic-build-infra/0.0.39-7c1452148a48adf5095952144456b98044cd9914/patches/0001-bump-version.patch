From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH] Register the sonic-build-infra source commit

Align the source module identity with this commit-qualified registration.
Dependency updates are owned by the source commit.

Source commit: 7c1452148a48adf5095952144456b98044cd9914
Scope: downstream registry integration; not an upstream bug fix.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,7 +1,7 @@
 # Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
 module(
     name = "sonic-build-infra",
-    version = "0.0.39",
+    version = "0.0.39-7c1452148a48adf5095952144456b98044cd9914",
     bazel_compatibility = [
         ">=8.5.1",
         "<=8.5.1",
