load("@rules_python//python:defs.bzl", "py_test")
load("//toolchains/gcc/tests:prefix_map.bzl", "prefix_map_fixture")

# The producer's root-only assertion does not include external/<repository>/.
# Exercise the same absolute-source compilation with this consumer's execpath.
prefix_map_fixture(
    name = "prefix_map_object",
    src = "prefix_map.c",
)

py_test(
    name = "prefix_map_test",
    srcs = ["prefix_map_test.py"],
    args = [
        "$(execpath :prefix_map.c)",
        "$(location //toolchains/binutils:objcopy)",
        "$(locations :prefix_map_object)",
    ],
    data = [
        ":prefix_map.c",
        ":prefix_map_object",
        "//toolchains/binutils:objcopy",
    ],
    visibility = ["//visibility:public"],
)

# Build the shared runtime but retain only its small provenance receipt.
genrule(
    name = "kernel_runtime_manifest",
    srcs = ["//tools/build_tools:kernel_runtime"],
    outs = ["kernel_runtime.json"],
    cmd = "cp $(location //tools/build_tools:kernel_runtime)/kernel-runtime.json $@",
    visibility = ["//visibility:public"],
)

# These tests run the AMD64-hosted cross compilers and inspect ARM binaries.
# Each native architecture runs the producer's kernel_runtime_tools_test.
[
    py_test(
        name = "kernel_" + architecture + "_tools_test",
        srcs = ["kernel_tools_test.py"],
        args = [
            "$(location //tools/build_tools:kernel_cross_runtime_" + architecture + "_test)",
            "$(location //tools/build_tools:kernel_build_tools_" + architecture + ")",
            architecture,
        ],
        data = [
            "//tools/build_tools:kernel_cross_runtime_" + architecture + "_test",
            "//tools/build_tools:kernel_build_tools_" + architecture,
        ],
        main = "kernel_tools_test.py",
        size = "large",
        target_compatible_with = ["@platforms//cpu:x86_64"],
        visibility = ["//visibility:public"],
    )
    for architecture in ["arm64", "armhf"]
]
