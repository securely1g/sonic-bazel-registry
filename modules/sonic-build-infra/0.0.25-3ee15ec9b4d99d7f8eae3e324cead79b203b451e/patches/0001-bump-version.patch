Subject: [PATCH 1/3] Identify the registered shared build rules

Keep the fetched module version equal to its registry entry. This registers
the retained native tools, debug permissions and finalized-control metadata.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,7 +1,7 @@
 # Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
 module(
     name = "sonic-build-infra",
-    version = "0.0.25",
+    version = "0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e",
     bazel_compatibility = [
         ">=8.5.1",
         "<=8.5.1",
