load("@rules_python//python:defs.bzl", "py_test")

# Build the shared runtime but retain only its small provenance receipt.
genrule(
    name = "kernel_runtime_manifest",
    srcs = ["//tools/build_tools:kernel_runtime"],
    outs = ["kernel_runtime.json"],
    cmd = "cp $(location //tools/build_tools:kernel_runtime)/kernel-runtime.json $@",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "amd64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

# Keep the original AMD64-to-ARM compiler checks. On native ARM64, reuse the
# native kernel runtime regression, since AMD64 cross tools cannot run there.
[
    py_test(
        name = "kernel_" + architecture + "_tools_test",
        srcs = ["kernel_tools_test.py"],
        args = select({
            ":amd64": ["$(location //tools/build_tools:kernel_cross_runtime_" + architecture + "_test)"],
            "//conditions:default": ["$(location //tools/build_tools:kernel_runtime_test)"],
        }),
        data = select({
            ":amd64": ["//tools/build_tools:kernel_cross_runtime_" + architecture + "_test"],
            "//conditions:default": ["//tools/build_tools:kernel_runtime_test"],
        }),
        main = "kernel_tools_test.py",
        size = "large",
        visibility = ["//visibility:public"],
    )
    for architecture in ["arm64", "armhf"]
]
