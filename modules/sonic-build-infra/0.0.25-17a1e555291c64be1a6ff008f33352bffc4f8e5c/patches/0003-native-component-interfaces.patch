+++ b/tools/gzip/BUILD.bazel
@@ -0,0 +1,24 @@
+load("@rules_multirun//:defs.bzl", "command")
+load("@toolchain_utils//toolchain/info:defs.bzl", "toolchain_info")
+
+# rules_gzip 1.0.0 has no extra-arguments attribute. Configure its executable
+# with standard rules so it always omits input filenames and timestamps.
+# Consumers register this toolchain explicitly in their MODULE.bazel.
+command(
+    name = "reproducible_gzip",
+    arguments = ["--no-name"],
+    command = "@pigz",
+    visibility = ["//visibility:public"],
+)
+
+toolchain_info(
+    name = "info",
+    target = ":reproducible_gzip",
+)
+
+toolchain(
+    name = "toolchain",
+    toolchain = ":info",
+    toolchain_type = "@rules_gzip//gzip/toolchain/gzip:type",
+    visibility = ["//visibility:public"],
+)
