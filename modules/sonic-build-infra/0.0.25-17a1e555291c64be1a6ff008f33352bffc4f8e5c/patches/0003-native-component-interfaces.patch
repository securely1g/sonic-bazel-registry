diff --git a/cc/README.md b/cc/README.md
index 0b820b7..179634d 100644
--- a/cc/README.md
+++ b/cc/README.md
@@ -59,3 +59,36 @@ the default linker behavior, without flags that force RUNPATH. The ELF check
 requires RUNPATH, rejects RPATH, and verifies that the executable only needs
 the middle library directly. The standard native AMD64 and ARM64 CI runs both
 tests.
+
+`native_runtime_binary` and `native_runtime_test` in `//cc:runtime_test.bzl`
+execute native Linux target ELFs using the matching loader and libraries from
+explicit target Debian payload tar archives. They preserve installed PT_INTERP.
+Provide `binary` and `runtime_payloads` (including libc6 and the runtime library
+closure). Payload labels may be architecture-selecting filegroups. The wrapper
+retains the binary's runfiles and its relative ORIGIN library paths.
+Shared libraries expand ORIGIN relative to their own location. RPATH search
+paths reach indirect dependencies; RUNPATH applies only to direct dependencies.
+An execution tool attribute with `cfg = "exec"` selects the complete wrapper
+in exec configuration.
+Cross architecture binaries may be built; this interface requires matching
+execution and target CPUs to execute them. It supports library payloads, not a
+chroot filesystem or arbitrary package data requirements.
+
+Set `instrument` to a declared executable (selected in exec configuration) and
+`instrument_args` to its arguments when testing through Valgrind or a similar
+ELF instrument. The instrument receives the matching loader, its library search
+arguments, the real target ELF, and the program arguments. Its runfiles are
+included. Both the program exit and an instrument-reported error propagate to
+the caller. The runtime regression uses real Memcheck on valid and out-of-bounds
+memory accesses to verify this boundary.
+When an instrument needs a stripped library's internal symbols, include its
+matching debug package in `runtime_payloads`. Matching GNU Build-ID and
+debuglink CRC data are installed next to the declared library, so debug lookup
+continues to work after runtime relocation.
+
+The runtime regression executes real target glibc 2.41 programs, checks argument
+and nonzero exit forwarding, preserves signal termination for callers using
+waitpid/WIFSIGNALED, exercises the wrapper as an exec tool and rejects a
+missing declared libc6 payload. It addresses the observed failure where the
+system interpreter started a binary with imported target glibc and crashed
+before main.
diff --git a/cc/direct_linker_inputs.bzl b/cc/direct_linker_inputs.bzl
new file mode 100644
index 0000000..432990f
--- /dev/null
+++ b/cc/direct_linker_inputs.bzl
@@ -0,0 +1,33 @@
+"""Expose only direct linker inputs while preserving producer compilation contexts.
+
+Use before cc_static_library when an installed archive contains selected direct
+objects while its transitive libraries are supplied separately by consumers.
+"""
+
+load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+def _impl(ctx):
+    # cc_static_library includes transitive objects; keep only the selected
+    # producers' own linker inputs without rebuilding or copying their artifacts.
+    owners = {dep.label: True for dep in ctx.attr.deps}
+    inputs = []
+    found = {}
+    for dep in ctx.attr.deps:
+        for linker_input in dep[CcInfo].linking_context.linker_inputs.to_list():
+            if linker_input.owner in owners:
+                inputs.append(linker_input)
+                found[linker_input.owner] = True
+    missing = [owner for owner in owners if owner not in found]
+    if missing:
+        fail("Missing direct archive objects for %s" % missing)
+    compilation = cc_common.merge_cc_infos(cc_infos = [dep[CcInfo] for dep in ctx.attr.deps])
+    return [CcInfo(
+        compilation_context = compilation.compilation_context,
+        linking_context = cc_common.create_linking_context(linker_inputs = depset(inputs)),
+    )]
+
+direct_linker_inputs = rule(
+    implementation = _impl,
+    attrs = {"deps": attr.label_list(providers = [CcInfo], mandatory = True)},
+)
diff --git a/cc/preprocess.bzl b/cc/preprocess.bzl
new file mode 100644
index 0000000..94e5040
--- /dev/null
+++ b/cc/preprocess.bzl
@@ -0,0 +1,44 @@
+"""Preprocess a C input with its target toolchain and declared CcInfo dependencies."""
+
+load("@rules_cc//cc:action_names.bzl", "ACTION_NAMES")
+load("@rules_cc//cc:defs.bzl", "CcInfo", "cc_common")
+load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cc_toolchain", "use_cc_toolchain")
+
+def _impl(ctx):
+    cc = find_cc_toolchain(ctx)
+    features = cc_common.configure_features(ctx = ctx, cc_toolchain = cc, requested_features = ctx.features, unsupported_features = ctx.disabled_features)
+    variables = cc_common.create_compile_variables(feature_configuration = features, cc_toolchain = cc)
+    flags = cc_common.get_memory_inefficient_command_line(feature_configuration = features, action_name = ACTION_NAMES.c_compile, variables = variables)
+    compilation = cc_common.merge_cc_infos(cc_infos = [dep[CcInfo] for dep in ctx.attr.deps]).compilation_context
+    output = ctx.actions.declare_file(ctx.label.name + ".i")
+    args = ctx.actions.args()
+    args.add_all(flags)
+    args.add_all(["-E", "-P", "-x", "c"])
+    args.add_all(compilation.includes, format_each = "-I%s")
+    args.add_all(compilation.quote_includes, format_each = "-iquote%s")
+    args.add_all(compilation.system_includes, format_each = "-isystem%s")
+    args.add_all(compilation.external_includes, format_each = "-isystem%s")
+    args.add_all(compilation.defines, format_each = "-D%s")
+    args.add_all(ctx.attr.copts)
+    args.add(ctx.file.src)
+    args.add("-o")
+    args.add(output)
+    ctx.actions.run(
+        executable = cc_common.get_tool_for_action(feature_configuration = features, action_name = ACTION_NAMES.c_compile),
+        arguments = [args],
+        inputs = depset([ctx.file.src], transitive = [cc.all_files, compilation.headers]),
+        outputs = [output],
+        mnemonic = "CcPreprocess",
+    )
+    return [DefaultInfo(files = depset([output]))]
+
+cc_preprocess = rule(
+    implementation = _impl,
+    attrs = {
+        "src": attr.label(mandatory = True, allow_single_file = True),
+        "deps": attr.label_list(providers = [CcInfo]),
+        "copts": attr.string_list(),
+    },
+    fragments = ["cpp"],
+    toolchains = use_cc_toolchain(),
+)
diff --git a/cc/runtime_test.bzl b/cc/runtime_test.bzl
new file mode 100644
index 0000000..5851e71
--- /dev/null
+++ b/cc/runtime_test.bzl
@@ -0,0 +1,79 @@
+"""Native target ELF execution with a declared matching distribution runtime."""
+
+load("@rules_python//python:py_info.bzl", "PyInfo")
+
+def _runfile(ctx, file):
+    return file.short_path[3:] if file.short_path.startswith("../") else ctx.workspace_name + "/" + file.short_path
+
+def _quote(value):
+    return "'" + value.replace("'", "'\\''") + "'"
+
+def _impl(ctx):
+    executable = ctx.actions.declare_file(ctx.label.name)
+    python = ctx.attr._python[platform_common.ToolchainInfo].py3_runtime
+    if python == None or python.interpreter == None:
+        fail("Native runtime execution requires a declared Python interpreter")
+    sources = ctx.attr._metadata[PyInfo].transitive_sources.to_list()
+    metadata = [source for source in sources if source.basename == "elf_metadata.py"]
+    if len(metadata) != 1:
+        fail("Expected the declared ELF metadata parser source")
+    metadata_directory = _runfile(ctx, metadata[0]).rsplit("/", 1)[0]
+    # -E isolates only helper initialization. The target keeps the caller's
+    # environment, including embedded-Python HOME/PATH values used by clippy.
+    bootstrap = "import runpy,sys;sys.path.insert(0,sys.argv.pop(1));sys.argv[0]=sys.argv.pop(1);runpy.run_path(sys.argv[0],run_name='__main__')"
+    command = 'exec "$runfiles/%s" -E -c %s "$runfiles/%s" "$runfiles/%s" --binary "$runfiles/%s"' % (
+        _runfile(ctx, python.interpreter), _quote(bootstrap), metadata_directory,
+        _runfile(ctx, ctx.file._runner_source), _runfile(ctx, ctx.file.binary),
+    )
+    for payload in ctx.files.runtime_payloads:
+        command += ' --payload "$runfiles/%s"' % _runfile(ctx, payload)
+    if ctx.executable.instrument:
+        command += ' --instrument "$runfiles/%s"' % _runfile(ctx, ctx.executable.instrument)
+        for argument in ctx.attr.instrument_args:
+            command += " " + _quote("--instrument-arg=" + argument)
+    command += ' -- "$@"\n'
+    ctx.actions.write(executable, """#!/bin/sh
+set -eu
+self=$0
+case "$self" in /*) ;; *) self="$PWD/$self" ;; esac
+runfiles="$self.runfiles"
+if [ ! -d "$runfiles" ] && [ -n "${RUNFILES_DIR:-}" ] && [ -d "$RUNFILES_DIR" ]; then
+    runfiles=$RUNFILES_DIR
+fi
+if [ ! -d "$runfiles" ] && [ -n "${TEST_SRCDIR:-}" ] && [ -d "$TEST_SRCDIR" ]; then
+    runfiles=$TEST_SRCDIR
+fi
+if [ ! -d "$runfiles" ]; then
+    runfiles=$self
+    while :; do
+        case "$runfiles" in
+            *.runfiles) break ;;
+            /|"") echo "Missing native target runtime runfiles: $self" >&2; exit 1 ;;
+        esac
+        runfiles=${runfiles%/*}
+    done
+fi
+export RUNFILES_DIR="$runfiles"
+""" + command, is_executable = True)
+    runfiles = ctx.runfiles(files = [ctx.file.binary, ctx.file._runner_source, python.interpreter] + sources + ctx.files.runtime_payloads + ctx.files.data, transitive_files = python.files)
+    targets = [ctx.attr.binary, ctx.attr._metadata] + ctx.attr.data
+    if ctx.attr.instrument:
+        runfiles = runfiles.merge(ctx.runfiles(files = [ctx.executable.instrument]))
+        targets.append(ctx.attr.instrument)
+    for target in targets:
+        runfiles = runfiles.merge(target[DefaultInfo].default_runfiles).merge(target[DefaultInfo].data_runfiles)
+    return [DefaultInfo(executable = executable, runfiles = runfiles)]
+
+_attrs = {
+    "binary": attr.label(allow_single_file = True, mandatory = True),
+    "runtime_payloads": attr.label_list(allow_files = True, mandatory = True),
+    "data": attr.label_list(allow_files = True),
+    "instrument": attr.label(executable = True, cfg = "exec", doc = "Declared instrumentation tool invoked before the target loader and ELF."),
+    "instrument_args": attr.string_list(),
+    "_runner_source": attr.label(default = Label("//cc:runtime_test.py"), allow_single_file = True, cfg = "exec"),
+    "_metadata": attr.label(default = Label("//deb:elf_metadata"), providers = [PyInfo], cfg = "exec"),
+    "_python": attr.label(default = Label("@rules_python//python:current_py_toolchain"), cfg = "exec"),
+}
+
+native_runtime_binary = rule(implementation = _impl, executable = True, attrs = _attrs, doc = "Wrap a native ELF with declared matching libc6 and library payloads; consumers may select cfg=exec.")
+native_runtime_test = rule(implementation = _impl, test = True, attrs = _attrs, doc = "Test a native ELF using declared libc6 and target library payloads. Cross targets are compile-only.")
diff --git a/cc/runtime_test.py b/cc/runtime_test.py
new file mode 100644
index 0000000..988b96a
--- /dev/null
+++ b/cc/runtime_test.py
@@ -0,0 +1,141 @@
+"""Run a native Linux ELF using the matching loader from declared target data."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import platform
+import subprocess
+import signal
+import tarfile
+import tempfile
+import zlib
+
+from elf_metadata import Elf
+
+
+def origin_paths(elf, directory):
+    paths = {15: [], 29: []}
+    has_runpath = False
+    for section in elf.sections:
+        if section[1] != 6:
+            continue
+        strings = elf.section_data(elf.sections[section[6]])
+        for offset in range(section[4], section[4] + section[5], section[9]):
+            tag, value = elf.unpack("qQ" if elf.bits == 64 else "iI", offset)
+            if tag not in paths:
+                continue
+            has_runpath |= tag == 29
+            for entry in elf.string(strings, value).split(":"):
+                if "$ORIGIN" in entry or "${ORIGIN}" in entry:
+                    paths[tag].append(entry.replace("${ORIGIN}", str(directory)).replace("$ORIGIN", str(directory)))
+    return ([] if has_runpath else paths[15], paths[29], has_runpath)
+
+
+def run(binary, payloads, arguments, instrument=None, instrument_arguments=()):
+    binary = Path(binary).resolve()
+    elf = Elf(binary.read_bytes())
+    native = {"x86_64": 62, "aarch64": 183}.get(platform.machine())
+    if elf.machine != native:
+        raise ValueError("native_runtime_test requires matching execution and target CPUs")
+    with tempfile.TemporaryDirectory(prefix="native-target-runtime-") as temporary:
+        root = Path(temporary)
+        libraries = {}
+        library_metadata = {}
+        debug_files = {}
+        loader = None
+        for payload in payloads:
+            with tarfile.open(payload) as archive:
+                for member in archive:
+                    if not member.isfile():
+                        continue
+                    contents = archive.extractfile(member).read()
+                    if contents[:4] != b"\x7fELF":
+                        continue
+                    item = Elf(contents)
+                    if item.machine != native:
+                        raise ValueError("runtime payload contains an ELF for a different CPU: " + member.name)
+                    if member.name.removeprefix("./").startswith("usr/lib/debug/") and item.build_id:
+                        previous = debug_files.setdefault(item.build_id, contents)
+                        if previous != contents:
+                            raise ValueError("conflicting runtime debug Build-ID: " + item.build_id)
+                        continue
+                    if not item.soname:
+                        continue
+                    digest = hashlib.sha256(contents).digest()
+                    if item.soname in libraries:
+                        if libraries[item.soname] != digest:
+                            raise ValueError("conflicting runtime SONAME: " + item.soname)
+                        continue
+                    if Path(item.soname).name != item.soname:
+                        raise ValueError("invalid runtime SONAME")
+                    libraries[item.soname] = digest
+                    library_metadata[item.soname] = item
+                    target = root / item.soname
+                    target.write_bytes(contents)
+                    target.chmod(0o755)
+                    if item.soname.startswith("ld-linux-"):
+                        if loader is not None:
+                            raise ValueError("multiple target ELF loaders")
+                        loader = target
+        if loader is None or "libc.so.6" not in libraries:
+            raise ValueError("runtime_payloads must include a matching libc6 loader and libc.so.6")
+        for item in library_metadata.values():
+            debug = debug_files.get(item.build_id)
+            if debug is None or not item.debuglink:
+                continue
+            if Path(item.debuglink).name != item.debuglink:
+                raise ValueError("invalid runtime debuglink")
+            if zlib.crc32(debug) != item.debuglink_crc:
+                raise ValueError("runtime debuglink CRC differs from matching Build-ID data")
+            destination = root / ".debug" / item.debuglink
+            destination.parent.mkdir(exist_ok=True)
+            if destination.exists() and destination.read_bytes() != debug:
+                raise ValueError("conflicting runtime debuglink filename: " + item.debuglink)
+            destination.write_bytes(debug)
+        pending = [(binary, [])]
+        checked = set()
+        while pending:
+            current, inherited_rpaths = pending.pop()
+            if current in checked:
+                continue
+            checked.add(current)
+            current_elf = Elf(current.read_bytes())
+            rpaths, runpaths, has_runpath = origin_paths(current_elf, current.parent)
+            paths = rpaths + ([] if has_runpath else inherited_rpaths) + [str(root)] + runpaths
+            for soname in current_elf.needed:
+                provider = next((Path(directory) / soname for directory in paths if (Path(directory) / soname).is_file()), None)
+                if provider is None:
+                    raise ValueError("undeclared runtime library: " + soname + " required by " + str(current))
+                pending.append((provider, rpaths + inherited_rpaths))
+        environment = dict(os.environ)
+        for name in ("LD_LIBRARY_PATH", "LD_PRELOAD", "LD_AUDIT"):
+            environment.pop(name, None)
+        # Let the loader apply each object's RPATH/RUNPATH itself. Promoting
+        # the main RUNPATH to --library-path incorrectly makes it transitive.
+        command = [str(loader), "--inhibit-cache", "--library-path", str(root), str(binary)] + arguments
+        if instrument:
+            command = [str(Path(instrument).absolute())] + list(instrument_arguments) + command
+        return subprocess.run(command, env=environment).returncode
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", required=True)
+    parser.add_argument("--payload", action="append", default=[])
+    parser.add_argument("--instrument")
+    parser.add_argument("--instrument-arg", action="append", default=[])
+    parser.add_argument("arguments", nargs=argparse.REMAINDER)
+    options = parser.parse_args()
+    arguments = options.arguments[1:] if options.arguments[:1] == ["--"] else options.arguments
+    return run(options.binary, options.payload, arguments, options.instrument, options.instrument_arg)
+
+
+if __name__ == "__main__":
+    status = main()
+    if status < 0:
+        terminating_signal = -status
+        if terminating_signal not in (signal.SIGKILL, signal.SIGSTOP):
+            signal.signal(terminating_signal, signal.SIG_DFL)
+        signal.pthread_sigmask(signal.SIG_UNBLOCK, {terminating_signal})
+        os.kill(os.getpid(), terminating_signal)
+    raise SystemExit(status)
