diff --git a/tests/default_mtime/fixtures.bzl b/tests/default_mtime/fixtures.bzl
new file mode 100644
index 0000000..57554d0
--- /dev/null
+++ b/tests/default_mtime/fixtures.bzl
@@ -0,0 +1,69 @@
+"""Small native regression fixtures for tar's optional timestamp fallback."""
+
+load("@bazel_skylib//lib:unittest.bzl", "analysistest", "asserts")
+
+def _payload_impl(ctx):
+    out = ctx.actions.declare_file(ctx.label.name + ".txt")
+    coreutils = ctx.toolchains["@bazel_lib//lib:coreutils_toolchain_type"].coreutils_info.bin
+    ctx.actions.run_shell(
+        outputs = [out],
+        tools = [coreutils],
+        arguments = [coreutils.path, out.path, ctx.attr.mtime],
+        command = 'printf "same payload\\n" > "$2"; "$1" touch -d "@$3" "$2"',
+    )
+    return [DefaultInfo(files = depset([out]))]
+
+payload = rule(
+    implementation = _payload_impl,
+    attrs = {"mtime": attr.string(mandatory = True)},
+    toolchains = ["@bazel_lib//lib:coreutils_toolchain_type"],
+)
+
+def _manifest_impl(ctx):
+    out = ctx.actions.declare_file(ctx.label.name + ".mtree")
+    ctx.actions.write(out, ctx.attr.text.replace("{payload}", ctx.file.payload.path))
+    return [DefaultInfo(files = depset([out]))]
+
+manifest = rule(
+    implementation = _manifest_impl,
+    attrs = {
+        "payload": attr.label(allow_single_file = True),
+        "text": attr.string(),
+    },
+)
+
+def _rlocation(ctx, file):
+    path = file.short_path
+    return path[3:] if path.startswith("../") else ctx.workspace_name + "/" + path
+
+def _regression_test_impl(ctx):
+    bsdtar = ctx.toolchains["@tar.bzl//tar/toolchain:type"]
+    files = [ctx.file.script, ctx.file.normalizer, ctx.executable.awk, bsdtar.tarinfo.binary]
+    arguments = [_rlocation(ctx, f) for f in files]
+    for name, target in ctx.attr.archives.items():
+        files.extend(target[DefaultInfo].files.to_list())
+        arguments.extend([name, _rlocation(ctx, target[DefaultInfo].files.to_list()[0])])
+    script = ctx.actions.declare_file(ctx.label.name + ".sh")
+    ctx.actions.write(script, "#!/usr/bin/env bash\nset -euo pipefail\ncd \"$TEST_SRCDIR\"\nexec python3 " + " ".join(["'" + a + "'" for a in arguments]) + "\n", is_executable = True)
+    runfiles = ctx.runfiles(files = files).merge(ctx.attr.awk[DefaultInfo].default_runfiles)
+    runfiles = runfiles.merge(ctx.runfiles(transitive_files = bsdtar.default.files))
+    return [DefaultInfo(executable = script, runfiles = runfiles)]
+
+regression_test = rule(
+    implementation = _regression_test_impl,
+    test = True,
+    attrs = {
+        "archives": attr.string_keyed_label_dict(allow_files = True),
+        "awk": attr.label(default = "@gawk", cfg = "exec", executable = True),
+        "normalizer": attr.label(default = "//tar/private:default_mtime.awk", allow_single_file = True),
+        "script": attr.label(default = "test.py", allow_single_file = True),
+    },
+    toolchains = ["@tar.bzl//tar/toolchain:type"],
+)
+
+def _invalid_timestamp_test_impl(ctx):
+    env = analysistest.begin(ctx)
+    asserts.expect_failure(env, "default_mtime must be integer Unix seconds")
+    return analysistest.end(env)
+
+invalid_timestamp_test = analysistest.make(_invalid_timestamp_test_impl, expect_failure = True)
diff --git a/tests/default_mtime/test.py b/tests/default_mtime/test.py
new file mode 100644
index 0000000..20f51e7
--- /dev/null
+++ b/tests/default_mtime/test.py
@@ -0,0 +1,71 @@
+"""Exercise real tar actions and the mtree transformer with native BSD tar."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tarfile
+import tempfile
+
+normalizer, awk, bsdtar = (str(Path(p).resolve()) for p in sys.argv[1:4])
+archives = {name: Path(path) for name, path in zip(sys.argv[4::2], sys.argv[5::2])}
+def members(name):
+    with tarfile.open(archives[name]) as archive:
+        result = {m.name: m for m in archive.getmembers()}
+        for member in result.values():
+            if member.isfile():
+                assert archive.extractfile(member).read() == b"same payload\n"
+        return result
+
+assert archives["normalized_first"].read_bytes() == archives["normalized_second"].read_bytes()
+assert archives["raw_first"].read_bytes() != archives["raw_second"].read_bytes()
+assert members("raw_first")["usr/bin/payload"].mtime == 123456789
+assert members("raw_second")["usr/bin/payload"].mtime == 987654321
+entry = members("normalized_first")["usr/bin/payload"]
+assert (entry.mtime, entry.uid, entry.gid, entry.mode) == (1672560000, 12, 34, 0o640)
+entries = members("file_manifest")
+for name, timestamp in {
+    "inherited": 99, "zero": 0, "custom": 42, "fallback": 1672560000,
+    "continued": 123, "comment": 123, "escaped_backslash": 123, "continued_unset": 1672560000,
+    "all_unset": 1672560000, "space name": 1672560000,
+    "link": 1672560000, "link_zero": 0, "subdir": 1672560000,
+    "subdir/child": 1672560000,
+}.items():
+    assert entries[name].mtime == timestamp, (name, entries[name].mtime)
+    assert (entries[name].uid, entries[name].gid) == (12, 34)
+assert entries["subdir"].mode == 0o750
+assert entries["escaped_backslash"].linkname == "backslash" + chr(92)
+assert members("default_zero")["payload"].mtime == 0
+assert members("default_negative")["payload"].mtime == -42
+assert entries["link"].issym() and entries["link"].linkname == "fallback"
+assert entries["link_zero"].issym() and entries["link_zero"].linkname == "fallback"
+assert all(m.mtime == 1672560000 for m in members("automatic").values())
+assert members("pruned")["payload"].mtime == 1672560000
+unused = archives["unused_inputs"].read_text().splitlines()
+assert len(unused) == 1 and unused[0].endswith("second.txt"), unused
+assert not any("mtree" in item or "first.txt" in item for item in unused)
+
+# Direct normalization proves original paths, whitespace and metadata are opaque.
+# Only mtree fallback directives may be added; inherited times remain untouched.
+with tempfile.TemporaryDirectory() as directory:
+    root = Path(directory)
+    payload = root / "payload"
+    payload.write_bytes(b"same payload\n")
+    for ending in ("\n", "\r\n"):
+        source = root / "input.mtree"
+        original = f"#mtree\n\n  # comment\n/set time=0 uid=12 gid=34\nname\\040with\\040spaces\ttype=file mode=0640 content={payload}\n/unset \\\n all\nlast type=file uid=12 gid=34 mode=0640 content={payload}"
+        original = original.replace("\n", ending)
+        source.write_bytes(original.encode())
+        normalized = root / "normalized.mtree"
+        subprocess.run([awk, "-v", "default_mtime=1672560000", "-v", f"output={normalized}", "-f", normalizer, str(source)], check=True)
+        text = normalized.read_bytes().decode()
+        assert text.startswith("#mtree\n/set time=1672560000\n")
+        preserved = text[len("#mtree\n/set time=1672560000\n"):].replace("/set time=1672560000\n", "")
+        assert preserved.rstrip("\n") == original
+        for index, timestamp in enumerate((123456789, 987654321)):
+            os.utime(payload, (timestamp, timestamp))
+            subprocess.run([bsdtar, "-cf", str(root / f"archive{index}.tar"), "@" + str(normalized)], check=True)
+        assert (root / "archive0.tar").read_bytes() == (root / "archive1.tar").read_bytes()
+        with tarfile.open(root / "archive0.tar") as archive:
+            assert archive.getmember("name with spaces").mtime == 0
+            assert archive.getmember("last").mtime == 1672560000
+print("PASS: inline/generated manifests, explicit/inherited times, unset, LF/CRLF, continuations, metadata, reproducibility, opt-out and pruning")
