diff --git a/tar/private/default_mtime.awk b/tar/private/default_mtime.awk
new file mode 100644
index 0000000..563aa3e
--- /dev/null
+++ b/tar/private/default_mtime.awk
@@ -0,0 +1,33 @@
+# Supply an mtree fallback instead of rewriting file entries. libarchive
+# preserves explicit entry times and more recent /set time values itself.
+BEGIN {
+    print "#mtree" > output
+    print "/set time=" default_mtime > output
+}
+{
+    print $0 > output
+    line = $0
+    # libarchive accepts CRLF manifests; strip CR only from the directive scan.
+    sub(/\r$/, "", line)
+    # Escaped pairs represent literal backslashes; only an odd final slash
+    # continues the physical line in libarchive's mtree reader.
+    match(line, /\\+$/)
+    continued = (RLENGTH > 0 && RLENGTH % 2 == 1)
+    if (continued) sub(/\\$/, "", line)
+    logical = logical line
+    if (continued) next
+
+    # Examine only directives. Escaped names and entry attributes are opaque.
+    sub(/^[ \t]+/, "", logical)
+    count = split(logical, fields, /[ \t]+/)
+    if (fields[1] == "/unset") {
+        for (i = 2; i <= count; i++) {
+            if (fields[i] ~ /^#/) break
+            if (fields[i] == "time" || fields[i] == "all") {
+                print "/set time=" default_mtime > output
+                break
+            }
+        }
+    }
+    logical = ""
+}
