+)
+
+platform(
+    name = "arm64",
+    constraint_values = [
+        "@platforms//os:linux",
+        "@platforms//cpu:aarch64",
+    ],
+)
+
+payload(
+    name = "first",
+    mtime = "123456789",
+)
+
+payload(
+    name = "second",
+    mtime = "987654321",
+)
+
+[tar(
+    name = prefix + "_" + source,
+    srcs = [":" + source],
+    compress = "",
+    default_mtime = timestamp,
+    mtree = ["usr/bin/payload type=file uid=12 gid=34 mode=0640 content=$(location :" + source + ")"],
+) for prefix, timestamp in [
+    ("normalized", "1672560000"),
+    ("raw", ""),
+] for source in [
+    "first",
+    "second",
+]]
+
+manifest(
+    name = "generated",
+    payload = ":first",
+    text = """#mtree
+/set uid=12 gid=34 mode=0640 type=file time=99
+inherited content={payload}
+zero time=0 content={payload}
+custom time=42 content={payload}
+/unset time
+fallback content={payload}
+/set time=\\
+123
+continued content={payload}
+# /unset all must not reset the inherited timestamp.
+comment content={payload}
+escaped_backslash type=link link=backslash\\\\
+/unset \\
+ time
+continued_unset content={payload}
+/set time=8
+/unset all
+all_unset type=file uid=12 gid=34 mode=0640 content={payload}
+space\\040name type=file uid=12 gid=34 mode=0640 content={payload}
+link type=link uid=12 gid=34 mode=0777 link=fallback
+link_zero type=link uid=12 gid=34 mode=0777 time=0 link=fallback
+subdir type=dir uid=12 gid=34 mode=0750
+child type=file uid=12 gid=34 mode=0640 content={payload}
+..
+""",
+)
+
+tar_rule(
