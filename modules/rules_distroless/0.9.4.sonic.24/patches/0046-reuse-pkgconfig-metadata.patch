diff --git a/replacement-source/apt/private/pkgconfig_metadata.bzl b/apt/private/pkgconfig_metadata.bzl
new file mode 100644
index 0000000..299c569
--- /dev/null
+++ b/apt/private/pkgconfig_metadata.bzl
@@ -0,0 +1,91 @@
+"""Pure locked pkg-config graph data, independent of BUILD rendering."""
+
+load(":native_tools.bzl", "catalog_execute")
+load(":pkgconfig.bzl", "module_records", "pkgconfig_environment", "resolve_modules")
+load(":util.bzl", "util")
+
+def expand_module_metadata(rctx, state, load_package):
+    if not state["catalog"] or rctx.attr.package_key not in state["catalog"]:
+        return
+    context = state["catalog"][rctx.attr.package_key]
+    providers = {}
+    for key, package in state["catalog"].items():
+        if package["architecture"] == context["architecture"] and package["suite"] in context["family"]:
+            for module in package["modules"]:
+                providers.setdefault(module, []).append(key)
+    visited = {}
+    # Bootstrap providers from the named module's direct requirements. The SDK
+    # must not traverse dependencies before their locked providers are loaded.
+    # Full queries below still validate the completed graph and its versions.
+    for _ in range(len(providers) + len(state["documents"]) + 1):
+        records = module_records(state["documents"])
+        written = False
+        pending = [name for name in records if name not in visited]
+        if not pending:
+            break
+        for name in pending:
+            visited[name] = True
+            for option in ["--print-requires", "--print-requires-private"]:
+                cached = records[name].get("direct_requirements", {})
+                if option in cached and "alias" not in records[name]:
+                    requirements = cached[option]
+                else:
+                    if not written:
+                        for module, record in records.items():
+                            rctx.file("_pc_requirements/" + module + ".pc", record["content"].replace("${pcfiledir}", "/" + record["path"].rsplit("/", 1)[0]))
+                        written = True
+                    result = catalog_execute(rctx, "pkg-config", ["--maximum-traverse-depth=1", option, name], environment = pkgconfig_environment(rctx, "_pc_requirements"))
+                    requirements = result.stdout
+                for requirement in requirements.splitlines():
+                    required = requirement.strip().split(" ")[0] if requirement.strip() else ""
+                    if not required or required in records:
+                        continue
+                    matches = providers.get(required, [])
+                    local = [key for key in matches if state["catalog"][key]["suite"] == context["suite"]]
+                    matches = local or matches
+                    if len(matches) == 1:
+                        load_package(rctx, matches[0], state)
+                    elif len(matches) > 1:
+                        state["module_errors"][required] = "Ambiguous locked pkg-config providers for %s: %s" % (required, matches)
+
+def _load_leaf(rctx, filemap, state):
+    path = rctx.path(filemap)
+    owner = path.dirname.basename.removesuffix("_filemap")
+    if owner in state["loaded"]:
+        return
+    state["loaded"][owner] = True
+    for installed, record in json.decode(rctx.read(path.dirname.get_child("pkgconfig.json"))).items():
+        state["documents"].append(dict(record, path = installed, repo = owner, own = owner == state["own_repo"]))
+
+def _load_package(rctx, key, state):
+    for dependency in [key] + state["catalog"][key]["depends_on"]:
+        _load_leaf(rctx, Label("@@" + state["prefix"] + util.sanitize(dependency) + "_filemap//:filemap.json"), state)
+        if dependency not in state["extra_keys"]:
+            state["extra_keys"].append(dependency)
+
+def _metadata_impl(rctx):
+    owner = rctx.path(rctx.attr.own_filemap).dirname.basename.removesuffix("_filemap")
+    state = {"documents": [], "loaded": {}, "own_repo": owner, "prefix": owner.removesuffix(rctx.attr.target_name), "catalog": json.decode(rctx.read(rctx.attr.package_catalog)), "extra_keys": [], "module_errors": {}}
+    for filemap in [rctx.attr.own_filemap] + rctx.attr.dep_filemaps:
+        _load_leaf(rctx, filemap, state)
+    own_documents = {document["path"]: document["content"] for document in state["documents"] if document["own"] and "content" in document and "alias" not in document}
+    own_paths = [document["path"] for document in state["documents"] if document["own"]]
+    own_order_safe = len({path.rsplit("/", 1)[-1]: True for path in own_paths}) == len(own_paths)
+    # Multiple installed paths with one module basename use archive order in
+    # the legacy importer. Leave that uncommon input on its original path.
+    if own_order_safe:
+        expand_module_metadata(rctx, state, _load_package)
+    modules = resolve_modules(rctx, state["documents"], state["module_errors"]) if own_order_safe else {}
+    rctx.file("modules.json", json.encode({"modules": modules, "extra_keys": state["extra_keys"], "own_documents": own_documents, "own_order_safe": own_order_safe}))
+    rctx.file("BUILD.bazel", 'exports_files(["modules.json"], visibility = ["//visibility:public"])\n')
+
+pkgconfig_metadata = repository_rule(
+    implementation = _metadata_impl,
+    attrs = {
+        "own_filemap": attr.label(mandatory = True),
+        "dep_filemaps": attr.label_list(),
+        "package_catalog": attr.label(mandatory = True),
+        "package_key": attr.string(mandatory = True),
+        "target_name": attr.string(mandatory = True),
+    },
+)
