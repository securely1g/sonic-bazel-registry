+def expand_directory_aliases(groups, symlinks, directories):
+    """Publish in-package directory aliases as declared header leaf symlinks.
+
+    Bazel file inputs cannot name directory symlinks. Unlike materializing a
+    tree artifact, each alias leaf can link its already-declared target file.
+    Nested aliases expand before publication; cycles cannot grow output paths.
+    """
+    groups = [list(group) for group in groups]
+    links = dict(symlinks)
+    header_paths = {path: True for group in groups for path in group}
+    original = {path: target for path, target in symlinks.items() if path in header_paths}
+    directory_aliases = {}
+    for iteration in range(len(original) + 2):
+        changed = False
+        headers = [path for group in groups for path in group]
+        for alias, target in original.items():
+            seen = {alias: True}
+            for _ in range(len(original) + 1):
+                if target in seen:
+                    fail("Cyclic native header symlink: " + alias)
+                seen[target] = True
+                if target not in original:
+                    break
+                target = original[target]
+            if target in directories or any([path.startswith(target + "/") for path in headers]):
+                if alias.startswith(target + "/"):
+                    fail("Cyclic native header directory alias: " + alias)
+                if alias not in directory_aliases:
+                    directory_aliases[alias] = target
+                    changed = True
+        for index in range(len(groups)):
+            groups[index] = [path for path in groups[index] if path not in directory_aliases]
+        for alias, target in directory_aliases.items():
+            links.pop(alias, None)
+            for group in groups:
+                for path in list(group):
+                    if path.startswith(target + "/"):
+                        leaf = alias + path[len(target):]
+                        if leaf not in group:
+                            group.append(leaf)
+                            links[leaf] = path
+                            changed = True
+        if not changed:
+            return groups, links
+    fail("Cyclic native header directory aliases")
+
+def complete_header_parents(groups, depends_file_map, include_roots):
+    """Retain quoted sibling lookup when an installed directory spans packages.
+
+    Default include roots already search dependency repositories. Only deeper
+    logical parents need local leaf aliases; the original package TAR remains
+    unchanged and every alias refers to a declared dependency header output.
+    """
+    groups = [list(group) for group in groups]
+    own = {path: True for group in groups for path in group}
+    parents = {path.rsplit("/", 1)[0]: True for path in own}
+    roots = {path.removeprefix("/"): True for path in include_roots}
+    aliases = {}
+    for path, repo in depends_file_map.items():
+        parent = path.rsplit("/", 1)[0]
+        if path in own or parent not in parents or parent in roots:
+            continue
+        if path.endswith(".h") or is_include_fragment(path):
+            group = 0
+        elif path.endswith(".hpp"):
+            group = 1
+        elif "include/c++" in path or (path.startswith("usr/include/") and "." not in path.rsplit("/", 1)[-1]):
+            group = 2
+        else:
+            continue
+        groups[group].append(path)
+        aliases[path] = "@@%s//:%s" % (repo, path)
+    return groups, aliases
