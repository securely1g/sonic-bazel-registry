load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":architecture_test.bzl", "architecture_tests")
load(":headers_only.bzl", "headers_only")

package(default_visibility = ["//visibility:public"])

platform(
    name = "amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "armhf",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

# The contract under test is the compilation context exported by deb_import.
# Discard linker inputs so this header check does not link the runtime libraries.
headers_only(
    name = "protobuf_headers",
    dep = select({
        ":linux_amd64": "@registry_ci_protobuf_amd64//:libprotobuf",
        ":linux_arm64": "@registry_ci_protobuf_arm64//:libprotobuf",
    }),
)

cc_test(
    name = "protobuf_headers_test",
    srcs = ["protobuf_headers_test.cc"],
    deps = [":protobuf_headers"],
)

architecture_tests()
