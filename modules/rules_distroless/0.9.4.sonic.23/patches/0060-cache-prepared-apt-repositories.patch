diff -ruN a/apt/private/repository_cache.bzl b/apt/private/repository_cache.bzl
--- a/apt/private/repository_cache.bzl	1970-01-01 10:00:00.000000000 +1000
+++ b/apt/private/repository_cache.bzl	2026-11-19 18:24:49.691303915 +1100
@@ -0,0 +1,30 @@
+"""Reproducible, relocatable preparation of locked APT repositories."""
+
+load("@bazel_lib//lib:repo_utils.bzl", "repo_utils")
+
+def reproducible_repository(ctx):
+    """Keep compatibility with Bazel versions without repository metadata."""
+    if hasattr(ctx, "repo_metadata"):
+        return ctx.repo_metadata(reproducible = True)
+    return None
+
+def host_tar(ctx):
+    """Use tar.bzl's pinned repository-host archive tool."""
+    platform = repo_utils.platform(ctx)
+    return ctx.path(Label("@bsd_tar_toolchains_{}//:tar".format(platform)))
+
+def copy_archive_file(ctx, member, destination):
+    """Materialize a native alias without an output-base-absolute symlink."""
+    archives = [path for path in ctx.path(".").readdir() if path.basename.startswith("data.tar")]
+    if len(archives) != 1:
+        fail("Expected one Debian data archive")
+    directory, name = destination.rsplit("/", 1)
+    ctx.file(directory + "/.keep", "")
+    ctx.delete(directory + "/.keep")
+    replacement = name.replace("\\", "\\\\").replace("&", "\\&").replace("!", "\\!")
+    result = ctx.execute(
+        [host_tar(ctx), "-xf", archives[0], "-C", directory, "-s", "!^.*$!" + replacement + "!", "./" + member],
+        environment = {"LC_ALL": "C", "TZ": "UTC"},
+    )
+    if result.return_code:
+        fail("Cannot materialize native library %s: %s" % (destination, result.stderr))
