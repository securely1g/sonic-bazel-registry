diff --git a/apt/tests/linker_script_test.bzl b/apt/tests/linker_script_test.bzl
index 40f118f..ece5b3a 100644
--- a/apt/tests/linker_script_test.bzl
+++ b/apt/tests/linker_script_test.bzl
@@ -147,6 +147,34 @@ GROUP ( /lib/x86_64-linux-gnu/libc.so.6 /usr/lib/x86_64-linux-gnu/libc_nonshared
 
 remap_linkopts_test = unittest.make(_remap_linkopts_test)
 
+def _declared_paths_test(ctx):
+    env = unittest.begin(ctx)
+    source = "/* GNU ld script */ GROUP(/lib/libfoo.so /lib/libfoo.so.1 AS_NEEDED(-lm))"
+    resolved = linker_script.resolve_paths(
+        linker_script.files_to_remap(source),
+        self_files = {"usr/lib/libfoo.so": None},
+        depends_file_map = {"lib/libfoo.so.1": "runtime_repo"},
+        self_repo = "development_repo",
+    )
+    asserts.equals(env, {
+        "/lib/libfoo.so": ["development_repo", "usr/lib/libfoo.so"],
+        "/lib/libfoo.so.1": ["runtime_repo", "lib/libfoo.so.1"],
+    }, resolved.paths)
+    asserts.equals(env, [], resolved.unresolved)
+    # Prefix-related filenames must each map once; relative -l inputs stay intact.
+    rewritten = linker_script.rewrite(source, {
+        "/lib/libfoo.so": "build/development/lib/libfoo.so",
+        "/lib/libfoo.so.1": "build/runtime/lib/libfoo.so.1",
+    })
+    asserts.equals(env, "GROUP ( build/development/lib/libfoo.so build/runtime/lib/libfoo.so.1 AS_NEEDED ( -lm ) )\n", rewritten)
+    asserts.equals(env, [], linker_script.files_to_remap(rewritten))
+    missing = linker_script.resolve_paths(["/unknown/libfoo.so"], {}, {}, "self")
+    asserts.equals(env, ["/unknown/libfoo.so"], missing.unresolved)
+    return unittest.end(env)
+
+declared_paths_test = unittest.make(_declared_paths_test)
+
 def linker_script_tests():
+    declared_paths_test(name = _TEST_SUITE_PREFIX + "declared_paths")
     files_to_remap_test(name = _TEST_SUITE_PREFIX + "files_to_remap")
     remap_linkopts_test(name = _TEST_SUITE_PREFIX + "remap_linkopts")
