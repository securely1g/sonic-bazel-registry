diff --git a/apt/private/linker_script.bzl b/apt/private/linker_script.bzl
index f3f8720..4d61b92 100644
--- a/apt/private/linker_script.bzl
+++ b/apt/private/linker_script.bzl
@@ -152,6 +152,21 @@ def _resolve_installed_path(abs_path, self_files, depends_file_map, self_repo):
             return (depends_file_map[candidate], candidate)
     return (None, None)
 
+def _resolve_paths(referenced_paths, self_files, depends_file_map, self_repo):
+    paths = {}
+    unresolved = []
+    for abs_path in sorted({p: None for p in referenced_paths}.keys()):
+        repo, installed = _resolve_installed_path(abs_path, self_files, depends_file_map, self_repo)
+        if repo == None:
+            unresolved.append(abs_path)
+        else:
+            paths[abs_path] = [repo, installed]
+    return struct(paths = paths, unresolved = unresolved)
+
+def _rewrite(content, replacements):
+    # Replace whole filename tokens, preserving GROUP/AS_NEEDED ordering.
+    return " ".join([replacements.get(token, token) for token in _tokenize(content)]) + "\n"
+
 _REMAP_LINKOPT = "-Wl,--remap-inputs={abs}=$(BINDIR)/external/{repo}/{installed}"
 
