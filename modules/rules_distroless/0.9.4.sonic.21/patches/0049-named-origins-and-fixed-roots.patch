@@ -489,6 +489,28 @@
 
 _TEST_SUITE_PREFIX = "package_resolution/"
 
+def _resolve_exact_root_dependency_test(ctx):
+    env = unittest.begin(ctx)
+    idx = _make_index()
+    idx.add_package(package = "containerd.io", version = "1.7.28", dist = "docker-trixie")
+    idx.add_package(package = "containerd.io", version = "2.4.2", dist = "docker-trixie")
+    idx.add_package(package = "docker-ce", version = "28.5.2", depends = "containerd.io (>= 1.7.27)", dist = "docker-trixie")
+    root, dependencies, unmet, _ = idx.resolution.resolve_all(
+        name = "docker-ce", version = ("=", "28.5.2"), arch = _test_arch,
+        suites = ["docker-trixie"], constraints = {"containerd.io": "1.7.28"},
+    )
+    asserts.equals(env, "28.5.2", root["Version"])
+    asserts.equals(env, [("containerd.io", "1.7.28")], [(package["Package"], package["Version"]) for package in dependencies])
+    asserts.equals(env, [], unmet)
+    _, _, unmet, _ = idx.resolution.resolve_all(
+        name = "containerd.io", version = (">=", "2.0"), arch = _test_arch,
+        suites = ["docker-trixie"], constraints = {"containerd.io": "1.7.28"},
+    )
+    asserts.equals(env, [("containerd.io", (">=", "2.0"))], unmet)
+    return unittest.end(env)
+
+resolve_exact_root_dependency_test = unittest.make(_resolve_exact_root_dependency_test)
+
