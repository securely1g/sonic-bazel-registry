load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//registry_ci:headers_only.bzl", "headers_only")
load(":declared_headers_test.bzl", "declared_headers_test")

package(default_visibility = ["//visibility:public"])

headers_only(
    name = "boost_headers",
    dep = select({
        "//registry_ci:linux_amd64": "@registry_ci_boost_amd64//:libboost1.83",
        "//registry_ci:linux_arm64": "@registry_ci_boost_arm64//:libboost1.83",
    }),
)

filegroup(
    name = "sources",
    srcs = [
        "CMakeLists.txt",
        "probe.cc",
    ],
)

cmake(
    name = "probe",
    cache_entries = {"CMAKE_BUILD_TYPE": "Release"},
    lib_source = ":sources",
    out_binaries = ["template_headers"],
    out_include_dir = "",
    deps = [":boost_headers"],
)

declared_headers_test(
    name = "declared_headers_test",
    target_under_test = ":boost_headers",
)

write_file(
    name = "test_runner",
    out = "run.sh",
    content = [
        "#!/bin/sh",
        "set -eu",
        'exec "$1"',
    ],
    is_executable = True,
)

sh_test(
    name = "foreign_headers_test",
    srcs = [":test_runner"],
    args = ["$(rootpath :probe)"],
    data = [":probe"],
)
