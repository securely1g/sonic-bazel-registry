+def _shared_library_exports(rctx, target_name, so_files, o_files, script_linker_inputs, rpaths, depends_on, options):
+    # depends_on already contains the resolved package closure. Use leaf inputs,
+    # as Debian package dependencies can cycle (for example libc6 and libgcc).
+    runtime_deps = [
+        "@%s%s//:_runtime_link_inputs_wodeps" % (rctx.attr.repo_prefix, util.sanitize(dep))
+        for dep in depends_on
+    ]
+    content = """
+filegroup(
+    name = "_runtime_files_wodeps",
+    srcs = {runtime_files},
+    visibility = ["//visibility:public"],
+)
+
+cc_library(
+    name = "_runtime_link_inputs_wodeps",
+    deps = [":_so_libs"],
+    additional_linker_inputs = [":_runtime_files_wodeps"] + {extra_inputs},
+    linkopts = {linkopts},
+    data = [":_runtime_files_wodeps"],
+    visibility = ["//visibility:public"],
+)
+
+cc_library(
+    name = "_runtime_link_inputs",
+    deps = [":_runtime_link_inputs_wodeps"] + {runtime_deps},
+    visibility = ["//visibility:public"],
+)
+""".format(
+        runtime_files = so_files,
+        extra_inputs = {path: None for path in o_files + script_linker_inputs}.keys(),
+        # GNU ld scripts resolve INPUT/GROUP library names through -L;
+        # -rpath-link is only sufficient for ELF DT_NEEDED dependencies.
+        linkopts = [
+            "-L$(BINDIR)/external/%s/%s" % (rctx.attr.name, path)
+            for path in rpaths
+        ] + [
+            "-Wl,-rpath-link=$(BINDIR)/external/%s/%s" % (rctx.attr.name, path)
+            for path in rpaths
+        ],
+        runtime_deps = runtime_deps,
+    )
+    exports = {}
+    libraries = {}
+    for path in so_files if rctx.attr.package_name.endswith("-dev") else []:
+        basename = path.rsplit("/", 1)[-1]
+        if not basename.startswith("lib") or not basename.endswith(".so"):
+            continue
+        name = basename.removesuffix(".so")
+        if name in libraries and libraries[name] != path:
+            fail("Ambiguous shared library %s in %s: %s and %s" % (name, target_name, libraries[name], path))
+        libraries[name] = path
+
+    for name, path in sorted(libraries.items()):
+        pkgc = options.get(name)
+        content += """
+cc_import(
+    name = "_{name}_native_import",
+    shared_library = "{path}",
+)
+
+filegroup(
+    name = "{name}_shared",
+    srcs = ["{path}"],
+    visibility = ["//visibility:public"],
+)
+
+cc_library(
+    name = "{name}_cc",
+    deps = [":_{name}_native_import", ":{package}_headers", ":_runtime_link_inputs"],
+    defines = {defines},
+    linkopts = {linkopts},
+    visibility = ["//visibility:public"],
+)
+""".format(
+            name = name,
+            path = path,
+            package = target_name,
+            defines = pkgc.defines if pkgc else [],
+            linkopts = pkgc.linkopts if pkgc else [],
+        )
+        exports[name + "_cc"] = name + "_cc"
+        exports[name + "_shared"] = name + "_shared"
+    return (content, exports)
+
