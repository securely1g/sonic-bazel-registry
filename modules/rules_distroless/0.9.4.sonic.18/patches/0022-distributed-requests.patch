+def selected_lock_tags(mctx):
+    """A root lock is authoritative; dependency locks remain standalone defaults."""
+    imports = [(module, tag) for module in mctx.modules for tag in module.tags.import_lock if not tag.fallback]
+    roots = [(module, tag) for module, tag in imports if module.is_root]
+    if not roots:
+        defaults = [(module, tag) for module in mctx.modules if module.is_root for tag in module.tags.import_lock if tag.fallback]
+        roots = defaults
+        imports.extend(defaults)
+    selected = roots or imports
+    if roots and len({str(tag.lock): True for _, tag in roots}) != 1:
+        fail("select one production lock in the root module")
+    return (imports, selected)
+
+def _export_requests_impl(rctx):
+    rctx.file("requests.json", rctx.attr.content)
+    rctx.file("BUILD.bazel", 'exports_files(["requests.json"])\nfilegroup(name="requests", srcs=["requests.json"], visibility=["//visibility:public"])\n')
+
+_export_requests = repository_rule(
+    implementation = _export_requests_impl,
+    attrs = {"content": attr.string(mandatory = True)},
+)
+
+def _placeholder_impl(rctx):
+    rctx.file("BUILD.bazel", "# Request collection only; package repositories are not fetched.\n")
+
+_placeholder = repository_rule(implementation = _placeholder_impl)
+
+def _collection_repositories(mctx, installs, source_document):
+    # Bazel validates use_repo names even when only the request export is built.
+    # Declare their namespaces, without creating or downloading package inputs.
+    names = {install.dependency_set: True for install in installs if install.dependency_set}
+    for module in mctx.modules:
+        for tag in module.tags.import_lock:
+            if mctx.path(tag.lock).exists:
+                document = json.decode(mctx.read(tag.lock))
+                names.update({group: True for group in document.get("dependency_sets", {})})
+                names.update({util.sanitize(key): True for key in document.get("packages", {})})
+    for install in installs:
+        for request in install.packages:
+            constraint = version_constraint.parse_dep(request)
+            version = constraint["version"]
+            if not version or version[0] != "=":
+                continue
+            for source in source_document["sources"]:
+                for suite in source["suites"]:
+                    if install.suites and suite not in install.suites:
+                        continue
+                    for arch in constraint["arch"] or source["architectures"]:
+                        names[util.sanitize("/" + suite + "/" + constraint["name"] + ":" + arch + "=" + version[1])] = True
+    for name in names:
+        _placeholder(name = name)
+
+def export_requests(mctx, installs, source_document, name):
+    if source_document == None:
+        fail("request collection requires apt.sources_file")
+    _, selected = selected_lock_tags(mctx)
+    if not selected or not selected[0][0].is_root:
+        fail("workspace updates require apt.import_lock in the root module")
+    module, tag = selected[0]
+    if tag.lock.repo_name:
+        fail("workspace production lock must belong to the root module")
+    _collection_repositories(mctx, installs, source_document)
+    requests = requests_document(installs)
+    pinned = {}
+    for owner in mctx.modules:
+        files = [tag.file for tag in owner.tags.install_file]
+        files.extend([tag.requests for tag in owner.tags.import_lock if tag.requests])
+        for file in files:
+            for package in json.decode(mctx.read(file)).get("pinned_packages", []):
+                key = (package["suite"], package["name"], package["architecture"], package["version"])
+                if key in pinned and pinned[key] != package:
+                    fail("conflicting fixed package identity: " + str(key))
+                pinned[key] = package
+    if pinned:
+        requests["pinned_packages"] = [pinned[key] for key in sorted(pinned)]
+    views = []
+    for owner in mctx.modules:
+        if owner.is_root:
+            views.extend([{"file": str(mctx.path(view.file)), "dependency_sets": view.dependency_sets} for view in owner.tags.lock_view])
+    _export_requests(
+        name = name,
+        content = json.encode_indent({
+            "version": 1,
+            "sources": source_document,
+            "requests": requests,
+            "lock": str(mctx.path(tag.lock)),
+            "views": views,
+        }),
+    )
