+                content += 'native_link_sequence(name=%r, deps=%r, link_files=%r, link_sonames=%r, arguments=%r, dynamic_only=%r, visibility=["//visibility:public"])\n' % (target, deps + [":" + compiler], link_files, sonames, arguments, dynamic_only)
