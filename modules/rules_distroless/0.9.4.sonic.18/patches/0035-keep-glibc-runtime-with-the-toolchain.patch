+def _toolchain_c_runtime(repo, state):
+    # glibc and its companion DSOs must agree with the ELF interpreter chosen
+    # by the C/C++ toolchain. A transitive package dependency must not add a
+    # second C runtime to solib or a foreign build's ordinary dependency prefix.
+    # Identify the owning package by ELF metadata, independent of suite/arch.
+    return any([record.get("soname") == "libc.so.6" for record in state["native"].get(repo, {}).values()])
