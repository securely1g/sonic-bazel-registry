-        user_link_flags = depset([ctx.expand_make_variables("linkopts", opt, {}) for opt in ctx.attr.linkopts]),
+        # Include the generated SONAME symlinks too: interface-only linking
+        # does not otherwise make those -rpath-link paths action dependencies.
+        additional_inputs = depset(ctx.files.dynamic_libs + ctx.files.additional_linker_inputs + [library.dynamic_library for library in libraries]),
