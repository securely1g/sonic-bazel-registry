+def runtime_link_flags(libraries):
+    # A sysrooted linker cannot rely on the program's runtime RPATH to find
+    # indirect DT_NEEDED libraries. Search only the declared SONAME symlinks,
+    # without selecting those DSOs as direct libraries on the ordered link line.
+    directories = {library.dynamic_library.dirname: True for library in libraries if library.dynamic_library}
+    flags = []
+    for directory in directories:
+        flags.extend(["-Xlinker", "-rpath-link=" + directory])
+    return flags
 
 def _so_library_impl(ctx):
     cc_toolchain = find_cpp_toolchain(ctx)
