+def _load_leaf(rctx, filemap, state):
+    path = rctx.path(filemap)
+    owner = path.dirname.basename.removesuffix("_filemap")
+    if owner in state["files"]:
+        return owner
+    state["files"][owner] = json.decode(rctx.read(path))
+    state["file_count"] += len(state["files"][owner])
+    native_path = path.dirname.get_child("native.json")
+    state["native"][owner] = json.decode(rctx.read(native_path)) if native_path.exists else {}
+    for installed, record in json.decode(rctx.read(path.dirname.get_child("pkgconfig.json"))).items():
+        state["documents"].append(dict(record, path = installed, repo = owner, own = owner == rctx.attr.name))
+    if owner != rctx.attr.name:
+        for installed in state["files"][owner]:
+            state["provided"].setdefault(installed, owner)
+    return owner
+
+def _load_package_key(rctx, key, state):
+    catalog = state["catalog"]
+    for dependency in [key] + catalog[key]["depends_on"]:
+        label = Label("@@" + state["prefix"] + util.sanitize(dependency) + "_filemap//:filemap.json")
+        _load_leaf(rctx, label, state)
+        if dependency not in state["extra_keys"]:
+            state["extra_keys"].append(dependency)
+
+def _expand_module_metadata(rctx, state):
+    if not state["catalog"] or rctx.attr.package_key not in state["catalog"]:
+        return
+    context = state["catalog"][rctx.attr.package_key]
+    providers = {}
+    for key, package in state["catalog"].items():
+        if package["architecture"] == context["architecture"] and package["suite"] in context["family"]:
+            for module in package["modules"]:
+                providers.setdefault(module, []).append(key)
+    visited = {}
+    # Print-requires inspects only the named module; the SDK expands variables,
+    # continuation lines and version syntax without needing its dependencies.
+    for _ in range(len(providers) + len(state["documents"]) + 1):
+        records = module_records(state["documents"])
+        for name, record in records.items():
+            rctx.file("_pc_requirements/" + name + ".pc", record["content"].replace("${pcfiledir}", "/" + record["path"].rsplit("/", 1)[0]))
+        pending = [name for name in records if name not in visited]
+        if not pending:
+            break
+        for name in pending:
+            visited[name] = True
+            for option in ["--print-requires", "--print-requires-private"]:
+                result = rctx.execute(["pkg-config", option, name], environment = pkgconfig_environment(rctx, "_pc_requirements"))
+                for requirement in result.stdout.splitlines():
+                    required = requirement.strip().split(" ")[0] if requirement.strip() else ""
+                    if not required or required in records:
+                        continue
+                    matches = providers.get(required, [])
+                    local = [key for key in matches if state["catalog"][key]["suite"] == context["suite"]]
+                    matches = local or matches
+                    if len(matches) == 1:
+                        _load_package_key(rctx, matches[0], state)
+                    elif len(matches) > 1:
+                        state["module_errors"][required] = "Ambiguous locked pkg-config providers for %s: %s" % (required, matches)
