+# A module's ordered link line is one contract. Its declared files and runtime
+# libraries travel with one library-bearing input through shared-library edges.
+def _native_link_sequence_impl(ctx):
+    merged = cc_common.merge_cc_infos(cc_infos = [dep[CcInfo] for dep in ctx.attr.deps])
+    toolchain = find_cpp_toolchain(ctx)
+    features = cc_common.configure_features(ctx = ctx, cc_toolchain = toolchain, requested_features = ctx.features, unsupported_features = ctx.disabled_features)
+    runtime = {}
+    files = {file: True for file in ctx.files.link_files}
+    for item in merged.linking_context.linker_inputs.to_list():
+        for file in item.additional_inputs:
+            files[file] = True
+        for library in item.libraries:
+            if not library.dynamic_library:
+                continue
+            file = library.resolved_symlink_dynamic_library or library.dynamic_library
+            name = library.dynamic_library.basename
+            if name in runtime and runtime[name] != file:
+                fail("Ambiguous native shared library " + name + ": " + str(runtime[name]) + " and " + str(file))
+            runtime[name] = file
+    libraries = []
+    runtime_links = {}
+    for name, file in runtime.items():
+        directory = ctx.label.name + "/_runtime/" + file.path
+        interface = ctx.actions.declare_file(directory + "/rpath.ifso")
+        ctx.actions.write(interface, "/* Runtime metadata; link selection follows the pkg-config sequence. */\n")
+        solib = "apt/" + ctx.label.repo_name + "/_module/" + directory
+        library = cc_common.create_library_to_link(
+            actions = ctx.actions,
+            cc_toolchain = toolchain,
+            feature_configuration = features,
+            dynamic_library = file,
+            interface_library = interface,
+            dynamic_library_symlink_path = solib + "/" + name,
+            interface_library_symlink_path = solib + "/rpath.ifso",
+        )
+        libraries.append(library)
+        runtime_links[name] = library.dynamic_library
+        files[library.dynamic_library] = True
+        files[file] = True
+    args = []
+    for token in ctx.attr.arguments:
+        if token.startswith("$FILE:"):
+            index = int(token.removeprefix("$FILE:"))
+            file = ctx.attr.link_files[index][DefaultInfo].files.to_list()[0]
+            soname = ctx.attr.link_sonames[index]
+            if soname and soname in runtime_links:
+                args.extend(["-L" + runtime_links[soname].dirname, "-l:" + soname])
+            else:
+                args.append(file.path)
+        else:
+            args.append(token.replace("$(BINDIR)", ctx.bin_dir.path))
+    anchor = ctx.actions.declare_file(ctx.label.name + "/linkopts.a")
+    ctx.actions.write(anchor, "/* Ordered pkg-config link contract. */\n")
+    libraries.append(cc_common.create_library_to_link(actions = ctx.actions, static_library = anchor))
+    linker = cc_common.create_linker_input(owner = ctx.label, libraries = depset(libraries), additional_inputs = depset(files.keys()), user_link_flags = args)
+    runfiles = ctx.runfiles(files = runtime.values())
+    for dep in ctx.attr.deps:
+        runfiles = runfiles.merge(dep[DefaultInfo].default_runfiles)
+    return [CcInfo(compilation_context = merged.compilation_context, linking_context = cc_common.create_linking_context(linker_inputs = depset([linker]))), DefaultInfo(runfiles = runfiles)]
+
