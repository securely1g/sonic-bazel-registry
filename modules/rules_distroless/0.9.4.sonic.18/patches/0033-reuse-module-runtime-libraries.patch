 load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cpp_toolchain", "use_cc_toolchain")
+
+def runtime_library(ctx, toolchain, features, file):
+    # All consumers of the same installed DSO share one runtime identity. The
+    # source interface script makes identical symlink actions reusable across
+    # package and module targets without changing ordered link selection.
+    directory = "apt/runtime/" + file.short_path.removeprefix("../").rsplit("/", 1)[0]
+    return cc_common.create_library_to_link(
+        actions = ctx.actions,
+        cc_toolchain = toolchain,
+        feature_configuration = features,
+        dynamic_library = file,
+        interface_library = ctx.file._runtime_interface,
+        dynamic_library_symlink_path = directory + "/" + file.basename,
+        interface_library_symlink_path = directory + "/rpath.ifso",
+    )
 
