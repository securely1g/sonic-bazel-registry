+def declare_legacy_locked_imports(mctx, existing_sets):
+    """Reuse deb_import/deb_postfix and the hub generator without index resolution.
+
+    Runtime imports intentionally do not publish C++ compilation targets: a
+    version-2 lock contains archive identities, not Debian Contents-index maps.
+    Ordinary apt.install keeps its existing compiler/header exports.
+    """
+    declared = {name: True for name in existing_sets}
+    imports, _ = selected_lock_tags(mctx, require_one_root_lock = False)
+    for module, tag in imports:
+        document = json.decode(mctx.read(tag.lock))
+        for group, definition in expanded_sets(document, tag.dependency_sets).items():
+            if group in declared:
+                fail("APT dependency set is already declared: " + group)
+            declared[group] = True
+            prefix = "locked_import_" + group + "_"
+            selected = {key + "=" + version: True for roots in definition["sets"].values() for key, version in roots.items()}
+            imported_packages = {
+                key: dict(document["packages"][key], depends_on = [
+                    dependency
+                    for dependency in reachable_packages(document["packages"], [key])
+                    if dependency != key
+                ])
+                for key in selected
+            }
+            package_repositories = {}
+            for key in selected:
+                name = prefix + util.sanitize(key)
+                if name in package_repositories:
+                    fail("locked APT package repository names collide: " + key)
+                package_repositories[name] = True
+                package = imported_packages[key]
+                deb_import(
+                    name = name,
+                    target_name = name,
+                    urls = [uri.rstrip("/") + "/" + package["filename"] for uri in document["sources"][package["suite"]]["uris"]],
+                    sha256 = package["sha256"],
+                    package_name = package["name"],
+                    depends_on = package["depends_on"],
+                    repo_prefix = prefix,
+                    payload_only = True,
+                    mergedusr = False,
+                )
+            locked = dict(document, packages = imported_packages, dependency_sets = {group: definition})
+            translate_dependency_set(
+                name = group,
+                depset_name = group,
+                lock_content = json.encode(locked),
+                repo_prefix = prefix,
+                payload_only = True,
+            )
--- a/apt/tests/locked_import_test.bzl
+++ b/apt/tests/locked_import_test.bzl
@@ -1,6 +1,7 @@
 """Test locked runtime imports before network access or repository declarations."""
 
 load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+load("//apt/private:configuration.bzl", "selected_lock_tags", "uses_unified_lock")
 load("//apt/private:locked_import.bzl", "expanded_sets", "reachable_packages", "validation_error")
 
 _ROOT = "/trixie/app:amd64=1.0"
@@ -91,7 +92,65 @@
 
 selection_test = unittest.make(_selection_test)
 
+def _import_tag(lock, libraries = False, sources = None, requests = None, fallback = False):
+    return struct(lock = lock, dependency_sets = [], libraries = libraries, sources = sources, requests = requests, fallback = fallback)
+
+def _module(root, imports, install_file = [], lock_view = []):
+    return struct(is_root = root, tags = struct(
+        import_lock = imports,
+        install_file = install_file,
+        lock_view = lock_view,
+        export_lock = [],
+        export_requests = [],
+    ))
+
+def _read_lock_fixture(label):
+    document = _fixture()
+    if label == "canonical":
+        document["_inputs"] = {}
+    elif label == "cli":
+        document["dependency_sets"] = {"cli": document["dependency_sets"]["image"]}
+    return json.encode(document)
+
+def _routing_test(ctx):
+    env = unittest.begin(ctx)
+    root = _module(True, [_import_tag("image"), _import_tag("cli")])
+    child = _module(False, [_import_tag("cli")])
+    mctx = struct(modules = [root, child], read = _read_lock_fixture)
+    imports, selected = selected_lock_tags(mctx, require_one_root_lock = False)
+    asserts.equals(env, 3, len(imports))
+    asserts.equals(env, ["image", "cli"], [tag.lock for _, tag in selected])
+    asserts.false(env, uses_unified_lock(mctx))
+
+    # An ignored dependency fallback cannot opt a legacy root into unified mode.
+    ignored = _module(False, [_import_tag("canonical", libraries = True, fallback = True)])
+    asserts.false(env, uses_unified_lock(struct(modules = [root, ignored], read = _read_lock_fixture)))
+    for tag in [
+        _import_tag("canonical"),
+        _import_tag("image", libraries = True),
+        _import_tag("image", sources = "sources.json"),
+        _import_tag("image", requests = "requests.json"),
+        _import_tag("image", fallback = True),
+    ]:
+        asserts.true(env, uses_unified_lock(struct(modules = [_module(True, [tag])], read = _read_lock_fixture)))
+    for module in [
+        _module(True, [_import_tag("image")], lock_view = ["view"]),
+        _module(False, [_import_tag("image")], install_file = ["requests"]),
+    ]:
+        asserts.true(env, uses_unified_lock(struct(modules = [module], read = _read_lock_fixture)))
+    asserts.true(env, uses_unified_lock(mctx, {"sources": []}))
+
+    # Explicit root selection still overrides a root fallback and dependency lock.
+    root = _module(True, [_import_tag("canonical"), _import_tag("image", fallback = True)])
+    imports, selected = selected_lock_tags(struct(modules = [root, child]))
+    asserts.equals(env, ["canonical", "cli"], [tag.lock for _, tag in imports])
+    asserts.equals(env, ["canonical"], [tag.lock for _, tag in selected])
+    return unittest.end(env)
+
+routing_test = unittest.make(_routing_test)
+
 def locked_import_tests():
     closure_test(name = "locked_import/closure")
     invalid_lock_test(name = "locked_import/invalid_lock")
     selection_test(name = "locked_import/selection")
+    routing_test(name = "locked_import/routing")
