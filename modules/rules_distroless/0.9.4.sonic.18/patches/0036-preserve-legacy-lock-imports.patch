+def selected_lock_tags(mctx, require_one_root_lock = True):
     """A root lock is authoritative; dependency locks remain standalone defaults."""
     imports = [(module, tag) for module in mctx.modules for tag in module.tags.import_lock if not tag.fallback]
     roots = [(module, tag) for module, tag in imports if module.is_root]
@@ -107,9 +107,29 @@
         roots = defaults
         imports.extend(defaults)
     selected = roots or imports
-    if roots and len({str(tag.lock): True for _, tag in roots}) != 1:
+    if require_one_root_lock and roots and len({str(tag.lock): True for _, tag in roots}) != 1:
         fail("select one production lock in the root module")
     return (imports, selected)
+
+def uses_unified_lock(mctx, source_document = None):
+    """Keep legacy per-lock imports unless the workspace selects unified inputs."""
+    imports, selected = selected_lock_tags(mctx, require_one_root_lock = False)
+    if source_document != None:
+        return True
+    for module in mctx.modules:
+        if module.tags.install_file:
+            return True
+        if module.is_root and (module.tags.lock_view or module.tags.export_lock or module.tags.export_requests):
+            return True
+    # Use effective tags: an ignored dependency fallback must not change modes.
+    for _, tag in imports:
+        if tag.libraries or tag.sources or tag.requests or tag.fallback:
+            return True
+    # Canonical locks already carry their reviewed unified input identity.
+    for _, tag in selected:
+        if "_inputs" in json.decode(mctx.read(tag.lock)):
+            return True
+    return False
 
 def _export_requests_impl(rctx):
     rctx.file("requests.json", rctx.attr.content)
