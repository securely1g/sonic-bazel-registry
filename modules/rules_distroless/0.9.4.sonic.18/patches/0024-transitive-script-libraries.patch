diff --git a/apt/private/deb_export.bzl b/apt/private/deb_export.bzl
--- a/apt/private/deb_export.bzl
+++ b/apt/private/deb_export.bzl
@@ -60,7 +60,11 @@
         if script.get("unresolved"):
             fail("Unresolved linker-script inputs for %s: %s" % (installed, script["unresolved"]))
         replacements = {
-            source: ctx.bin_dir.path + "/external/" + destination[0] + "/" + destination[1]
+            # A dependent cc_shared_library forwards DSOs through _solib;
+            # original extraction paths are no longer link-action inputs.
+            # Refer to the declared native DSO imports by exact filename so
+            # the linker's generated _solib search paths remain authoritative.
+            source: ("-l:" + destination[1].rsplit("/", 1)[-1]) if (destination[1].endswith(".so") or ".so." in destination[1]) else ctx.bin_dir.path + "/external/" + destination[0] + "/" + destination[1]
             for source, destination in script["paths"].items()
         }
         ctx.actions.write(output, linker_script.rewrite(script["content"], replacements))
