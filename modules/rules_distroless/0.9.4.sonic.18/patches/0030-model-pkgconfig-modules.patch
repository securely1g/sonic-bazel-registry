+def resolve_modules(rctx, documents):
+    """Use pkg-config on pinned leaf metadata, never on host-installed modules."""
+    by_path = {}
+    for document in documents:
+        by_path.setdefault(document["path"], document)
+    records = {}
+    for document in documents:
+        source = document
+        seen = {}
+        for _ in range(len(by_path) + 1):
+            if "content" in source:
+                break
+            path = source.get("alias")
+            if not path or path in seen or path not in by_path:
+                source = {}
+                break
+            seen[path] = True
+            source = by_path[path]
+        if "content" not in source:
+            continue
+        name = document["path"].rsplit("/", 1)[-1].removesuffix(".pc")
+        if name not in records or document["own"]:
+            records[name] = dict(document, content = source["content"])
+    for name, record in records.items():
+        installed_dir = "/" + record["path"].rsplit("/", 1)[0]
+        rctx.file("_pkgconfig_modules/" + name + ".pc", record["content"].replace("${pcfiledir}", installed_dir))
+    environment = {
+        "PKG_CONFIG_LIBDIR": str(rctx.path("_pkgconfig_modules")),
+        "PKG_CONFIG_PATH": "",
+        "PKG_CONFIG_SYSROOT_DIR": "",
+        "PKG_CONFIG_ALLOW_SYSTEM_CFLAGS": "1",
+        "PKG_CONFIG_ALLOW_SYSTEM_LIBS": "1",
+        "PKG_CONFIG_DISABLE_UNINSTALLED": "1",
+    }
+    resolved = {}
+    for name, record in sorted(records.items()):
+        if not record["own"]:
+            continue
+        modes = {}
+        for mode in ["dynamic", "static"]:
+            options = ["--static"] if mode == "static" else []
+            libs = rctx.execute(["pkg-config"] + options + ["--libs", name], environment = environment)
+            cflags = rctx.execute(["pkg-config"] + options + ["--cflags", name], environment = environment)
+            if libs.return_code or cflags.return_code:
+                modes[mode] = {"error": "pkg-config module %s (%s): %s%s" % (name, mode, libs.stderr, cflags.stderr)}
+            else:
+                parsed = process_pcconfig(({"Libs": libs.stdout, "Cflags": cflags.stdout}, {}), infer_includes = False)
+                modes[mode] = {"libnames": parsed[0], "linkopts": parsed[3], "link_paths": parsed[4], "includes": parsed[5], "defines": parsed[6]}
+        libraries = {libname: True for flags in modes.values() for libname in flags.get("libnames", [])}.keys()
+        resolved[name] = {"modes": modes, "own_libnames": libraries}
+    return resolved
