+def _native_library_group_impl(ctx):
+    infos = [dep[CcInfo] for dep in ctx.attr.deps]
+    merged = cc_common.merge_cc_infos(cc_infos = infos)
+    inputs = []
+    names = {}
+    for item in merged.linking_context.linker_inputs.to_list():
+        for library in item.libraries:
+            if library.dynamic_library:
+                file = library.resolved_symlink_dynamic_library or library.dynamic_library
+                name = library.dynamic_library.basename
+                if name in names and names[name] != file:
+                    fail("Ambiguous native shared library " + name + ": " + str(names[name]) + " and " + str(file))
+                names[name] = file
+        inputs.append(cc_common.create_linker_input(
+            owner = item.owner,
+            libraries = depset(item.libraries),
+            additional_inputs = depset(item.additional_inputs),
+            user_link_flags = depset(item.user_link_flags + ctx.attr.linkopts),
+        ))
+    runfiles = ctx.runfiles()
+    for dep in ctx.attr.deps:
+        runfiles = runfiles.merge(dep[DefaultInfo].default_runfiles)
+    return [
+        CcInfo(compilation_context = merged.compilation_context, linking_context = cc_common.create_linking_context(linker_inputs = depset(inputs))),
+        DefaultInfo(runfiles = runfiles),
+    ]
+
+native_library_group = rule(
+    implementation = _native_library_group_impl,
+    attrs = {
+        "deps": attr.label_list(providers = [CcInfo]),
+        "linkopts": attr.string_list(),
+    },
+    provides = [CcInfo],
+)
+
+
+def _native_linker_script_impl(ctx):
+    # GNU ld accepts text scripts as archive inputs. A static LibraryToLink
+    # keeps the script and its declared files in this link, while dynamic_deps
+    # forwards only the resulting DSO instead of replaying the script.
+    script = ctx.actions.declare_file(ctx.label.name + ".a")
+    ctx.actions.symlink(output = script, target_file = ctx.file.src)
+    files = {file: True for file in ctx.files.inputs}
+    names = {}
+    runfiles = ctx.runfiles()
+    for dep in ctx.attr.deps:
+        for file in dep[DefaultInfo].files.to_list():
+            files[file] = True
+            if "/_native/" in file.path:
+                if file.basename in names and names[file.basename] != file:
+                    fail("Ambiguous native shared library " + file.basename)
+                names[file.basename] = file
+        for item in dep[CcInfo].linking_context.linker_inputs.to_list():
+            for file in item.additional_inputs:
+                files[file] = True
+            for library in item.libraries:
+                if library.dynamic_library:
+                    file = library.resolved_symlink_dynamic_library or library.dynamic_library
+                    name = library.dynamic_library.basename
+                    if name in names and names[name] != file:
+                        fail("Ambiguous native shared library " + name)
+                    names[name] = file
+                    files[file] = True
+        runfiles = runfiles.merge(dep[DefaultInfo].default_runfiles)
+    library = cc_common.create_library_to_link(actions = ctx.actions, static_library = script)
+    linker = cc_common.create_linker_input(owner = ctx.label, libraries = depset([library]), additional_inputs = depset(files.keys()))
+    return [
+        CcInfo(linking_context = cc_common.create_linking_context(linker_inputs = depset([linker]))),
+        DefaultInfo(files = depset([script] + files.keys()), runfiles = runfiles),
+    ]
+
+native_linker_script = rule(
+    implementation = _native_linker_script_impl,
+    attrs = {
+        "src": attr.label(allow_single_file = True, mandatory = True),
+        "inputs": attr.label_list(allow_files = True),
+        "deps": attr.label_list(providers = [CcInfo]),
+    },
+    provides = [CcInfo],
+)
