diff --git a/apt/private/native_tools.bzl b/apt/private/native_tools.bzl
new file mode 100644
index 000000000..3811852c7
--- /dev/null
+++ b/apt/private/native_tools.bzl
@@ -0,0 +1,96 @@
+"""Bootstrap the APT catalog's native inspection tools without importing APT."""
+
+# Import data from a landed build-infra revision. Making this rule depend on the
+# generated APT repositories would require these tools to fetch themselves.
+_LOCK_URL = "https://raw.githubusercontent.com/securely1g/sonic-build-infra/08e0956f80574b27a9b68e72fe855cc0089058e5/apt/apt.lock.json"
+_LOCK_SHA256 = "10c93aded0d9123c052a8e02c40264e8138da881122136affdf4db0d6647ad31"
+_HOSTS = {
+    "amd64": ("amd64", "x86_64-linux-gnu", "ld-linux-x86-64.so.2"),
+    "x86_64": ("amd64", "x86_64-linux-gnu", "ld-linux-x86-64.so.2"),
+    "arm64": ("arm64", "aarch64-linux-gnu", "ld-linux-aarch64.so.1"),
+    "aarch64": ("arm64", "aarch64-linux-gnu", "ld-linux-aarch64.so.1"),
+}
+
+def unlocked_library(listing, root):
+    """Return the first dependency the host loader selected outside the tool root."""
+    for entry in listing.splitlines():
+        entry = entry.strip()
+        # Linux supplies the vDSO directly to every process.
+        if entry.startswith("linux-vdso.so.1 ("):
+            continue
+        # Explicit preload paths can lack the usual "SONAME => " prefix.
+        resolved = entry.split(" => ", 1)[-1]
+        if not resolved.startswith(root + "/"):
+            return entry
+    return None
+
+def _native_tools_impl(ctx):
+    if ctx.os.name != "linux" or ctx.os.arch not in _HOSTS:
+        fail("The SONiC native APT catalog requires an AMD64 or ARM64 Linux host, got %s %s" % (ctx.os.name, ctx.os.arch))
+    arch, triplet, loader = _HOSTS[ctx.os.arch]
+    ctx.download(_LOCK_URL, "apt.lock.json", sha256 = _LOCK_SHA256)
+    lock = json.decode(ctx.read("apt.lock.json"))
+    packages = lock["packages"]
+    roots = ["pkgconf-bin", "file", "binutils-" + triplet.replace("_", "-")]
+    selected = {k: True for k, p in packages.items() if p["suite"] == "trixie" and p["architecture"] == arch and p["name"] in roots}
+    if len(selected) != len(roots):
+        fail("Incomplete catalog tool roots for %s" % arch)
+    pending = selected.keys()
+    for _ in range(len(packages)):
+        if not pending:
+            break
+        children = {}
+        for key in pending:
+            for dep in packages[key]["depends_on"]:
+                if dep not in selected:
+                    children[dep] = True
+        selected.update(children)
+        pending = children.keys()
+
+    for key in sorted(selected):
+        package = packages[key]
+        urls = [uri.rstrip("/") + "/" + package["filename"] for uri in lock["sources"][package["suite"]]["uris"]]
+        # Use the ordinary Bazel downloader so trusted builds retain their
+        # configured snapshot mirror preference and public fallback.
+        ctx.download_and_extract(urls, "unpack", sha256 = package["sha256"], type = "deb")
+        data = [f for f in ctx.path("unpack").readdir() if f.basename.startswith("data.tar")]
+        if len(data) != 1:
+            fail("Expected one data archive in %s" % key)
+        ctx.extract(data[0], "sysroot")
+        ctx.delete("unpack")
+
+    lib = "sysroot/usr/lib/" + triplet
+    ctx.symlink(lib, "lib")
+    ctx.symlink(lib + "/" + loader, "loader")
+    ctx.symlink("sysroot/usr/lib/file/magic.mgc", "magic.mgc")
+    programs = {"file": "file", "pkg-config": "pkgconf", "readelf": triplet + "-readelf"}
+    for name, program in programs.items():
+        ctx.symlink("sysroot/usr/bin/" + program, name)
+        # glibc may fall back to system directories after --library-path.
+        # Reject any such resolution before making the tools available.
+        check = ctx.execute(
+            [ctx.path("loader"), "--inhibit-cache", "--library-path", ctx.path("lib"), "--list", ctx.path(name)],
+            environment = _tool_environment(),
+        )
+        if check.return_code:
+            fail("Cannot resolve %s dependencies: %s" % (name, check.stderr))
+        outside = unlocked_library(check.stdout, str(ctx.path(".")))
+        if outside != None:
+            fail("%s resolved outside its locked execution root: %s" % (name, outside))
+    ctx.file("ROOT", "", executable = False)
+    ctx.file("BUILD.bazel", 'exports_files(["ROOT"])\n')
+
+native_tools_repository = repository_rule(implementation = _native_tools_impl)
+
+def _tool_environment():
+    return {"GLIBC_TUNABLES": "", "LC_ALL": "C", "LD_AUDIT": "", "LD_LIBRARY_PATH": "", "LD_PRELOAD": "", "PATH": ""}
+
+def catalog_execute(ctx, name, args, environment = {}):
+    """Run a catalog tool using the locked loader, libraries and magic database."""
+    root = ctx.path(Label("@distroless_native_tools//:ROOT")).dirname
+    argv = [root.get_child("loader"), "--inhibit-cache", "--library-path", root.get_child("lib"), root.get_child(name)]
+    if name == "file":
+        argv.extend(["-m", root.get_child("magic.mgc")])
+    env = dict(environment)
+    env.update(_tool_environment())
+    return ctx.execute(argv + args, environment = env)
