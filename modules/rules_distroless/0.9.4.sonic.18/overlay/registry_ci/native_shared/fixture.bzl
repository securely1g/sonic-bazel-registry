"""Repository-root fixture matching the package layout generated by deb_import."""

def _fixture_impl(rctx):
    for name in ["BUILD.fixture", "leaf.c", "middle.c"]:
        source = Label("//registry_ci/native_shared:" + name)
        rctx.symlink(rctx.path(source), "BUILD.bazel" if name == "BUILD.fixture" else name)

native_shared_fixture = repository_rule(implementation = _fixture_impl)
