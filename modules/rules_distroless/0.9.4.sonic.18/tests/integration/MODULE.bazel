"""Exercise locked APT imports from an independent consumer module."""

module(name = "locked_import_integration")

bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.18")
# Exercise the version selected by the gNMI consumer on Bazel 8.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Both namespaces import the same reviewed archive graph independently.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(lock = "//:apt.lock.json")
use_repo(apt, "locked_import_ci", "locked_import_ci_copy")

# Retain the legacy import above, and exercise the same archive graph through
# the root fallback path that selects one unified prepared lock for both groups.
shared_lock_fixture = use_repo_rule("//:shared_lock_fixture.bzl", "shared_lock_fixture")
shared_lock_fixture(name = "shared_lock_fixture", lock = "//:apt.lock.json")

unified_apt = use_extension("@rules_distroless//registry_ci:locked_imports.bzl", "apt")
unified_apt.import_lock(lock = "@shared_lock_fixture//:apt.lock.json", fallback = True)
use_repo(
    unified_apt,
    unified_locked_import_ci = "locked_import_ci",
    unified_locked_import_ci_copy = "locked_import_ci_copy",
    unified_netbase_only = "apt_internal_package_catalog_0",
)
