+"""Prepare immutable DEB archive members independently of package consumers."""
+
+def _archive_impl(ctx):
+    ctx.download(ctx.attr.urls, "package.deb", sha256 = ctx.attr.sha256)
+    ctx.extract("package.deb")
+    files = sorted([p.basename for p in ctx.path(".").readdir() if p.basename != "package.deb"])
+    data = [name for name in files if name.startswith("data.tar")]
+    if len(data) != 1:
+        fail("DEB must contain exactly one data archive: " + str(data))
+    ctx.file("members.json", json.encode({"files": files, "data": data[0]}))
+    ctx.file("BUILD.bazel", """
+load("@rules_distroless//apt/private:deb_postfix.bzl", "deb_postfix")
+
+package(default_visibility = ["//visibility:public"])
+exports_files(["members.json", "package.deb"] + {files})
+filegroup(name = "deb", srcs = ["package.deb"])
+filegroup(name = "raw_data", srcs = [{data}])
+filegroup(name = "control", srcs = {control})
+deb_postfix(name = "data", srcs = [{data}], outs = ["content.tar.gz"], mergedusr = False)
+""".format(files = repr(files), data = repr(data[0]), control = repr([name for name in files if name.startswith("control.tar.")])))
+
+
+deb_archive = repository_rule(
+    implementation = _archive_impl,
+    attrs = {
+        "urls": attr.string_list(mandatory = True, allow_empty = False),
+        "sha256": attr.string(mandatory = True),
+    },
+)
+
+def archive_name(sha256):
+    return "apt_archive_" + sha256
+
+def archive_members(ctx, label):
+    manifest = ctx.path(label)
+    return manifest.dirname, json.decode(ctx.read(manifest))
+
+def _is_native_file(path):
+    base = path.rsplit("/", 1)[-1]
+    return base.endswith(".so") or ".so." in base or base.endswith(".a") or base.endswith(".ld") or base.endswith(".lds")
+
+def _contents_impl(ctx):
+    root, members = archive_members(ctx, ctx.attr.archive)
+    data = root.get_child(members["data"])
+    listing = ctx.execute(["tar", "-tvf", data])
+    if listing.return_code:
+        fail(listing.stderr)
+    ctx.file("listing.txt", listing.stdout)
+    selected = {}
+    for line in listing.stdout.splitlines():
+        if " ./" not in line or " -> " in line or line.endswith("/"):
+            continue
+        member = line.split(" ./", 1)[1]
+        if member.endswith(".pc") or _is_native_file(member):
+            selected[member] = True
+    ctx.file("_extracted/.keep", "")
+    if selected:
+        extract = ctx.execute(["tar", "-xf", data, "-C", ctx.path("_extracted")] + ["./" + name for name in selected])
+        if extract.return_code:
+            fail(extract.stderr)
+    ctx.file("BUILD.bazel", 'exports_files(["listing.txt"], visibility = ["//visibility:public"])\n')
+
+deb_contents = repository_rule(
+    implementation = _contents_impl,
+    attrs = {"archive": attr.label(mandatory = True)},
+)
