+            fail("native alias refers to a package outside " + rctx.attr.depset_name + ": " + alias)
+        declared_by_package.setdefault(package, {})[target] = architectures
+
     for (_, info) in packages_to_architectures.items():
         package_name = info.name
 
@@ -310,6 +320,14 @@ Please unify the versions manually, or use separate `apt.install` calls (with di
                 export_file, targets = cc_exports[package_key]
                 for public_name, target in targets.items():
                     library_targets.setdefault(public_name, {})["//:linux_%s" % architecture] = str(export_file.same_package_label(target))
+        for name, alias_architectures in declared_by_package.get(package_name, {}).items():
+            selects = {}
+            for architecture in alias_architectures or info.architectures.keys():
+                if architecture not in info.architectures:
