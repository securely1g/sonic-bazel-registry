+                package_key = info.architectures[architecture]
+                selects["//:linux_%s" % architecture] = "@%s//:%s" % (util.sanitize(package_key), name)
+            library_targets[name] = selects
         for target_name, selects in sorted(library_targets.items()):
             extra += _DEB_CC_IMPORT.format(
                 target_name = target_name,
@@ -366,6 +384,7 @@ translate_dependency_set = repository_rule(
     implementation = _translate_dependency_set_impl,
