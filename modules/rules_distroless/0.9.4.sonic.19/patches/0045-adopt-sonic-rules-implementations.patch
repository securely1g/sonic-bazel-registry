+# Headers-only CcInfo target for extracted Debian -dev packages.
+#
+# Why not `cc_library(includes = [...])`: the native rule expands every
+# `includes` entry into a source-tree directory AND its bazel-out twin
+# (`-isystem external/<repo>/usr/include` next to
+# `-isystem bazel-out/<cfg>/bin/external/<repo>/usr/include`). Under sandboxed
+# execution only one of the two can hold declared artifacts (the deb_export
+# outputs shadow the extracted source files at identical paths), so the empty
+# twin fails -Wmissing-include-dirs in consumers that compile with -Werror
+# (e.g. sonic-sairedis). A Starlark-created compilation context emits exactly
+# one -isystem per entry (same as cc_deb_library above), and deriving the
+# entries from the resolved hdrs paths guarantees each -isystem points at a
+# directory that also contains declared header inputs of the same target,
+# sandbox or not. System-header semantics are preserved (-isystem, not -I).
+def _hdrs_library_impl(ctx):
+    dirs = []
+    seen = {}
+    for header in ctx.files.hdrs:
+        for prefix in ctx.attr.system_include_prefixes:
+            if not prefix:
+                continue
+            marker = "/" + prefix + "/"
+            idx = header.path.rfind(marker)
+            if idx == -1:
+                continue
+            directory = header.path[:idx + len(marker) - 1]
+            if directory not in seen:
+                seen[directory] = True
+                dirs.append(directory)
+    own = CcInfo(compilation_context = cc_common.create_compilation_context(
+        headers = depset(ctx.files.hdrs),
+        system_includes = depset(dirs),
+    ))
+    if ctx.attr.deps:
+        own = cc_common.merge_cc_infos(
+            direct_cc_infos = [own],
+            cc_infos = [dep[CcInfo] for dep in ctx.attr.deps],
+        )
+    return [own, DefaultInfo(files = depset(ctx.files.hdrs))]
+
+hdrs_library = rule(
+    implementation = _hdrs_library_impl,
+    attrs = {
+        "hdrs": attr.label_list(allow_files = True),
+        "system_include_prefixes": attr.string_list(default = ["usr/include"]),
+        "deps": attr.label_list(providers = [CcInfo]),
+    },
+)
+
 def _native_library_group_impl(ctx):
     infos = [dep[CcInfo] for dep in ctx.attr.deps]
     merged = cc_common.merge_cc_infos(cc_infos = infos)
