module(
    name = "sai",
    version = "1.18.0-sonic.1",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_perl", version = "1.1.2")
bazel_dep(name = "rules_python", version = "1.7.0")

# Shared compiler toolchains and target sysroots remain separate from the
# container-installed tools used to generate metadata.
bazel_dep(name = "sonic-build-infra", version = "0.0.8-e8b05b109187345586a18628ad01626e69c02fbe", repo_name = "sonic_build_infra")

register_toolchains(
    "//bazel:container_tools_amd64",
    "//bazel:container_tools_arm64",
)
