load(":tools.bzl", "deb_tool_bundle", "python_runtime")

package(default_visibility = ["//visibility:public"])

exports_files([
    "prepare_deb_tools.py",
    "generate_metadata.py",
    "debian_tools.lock.json",
])

python_runtime(name = "python_runtime")

deb_tool_bundle(
    name = "sai_generator_tools",
    architecture = select({
        "@platforms//cpu:x86_64": "amd64",
        "@platforms//cpu:aarch64": "arm64",
    }),
    debs = select({
        "@platforms//cpu:x86_64": ["@sai_generator_tools_amd64//:debs"],
        "@platforms//cpu:aarch64": ["@sai_generator_tools_arm64//:debs"],
    }),
)

exports_files([
    "metadata_consumer_test.c",
    "generated_outputs_test.py",
    "generated_output_sha256.json",
])
