From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH] meta: Run Aspell from the declared execution-tool bundle

SAI's metadata spell checker hard-codes /usr/bin/aspell and invokes it
through a shell. This bypasses Bazel's declared execution tools: generation
fails on a worker without a host Aspell installation, or depends on that
worker's tool version and dictionaries instead of the pinned build inputs.

Use the SAI_ASPELL environment variables supplied by the metadata launcher
to select the executable, ELF loader, library path, data, dictionaries and
filters from the declared execution-tool bundle. Launch the loader and
Aspell directly with IPC::Open2, send the words over stdin, and retain the
existing response parsing. Wait for the child and report a nonzero exit
status so tool failures reach the metadata generator. Spell checking stays
enabled.

This is a downstream SONiC Bazel adaptation. It was introduced as
third_party/sai/declared_aspell.patch in sonic-sairedis commit 60e05b0
and carried into this registry from the retained 6a6dd51 snapshot. The
diff hunks below are unchanged; this header records their provenance.

Origin: https://github.com/securely1g/sonic-sairedis/commit/60e05b00b67a099ae3c1b24989195e0409c9f5e9
Source: https://github.com/securely1g/sonic-sairedis/blob/6a6dd51e9c9c09adf5c19086082940ff0fca2fb4/third_party/sai/declared_aspell.patch
Applies-To: opencomputeproject/SAI at 6dd738196ebb267be458eed0a00b687568455914

---
--- a/meta/style.pm
+++ b/meta/style.pm
@@ -29,6 +29,7 @@
 use warnings;
 use diagnostics;
 use Data::Dumper;
+use IPC::Open2;
 use utils;
 
 require Exporter;
@@ -39,7 +40,14 @@
 
     my %wordsToCheck = %{ $hash };
 
-    if (not -e "/usr/bin/aspell")
+    my $aspell = $ENV{"SAI_ASPELL"};
+    my $loader = $ENV{"SAI_ASPELL_LOADER"};
+    my $libraries = $ENV{"SAI_ASPELL_LIBRARY_PATH"};
+    my $dataDir = $ENV{"SAI_ASPELL_DATA_DIR"};
+    my $dictDir = $ENV{"SAI_ASPELL_DICT_DIR"};
+    my $filterDir = $ENV{"SAI_ASPELL_FILTER_DIR"};
+
+    if (not defined $aspell or not -x $aspell or not defined $loader or not -x $loader)
     {
         LogError "ASPELL IS NOT PRESENT, please install aspell";
         return;
@@ -55,7 +63,14 @@
 
     LogInfo "Words to check: $count";
 
-    my @result = `echo "$all" | /usr/bin/aspell -l en -a -p ./aspell.en.pws 2>&1`;
+    my $pid = open2(my $aspellOut, my $aspellIn, $loader, "--library-path", $libraries,
+        $aspell, "-l", "en", "-a", "-p", "./aspell.en.pws", "--data-dir=$dataDir", "--dict-dir=$dictDir", "--add-filter-path=$filterDir");
+    print {$aspellIn} "$all\n";
+    close $aspellIn;
+    my @result = <$aspellOut>;
+    close $aspellOut;
+    waitpid($pid, 0);
+    LogError "aspell exited with status $?" if $? != 0;
 
     for my $res (@result)
     {
