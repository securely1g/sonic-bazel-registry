module(
    name = "p4lang-pi",
    version = "0.1.3.sonic.2",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.9")
bazel_dep(name = "sonic-build-infra", version = "0.0.22-a12bc826d6f811a157db5c7c02a2fe033896cc14", repo_name = "sonic_build_infra")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "pi_deps",
    packages = [
        "libabsl-dev",
        "libabsl20240722",
        "libboost-system-dev",
        "libboost-thread-dev",
        "libc-ares-dev",
        "libc-ares2",
        "libgrpc++-dev",
        "libgrpc++1.51t64",
        "libgrpc-dev",
        "libgrpc29t64",
        "libprotobuf-dev",
        "libprotobuf32t64",
        "libre2-11",
        "libre2-dev",
        "libreadline-dev",
        "libreadline8t64",
        "libssl-dev",
        "libssl3t64",
        "libtinfo6",
        "zlib1g",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "pi_deps")

# One Debian archive supplies the unchanged source tree and the metadata recipe.
_PI_DEBIAN_URL = "https://github.com/securely1g/sonic-bazel-registry/releases/download/p4-source-inputs-20261021/p4lang-pi_0.1.3-2.debian.tar.xz"

_PI_DEBIAN_SHA256 = "ba9af65a28fd1bbad2b928b681d8b5ea10076611c0e2e0dee1ba855f1216723c"

source = use_repo_rule("//bazel:source.bzl", "pi_source")

source(
    name = "pi_source",
    build_file = "//bazel:pi.BUILD.bazel",
    configure_file = "//bazel:configure.sh",
    debian_sha256 = _PI_DEBIAN_SHA256,
    debian_url = _PI_DEBIAN_URL,
    runtime_file = "//bazel:runtime.bzl",
    upstream_sha256 = "9bb2b97f2caa7548b9cc798c3643b97315f3d8f8372d3689dea5e2a22e18a097",
    upstream_url = "https://github.com/securely1g/sonic-bazel-registry/releases/download/p4-source-inputs-20261021/p4lang-pi_0.1.3.orig.tar.gz",
)

# SONiC applies these existing control-only patches in src/p4lang/Makefile.
# Prepare the metadata separately so editing control fields does not rebuild PI.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file(
    name = "pi_boost_control_patch",
    sha256 = "210e6953aa7cd075147826d7f45767dad3d0415f0b5fcda9d4773128c6fda050",
    urls = ["https://raw.githubusercontent.com/securely1g/sonic-buildimage/ac47de0f6e1a65d56a2cbc00b7d169c0ab79af1b/src/p4lang/p4lang-pi.patch/use-boost-1.83.patch"],
)

http_file(
    name = "pi_protobuf_control_patch",
    sha256 = "b46b42aa6ed8976ea974132eabd31d529e34e7b48f21d13d230e030624d9d848",
    urls = ["https://raw.githubusercontent.com/securely1g/sonic-buildimage/ac47de0f6e1a65d56a2cbc00b7d169c0ab79af1b/src/p4lang/p4lang-pi.patch/remove-protobuf-from-debian-dependency.patch"],
)

http_archive(
    name = "pi_debian",
    build_file_content = 'exports_files(["debian/control", "debian/changelog"])',
    patch_args = ["-p1"],
    patches = [
        "@pi_boost_control_patch//file:downloaded",
        "@pi_protobuf_control_patch//file:downloaded",
    ],
    sha256 = _PI_DEBIAN_SHA256,
    urls = [_PI_DEBIAN_URL],
)

register_toolchains("@sonic_build_infra//tools/build_tools:make_toolchain", "@sonic_build_infra//tools/build_tools:m4_toolchain", "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain", "@sonic_build_infra//tools/build_tools:autoconf_toolchain")
