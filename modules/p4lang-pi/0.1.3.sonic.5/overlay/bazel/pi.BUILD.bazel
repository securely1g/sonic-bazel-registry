load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")
load(":bazel/runtime.bzl", "installed_file", "runtime_for_arch")

package(default_visibility = ["//visibility:public"])

_LIBRARIES = [
    "pi",
    "pip4info",
    "pifegeneric",
    "piall",
    "picli",
    "pi_dummy",
    "pifecpp",
    "piprotobuf",
    "piprotogrpc",
    "piconvertproto",
    "pifeproto",
    "pigrpcserver",
]

_PROGRAMS = [
    "pi_CLI_dummy",
    "pi_gen_native_json",
    "pi_convert_p4info",
]

_PYTHON_FILES = [
    "p4/v1/p4data_pb2.py",
    "p4/v1/p4data_pb2_grpc.py",
    "p4/v1/p4runtime_pb2.py",
    "p4/v1/p4runtime_pb2_grpc.py",
    "p4/config/v1/p4info_pb2.py",
    "p4/config/v1/p4info_pb2_grpc.py",
    "p4/config/v1/p4types_pb2.py",
    "p4/config/v1/p4types_pb2_grpc.py",
    "p4/tmp/p4config_pb2.py",
    "p4/tmp/p4config_pb2_grpc.py",
    "p4/server/v1/config_pb2.py",
    "p4/server/v1/config_pb2_grpc.py",
    "google/rpc/code_pb2.py",
    "google/rpc/code_pb2_grpc.py",
    "google/rpc/status_pb2.py",
    "google/rpc/status_pb2_grpc.py",
    "gnmi/gnmi_pb2.py",
    "gnmi/gnmi_pb2_grpc.py",
    "p4/__init__.py",
    "p4/v1/__init__.py",
    "p4/config/__init__.py",
    "p4/config/v1/__init__.py",
    "p4/tmp/__init__.py",
    "p4/server/__init__.py",
    "p4/server/v1/__init__.py",
    "google/rpc/__init__.py",
    "gnmi/__init__.py",
]

filegroup(
    name = "sources",
    srcs = ["bazel/configure.sh"] + glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "bazel/**",
        ],
    ),
)

configure_make(
    name = "sdk",
    args = [
        "-j4",
        "V=0",
        "pythondir=/usr/python",
    ],
    build_data = [
        "@sonic_build_infra//tools/build_tools:foreign_runtime",
        "@sonic_build_infra//tools/build_tools:configure_environment.sh",
        "@sonic_build_infra//tools/build_tools:configure_linker_flags.sh",
    ],
    configure_command = "bazel/configure.sh",
    configure_in_place = True,
    configure_options = [
        "--prefix=/usr",
        "--with-proto",
        "--with-cli",
    ],
    # Save large linker environments before starting configure's first process.
    configure_prefix = 'source "$$EXT_BUILD_ROOT$$/$(execpath @sonic_build_infra//tools/build_tools:configure_linker_flags.sh)" "$${BAZEL_FOREIGN_TOOLS}/bin/python3" /bin/sh',
    configure_xcompile = True,
    # The server uses -Werror; keep the toolchain's extra unused-RPC-parameter
    # diagnostics as warnings, as in the legacy build without -Wextra.
    copts = [
        "-O2",
        "-g",
        "-fstack-protector-strong",
        "-Wformat",
        "-Werror=format-security",
        "-D_FORTIFY_SOURCE=2",
        "-Wno-error=unused-parameter",
    ],
    data = ["@pi_deps//:pkgconfig"],
    env = {
        "PATH": "$(execpath @sonic_build_infra//tools/build_tools:foreign_runtime)/bin:$$PATH",
        "BAZEL_CONFIGURE_ENV": "$(execpath @sonic_build_infra//tools/build_tools:configure_environment.sh)",
        "BAZEL_FOREIGN_TOOLS": "$(execpath @sonic_build_infra//tools/build_tools:foreign_runtime)",
        "BAZEL_PKGCONFIG_FILES": "$(locations @pi_deps//:pkgconfig)",
        "LDFLAGS": "-Wl,-z,relro,-z,now -Wl,-rpath-link=$$EXT_BUILD_DEPS/lib",
    },
    features = [
        "-sanitize_pwd",
        "-strip_debug_symbols",
    ],
    # Keep the logical install prefix stable, then copy the staged /usr subtree
    # into the existing flat SDK. This keeps sandbox paths out of its libdir
    # without changing the declared bin/lib/include/python output layout.
    install_prefix = "usr",
    lib_source = ":sources",
    out_binaries = _PROGRAMS,
    out_data_files = ["lib/lib" + name + ".so.0.0.0" for name in _LIBRARIES] + ["python/" + name for name in _PYTHON_FILES] + [
        "bin/pi_gen_fe_defines",
        "config.log",
        "proto.config.log",
    ],
    # CcInfo consumers load the same SONAME that the installed runtime provides.
    out_shared_libs = ["lib" + name + ".so.0" for name in _LIBRARIES],
    postfix_script = "cp config.log $$INSTALLDIR/config.log; cp proto/config.log $$INSTALLDIR/proto.config.log",
    # Normalize sibling source/dependency paths below the foreign execution root.
    set_file_prefix_map = True,
    targets = [
        "",
        "install DESTDIR=$$BUILD_TMPDIR$$",
    ],
    deps = [
        "@pi_deps//libboost-system-dev:libboost-system",
        "@pi_deps//libboost-thread-dev:libboost-thread",
        "@pi_deps//libgrpc++-dev:libgrpc++",
        "@pi_deps//libgrpc-dev:libgrpc",
        "@pi_deps//libprotobuf-dev:libprotobuf",
        "@pi_deps//libreadline-dev:libreadline",
        "@pi_deps//libssl-dev:libssl",
        "@pi_deps//zlib1g-dev:zlib1g",
    ],
)

[select_file(
    name = "built_" + name,
    srcs = ":sdk",
    subpath = "sdk/bin/" + name,
) for name in _PROGRAMS]

[select_file(
    name = "built_lib" + name,
    srcs = ":sdk",
    subpath = "sdk/lib/lib" + name + ".so.0.0.0",
) for name in _LIBRARIES]

[installed_file(
    name = "python_" + name.replace("/", "_"),
    subpath = "sdk/python/" + name,
) for name in _PYTHON_FILES]

installed_file(
    name = "configure_log",
    subpath = "sdk/config.log",
)

installed_file(
    name = "proto_configure_log",
    subpath = "sdk/proto.config.log",
)

runtime_for_arch("amd64", "x86_64-linux-gnu", _LIBRARIES, _PROGRAMS, _PYTHON_FILES)

runtime_for_arch("arm64", "aarch64-linux-gnu", _LIBRARIES, _PROGRAMS, _PYTHON_FILES)

alias(
    name = "runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64",
        "@platforms//cpu:aarch64": ":runtime_arm64",
    }),
)

alias(
    name = "runtime.debug_symbols",
    actual = select({
        "@platforms//cpu:x86_64": ":runtime_amd64.debug_symbols",
        "@platforms//cpu:aarch64": ":runtime_arm64.debug_symbols",
    }),
)

exports_files([
    "LICENSE",
    "debian/copyright",
])

# First native compile slice. These targets reuse the pinned upstream BUILD
# source graph and the original Make generator definitions. The complete
# foreign SDK and its runtime/debug packaging stay selected until the native
# ABI, generator closure and full installed-file inventory are validated.
# SPDX-FileCopyrightText: 2018 Barefoot Networks, Inc.
# SPDX-FileCopyrightText: 2018, 2021 Antonin Bas
# Adapted upstream BUILD rules: SPDX-License-Identifier: Apache-2.0.
# Vendored cJSON source retains its original MIT license.
_NATIVE_COPTS = [
    "-O2",
    "-g",
    "-fstack-protector-strong",
    "-Wformat",
    "-Werror=format-security",
    "-D_FORTIFY_SOURCE=2",
    "-Wno-error=unused-parameter",
]

filegroup(
    name = "native_pihdrs",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "native_piutils",
    copts = _NATIVE_COPTS,
    srcs = glob(["src/utils/*.c"]) + [":native_pihdrs"],
    hdrs = glob(["src/utils/*.h"]),
    includes = [
        "include",
        "src/utils",
    ],
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "native_pip4info",
    srcs = [
        "src/p4info_int.h",
        ":native_pihdrs",
    ] + glob([
        "src/p4info/*.c",
        "src/p4info/*.h",
    ]) + glob([
        "src/config_readers/*.c",
        "src/config_readers/*.h",
    ]),
    hdrs = glob(["include/PI/p4info/*.h"]),
    copts = _NATIVE_COPTS + ["-DPI_LOG_ON", "-DPI_NATIVE_PUBLIC_CJSON"],
    includes = [
        "include",
        "src",
    ],
    deps = [
        ":native_piutils",
        ":native_pitoolkit",
        "@uthash//:uthash",
        "@cjson//:cjson",
    ],
)

# Preserve the upstream source glob and disabled internal-RPC exclusions.
# Registry AMD64 CI builds this native core; aquery evidence is collected separately.
cc_library(
    name = "native_pi",
    copts = _NATIVE_COPTS,
    srcs = [":native_pihdrs"] +
           glob(
               ["src/*.c"],
               exclude = [
                   "src/pi_notifications_pub.c",
                   "src/pi_rpc_server.c",
               ],
           ) + glob(
        ["src/*.h"],
        exclude = [
            "src/p4info_int.h",
            "src/pi_notifications_pub.h",
        ],
    ),
    hdrs = glob([
        "include/PI/*.h",
        "include/PI/target/*.h",
    ]) + [
        "include/PI/int/pi_int.h",
        "include/PI/int/serialize.h",
    ],
    includes = ["include"],
    deps = [":native_pip4info"],
)

cc_library(
    name = "native_pifegeneric",
    srcs = ["src/frontends/generic/pi.c"],
    hdrs = ["include/PI/frontends/generic/pi.h"],
    copts = _NATIVE_COPTS + ["-DPI_LOG_ON"],
    includes = ["include"],
    deps = [":native_pi"],
)

# Source patterns and include roots below are the pinned upstream lib/BUILD,
# third_party/BUILD, third_party/cJSON/BUILD and frontends_extra/cpp/BUILD.
# Package-relative paths and target names use the existing flattened
# pi_source repository. cJSON also retains its original Make libm dependency.
cc_library(
    name = "native_pitoolkit",
    srcs = glob(["lib/*.c"]),
    hdrs = glob(["lib/*.h"]),
    includes = ["lib"],
    copts = _NATIVE_COPTS,
)

cc_library(
    name = "native_pifecpp",
    srcs = ["frontends_extra/cpp/src/tables.cpp"],
    hdrs = ["frontends_extra/cpp/PI/frontends/cpp/tables.h"],
    includes = ["frontends_extra/cpp"],
    copts = _NATIVE_COPTS + ["-std=c++17"],
    deps = [":native_pi"],
)

# The source and link dependencies are the original bin/Makefile.am and
# generators/Makefile.am. These outputs are not substituted into the SDK/TAR.
cc_binary(
    name = "native_pi_gen_native_json",
    srcs = ["bin/gen_pi_json.c"],
    copts = _NATIVE_COPTS,
    linkopts = ["-Wl,-z,relro,-z,now"],
    deps = [":native_pip4info"],
)

cc_binary(
    name = "native_pi_gen_fe_defines",
    srcs = ["generators/fe_defines.c"],
    copts = _NATIVE_COPTS,
    linkopts = ["-Wl,-z,relro,-z,now"],
    deps = [":native_pip4info", ":native_piutils", ":native_pitoolkit"],
)

filegroup(
    name = "native_core",
    srcs = [
        ":native_pi",
        ":native_pip4info",
        ":native_pifegeneric",
        ":native_pifecpp",
        ":native_pi_gen_native_json",
        ":native_pi_gen_fe_defines",
    ],
)

# Existing installed SDK generator, retained for an old/new behavior comparison.
installed_file(
    name = "baseline_pi_gen_fe_defines",
    subpath = "sdk/bin/pi_gen_fe_defines",
)

filegroup(
    name = "native_fixture_act_prof",
    srcs = ["tests/testdata/act_prof.json"],
)

filegroup(
    name = "native_fixture_valid",
    srcs = ["tests/testdata/valid.json"],
)
