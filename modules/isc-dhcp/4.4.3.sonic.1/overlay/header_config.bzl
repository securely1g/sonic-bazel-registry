def isc_private_headers():
    """Preserve Make -I priority for caller-owned netinet headers."""
    root = native.package_relative_label(":BUILD.bazel").workspace_root
    return ["-I" + root + "/includes", "-I$(GENDIR)/" + root + "/includes"]
