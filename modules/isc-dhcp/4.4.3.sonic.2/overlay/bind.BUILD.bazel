# =============================================================================
# libdns code generation: gen.c host tool + 4 generated headers
# =============================================================================

cc_binary(
    name = "dns_gen",
    srcs = [
        "lib/dns/gen.c",
        "lib/dns/gen-unix.h",
        ":platform_h",
        ":bind_config_h",
    ] + glob(["lib/isc/include/**/*.h"]),
    includes = [
        ".",
        "lib/isc/include",
        "lib/isc/unix/include",
    ] + select({
        "@platforms//cpu:x86_64": ["lib/isc/nothreads/include"],
        "//conditions:default": ["lib/isc/pthreads/include"],
    }) + select({
        "@platforms//cpu:aarch64": ["lib/isc/noatomic/include"],
        "//conditions:default": ["lib/isc/x86_32/include"],
    }),
    copts = ["-w"],
)

# rdata files needed by gen.c at codegen time. Glob keeps the list in sync
# with whatever rdata/<class>/<type>_<num>.[hc] files BIND ships.
filegroup(
    name = "dns_rdata_files",
    srcs = glob([
        "lib/dns/rdata/**/*.h",
        "lib/dns/rdata/**/*.c",
    ]),
)

# gen.c expects -s <dir-containing-rdata>. We pass lib/dns; the cmd extracts
# that prefix from any one rdata file location to be hermetic against bazel
# execroot relocation.
genrule(
    name = 'dns_enumtype_h',
    srcs = [":dns_rdata_files", "lib/dns/rdata/rdatastructpre.h"],
    outs = ['lib/dns/include/dns/enumtype.h'],
    tools = [":dns_gen"],
    cmd = 'root=$$PWD; source=$(location lib/dns/rdata/rdatastructpre.h); source=$${source%/rdata/*}; tool=$$root/$(location :dns_gen); out=$$root/$@; cd "$$source"; "$$tool" -s . -t > "$$out"',
)
genrule(
    name = 'dns_enumclass_h',
    srcs = [":dns_rdata_files", "lib/dns/rdata/rdatastructpre.h"],
    outs = ['lib/dns/include/dns/enumclass.h'],
    tools = [":dns_gen"],
    cmd = 'root=$$PWD; source=$(location lib/dns/rdata/rdatastructpre.h); source=$${source%/rdata/*}; tool=$$root/$(location :dns_gen); out=$$root/$@; cd "$$source"; "$$tool" -s . -c > "$$out"',
)
genrule(
    name = 'dns_rdatastruct_h',
    srcs = [":dns_rdata_files", "lib/dns/rdata/rdatastructpre.h"],
    outs = ['lib/dns/include/dns/rdatastruct.h'],
    tools = [":dns_gen"],
    cmd = 'root=$$PWD; source=$(location lib/dns/rdata/rdatastructpre.h); source=$${source%/rdata/*}; tool=$$root/$(location :dns_gen); out=$$root/$@; cd "$$source"; "$$tool" -s . -i -P ./rdata/rdatastructpre.h -S ./rdata/rdatastructsuf.h > "$$out"',
)
genrule(
    name = 'dns_code_h',
    srcs = [":dns_rdata_files", "lib/dns/rdata/rdatastructpre.h"],
    outs = ['lib/dns/code.h'],
    tools = [":dns_gen"],
    cmd = 'root=$$PWD; source=$(location lib/dns/rdata/rdatastructpre.h); source=$${source%/rdata/*}; tool=$$root/$(location :dns_gen); out=$$root/$@; cd "$$source"; "$$tool" -s .  > "$$out"',
)
