# =============================================================================
# libisc
# =============================================================================

LIBISC_HEADERS = glob(
    [
        "lib/isc/*.h",
        "lib/isc/include/**/*.h",
        "lib/isc/unix/*.h",
        "lib/isc/unix/include/**/*.h",
        "lib/isc/pthreads/include/**/*.h",
        "lib/isc/nothreads/include/**/*.h",
        "lib/isc/x86_32/include/**/*.h",
        "lib/isc/noatomic/include/**/*.h",
    ],
    allow_empty = True,
) + [":platform_h", ":bind_config_h"]

LIBISC_INCLUDES = [
    ".",
    "lib/isc",
    "lib/isc/include",
    "lib/isc/unix",
    "lib/isc/unix/include",
] + select({
    "@platforms//cpu:x86_64": ["lib/isc/nothreads/include"],
    "//conditions:default": ["lib/isc/pthreads/include"],
}) + select({
    "@platforms//cpu:aarch64": ["lib/isc/noatomic/include"],
    "//conditions:default": ["lib/isc/x86_32/include"],
})

LIBISC_COPTS = [
    "-D_GNU_SOURCE",
    "-DSYSCONFDIR=\\\"/etc/bind\\\"",
    "-DVERSION=\\\"9.11.36\\\"",
    "-DLIBINTERFACE=1107",
    "-DLIBREVISION=7",
    "-DLIBAGE=0",
] + BIND_TARGET_COPTS + select({
    "@platforms//cpu:x86_64": ["-DPK11_LIB_LOCATION=\\\"undefined\\\""],
    "//conditions:default": ["-D_REENTRANT"],
})

# 原 Make 对 safe.c 单独追加 -O0；原生编译对象再并入同一 libisc 归档。
cc_library(
    name = "libisc_safe",
    features = ["-opt"],
    srcs = ["lib/isc/safe.c"],
    hdrs = LIBISC_HEADERS,
    includes = LIBISC_INCLUDES,
    copts = LIBISC_COPTS + ["-O0"],
    target_compatible_with = select({
        "@platforms//cpu:x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "libisc_safe_objects",
    srcs = [":libisc_safe"],
    output_group = "compilation_outputs",
)

