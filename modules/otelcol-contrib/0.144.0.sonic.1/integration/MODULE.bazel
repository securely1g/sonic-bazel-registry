module(name = "otelcol_registry_consumer")

bazel_dep(name = "otelcol-contrib", version = "0.144.0.sonic.1")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.15")
bazel_dep(name = "sonic-build-infra", version = "0.0.26-51c838da6ff57295fde6e0bc3807841cb31a8568", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.6")

# Root-owned Gazelle policy preserves the original go build of checked-in pb.go.
# The owner still supplies every source, dependency lock, BUILD and TAR target.
otel_runtime_deps = use_extension("@otelcol-contrib//bazel:collector_deps.bzl", "go_deps")
otel_runtime_deps.gazelle_default_attributes(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
)

# The receiver embeds a YAML file in a nested directory containing Go tests.
# Preserve that package and expose only the required input across its boundary.
otel_runtime_deps.module_override(
    patch_strip = 1,
    patches = ["@otelcol-contrib//bazel:0001-googlecloudspannerreceiver-embedded-metadata.patch"],
    path = "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/googlecloudspannerreceiver",
)

# The public installed test uses upstream golden's checked-in Go protobuf files.
otel_golden_deps = use_extension("@otelcol-contrib//bazel:golden_deps.bzl", "go_deps")
otel_golden_deps.gazelle_default_attributes(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
)
