module(name = "otelcol_registry_consumer")

bazel_dep(name = "otelcol-contrib", version = "0.165.0.sonic.1")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "sonic-build-infra", version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_go", version = "0.65.0.sonic.3", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
# Match the buildimage root. The collector and release tools select 1.27.3.
go_sdk.download(version = "1.26.7")

# Root-owned Gazelle policy preserves the original go build of checked-in pb.go.
# The owner still supplies every source, dependency lock, BUILD and TAR target.
otel_runtime_deps = use_extension("@otelcol-contrib//bazel:collector_deps.bzl", "go_deps")
# Apply the release's Avro replacement from its locked Go module. OBI uses
# upstream's generated BPF objects, which the ordinary Go module ZIP omits.
otel_runtime_deps.zip_lock(file = "@otelcol-contrib//bazel:collector-go-zip-lock.json")
otel_runtime_deps.from_file(go_mod = "@otelcol-contrib//distributions/otelcol-contrib:go.mod")
otel_runtime_deps.archive_override(
    path = "go.opentelemetry.io/obi",
    patches = ["@otelcol-contrib//bazel:0003-obi-replacement-metadata.patch"],
    patch_strip = 1,
    sha256 = "d3cbec602e3ab7b357d2f4a57b29e502365f9098808418e8b4d96dec8fa9281f",
    strip_prefix = "obi-v0.15.2-source-generated",
    urls = ["https://github.com/open-telemetry/opentelemetry-ebpf-instrumentation/releases/download/v0.15.2/obi-v0.15.2-source-generated.tar.gz"],
)

otel_runtime_deps.module_override(
    path = "github.com/hamba/avro/v2",
    patches = ["@otelcol-contrib//bazel:0004-avro-replacement-metadata.patch"],
    patch_strip = 1,
)
otel_runtime_deps.gazelle_default_attributes(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
)

# The receiver embeds a YAML file in a nested directory containing Go tests.
# Preserve that package and expose only the required input across its boundary.
otel_runtime_deps.module_override(
    patch_strip = 1,
    patches = ["@otelcol-contrib//bazel:0001-googlecloudspannerreceiver-embedded-metadata.patch"],
    path = "github.com/open-telemetry/opentelemetry-collector-contrib/receiver/googlecloudspannerreceiver",
)

# The public installed test uses upstream golden's checked-in Go protobuf files.
otel_golden_deps = use_extension("@otelcol-contrib//bazel:golden_deps.bzl", "go_deps")
otel_golden_deps.zip_lock(file = "@otelcol-contrib//bazel:golden-go-zip-lock.json")
otel_golden_deps.gazelle_default_attributes(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
)

otel_ocb_deps = use_extension("@otelcol-contrib//bazel:ocb_deps.bzl", "go_deps")
otel_ocb_deps.zip_lock(file = "@otelcol-contrib//bazel:ocb-go-zip-lock.json")
