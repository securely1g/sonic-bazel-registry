From: Guohan Lu <securely1g@gmail.com>
Subject: [PATCH] Refresh gazelle registry dependency versions

The registry dependency refresh selects the newest non-yanked module
versions published at catalog 3d1cc5e8dfd553d2acbe4198e504a245e6bdbddf.
Apply this after the inherited patch series so the fetched MODULE
matches the registry declaration. Package source and behavior patches
remain unchanged. This is a downstream registry integration change.

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,7 +1,7 @@
 module(
     name = "gazelle",
     # Updated by the Publish to BCR app.
-    version = "0.54.0.sonic.1",
+    version = "0.54.0.sonic.2",
     repo_name = "bazel_gazelle",
 )
 
@@ -10,7 +10,7 @@
 bazel_dep(name = "platforms", version = "1.1.0")
 bazel_dep(name = "protobuf", version = "3.19.6", repo_name = "com_google_protobuf")
 bazel_dep(name = "rules_cc", version = "0.0.17")
-bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", repo_name = "io_bazel_rules_go")
 bazel_dep(name = "rules_license", version = "1.0.0")
 bazel_dep(name = "package_metadata", version = "0.0.5")
 bazel_dep(name = "rules_shell", version = "0.2.0")
