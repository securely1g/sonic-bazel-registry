module(name = "go_zip_consumer")
bazel_dep(name = "gazelle", version = "0.54.0.sonic.1")
bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.zip_lock(file = "//:go.zip.sums.json")
use_repo(go_deps, "com_github_google_uuid", go_zip_lock_plan = "bazel_gazelle_go_repository_config")

bazel_dep(name = "platforms", version = "1.1.0")
