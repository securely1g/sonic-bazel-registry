"""Keep public labels stable while compiling only the Debian-prepared source."""

exports_files(glob(["*.bzl", "probe.proto"]))

[
    alias(
        name = name,
        actual = "@protobuf_source//:" + name,
        visibility = ["//visibility:public"],
    )
    for name in [
        "LICENSE",
        "protobuf_lite",
        "protobuf",
        "protobuf_headers",
        "well_known_protos",
        "well_known_type_protos",
        "lite_well_known_protos",
        "cc_wkt_protos_genproto",
        "cc_wkt_protos",
        "any_proto",
        "api_proto",
        "duration_proto",
        "empty_proto",
        "field_mask_proto",
        "source_context_proto",
        "struct_proto",
        "timestamp_proto",
        "type_proto",
        "wrappers_proto",
        "compiler_plugin_proto",
        "descriptor_proto",
        "protoc_lib",
        "protoc",
        "protobuf_java",
        "protobuf_javalite",
        "protobuf_java_util",
        "java_toolchain",
        "javalite_toolchain",
        "well_known_types_py_pb2",
        "protobuf_python",
        "python_common_test_protos",
        "python_specific_test_protos",
        "proto_api",
        "cc_toolchain",
        "objectivec",
        "protobuf_objc",
        "conformance_test_runner",
        "test_messages_proto2_proto",
        "test_messages_proto3_proto",
        "bzl_srcs",
        "libprotobuf.so.32",
        "shared_library",
        "libprotobuf",
        "libprotobuf_runtime_file",
        "libprotobuf_pkg",
        "libprotobuf_pkg.debug_symbols",
        "runtime_packages.json",
        "probe_generated",
        "probe_python",
        "generated_runtime_consumer",
        "libprotobuf_pkg_x86_64",
        "libprotobuf_pkg_x86_64.debug_symbols",
        "libprotobuf_pkg_aarch64",
        "libprotobuf_pkg_aarch64.debug_symbols",
    ]
]

# Bazel does not execute tests selected through alias rules.
[
    test_suite(
        name = name,
        tests = ["@protobuf_source//:" + name],
        visibility = ["//visibility:public"],
    )
    for name in [
        "generated_runtime_test",
        "generated_python_test",
        "source_package_test",
        "source_preparation_test",
    ]
]
