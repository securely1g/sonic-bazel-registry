module(name = "snmpagent_registry_consumer")

bazel_dep(name = "sonic-snmpagent", version = "2.1.1-61e1b148eca5d14f3ad5eb838b9dd724408d0820")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.1")
bazel_dep(name = "platforms", version = "1.1.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "registry_test_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "registry_test_pip")
