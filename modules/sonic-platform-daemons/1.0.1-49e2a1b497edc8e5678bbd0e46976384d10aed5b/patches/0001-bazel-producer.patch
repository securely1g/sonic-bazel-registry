new file mode 100644
index 0000000000000000000000000000000000000000..c0d380cfc825b1636d5d93f6713a2eb4405c0e4a
--- /dev/null
+++ b/tests/bazel/MODULE.bazel
@@ -0,0 +1,68 @@
+# Test-only application root. Production images consume the platform-common
+# module directly; they do not acquire a dependency back on sonic-buildimage.
+module(name = "sonic_platform_daemons_tests")
+
+bazel_dep(name = "sonic-platform-daemons", version = "1.0.1-49e2a1b497edc8e5678bbd0e46976384d10aed5b", repo_name = "sonic_platform_daemons")
+local_path_override(module_name = "sonic-platform-daemons", path = "../..")
+
+# The isolated test application consumes the published platform API owner.
+bazel_dep(name = "sonic-platform-common", version = "1.0.1-74d0685cf303b1a08099b378d2428f4a8e6d85e0", repo_name = "sonic_platform_common")
+
+bazel_dep(name = "sonic-buildimage", version = "0.0.0", repo_name = "sonic_buildimage")
+# Exercise the installed image wheels without resolving the installer's P4,
+# kernel and container dependencies. Both helpers and wheel rules come from
+# the same immutable archive as the original daemon test application.
+archive_override(
+    module_name = "sonic-buildimage",
+    urls = ["https://github.com/securely1g/sonic-buildimage/archive/c743d7521e80fc1733e5cc0ffc24889b08f78444.tar.gz"],
+    integrity = "sha256-oOKTQ3eYGtQ147/NWxok3CX5NzeUkGp2KsIbQJbVhFs=",
+    strip_prefix = "sonic-buildimage-c743d7521e80fc1733e5cc0ffc24889b08f78444",
+    files = {
+        "MODULE.bazel": "//:buildimage.MODULE.bazel",
+        "tools/bazel/tests/BUILD.bazel": "//:wheel_helpers.BUILD.bazel",
+    },
+)
