diff --git a/tests/bazel/collect_evidence.py b/tests/bazel/collect_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..086b5f29c13f28a7beccb21b4d9977531d15879c
--- /dev/null
+++ b/tests/bazel/collect_evidence.py
@@ -0,0 +1,99 @@
+"""Collect the exact public installations and original project test receipts."""
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import zipfile
+
+
+PROJECTS = ("chassisd", "ledd", "pcied", "psud", "syseepromd", "thermalctld", "xcvrd",
+            "ycabled", "sensormond", "stormond", "bmcctld")
+
+
+def bazel(directory, root):
+    command = ["bazel"]
+    if directory != root and os.environ.get("BAZEL_TEST_OUTPUT_BASE"):
+        command.append("--output_base=" + os.environ["BAZEL_TEST_OUTPUT_BASE"])
+    return command
+
+
+def info(command, directory, root, key):
+    # Filesystem locations do not depend on the application's target platform.
+    # Bazel's fast info path does not resolve its Trixie repository alias;
+    # use the declared platforms module's host only for these info queries.
+    flags = [] if directory == root else ["--platforms=@platforms//host", "--host_platform=@platforms//host"]
+    return subprocess.check_output(command + ["info", *flags, key], cwd=directory, text=True).strip()
+
+
+def retain(source, destination):
+    # Bazel outputs may be read-only; snapshots keep their bytes rather than
+    # propagating the output-cache mode to a file a later collection replaces.
+    destination = Path(destination)
+    destination.unlink(missing_ok=True)
+    return shutil.copyfile(source, destination)
+
+
+def main():
+    root = Path(__file__).resolve().parents[2]
+    test_root = root / "tests/bazel"
+    output = root / "bazel-evidence"
+    output.mkdir(exist_ok=True)
+    # Previous snapshots can inherit read-only Bazel output directory modes.
+    for directory in output.rglob("*"):
+        if directory.is_dir():
+            directory.chmod(directory.stat().st_mode | 0o200)
+    artifacts = []
+    errors = []
+    for scope, directory in (("owner", root), ("tested", test_root)):
+        command = bazel(directory, root)
+        execution_root = Path(info(command, directory, root, "execution_root"))
+        for role in ("wheels", "runtime", "runtime_metadata"):
+            label = ("@sonic_platform_daemons" if scope == "tested" else "") + "//:daemons." + role
+            paths = subprocess.check_output(command + ["cquery", label, "--output=files"], cwd=directory, text=True).splitlines()
+            for name in paths:
+                source = execution_root / name
+                target = output / (scope + "-" + source.name)
+                if role == "runtime_metadata":
+                    retain(source, target)
+                artifacts.append({"scope": scope, "label": label, "file": name,
+                                  "sha256": hashlib.sha256(source.read_bytes()).hexdigest()})
+        lock = directory / "MODULE.bazel.lock"
+        if lock.exists():
+            retain(lock, output / (scope + "-MODULE.bazel.lock"))
+    command = bazel(test_root, root)
+    testlogs = Path(info(command, test_root, root, "bazel-testlogs"))
+    receipts = {}
+    for name in [project + "_test" for project in PROJECTS] + ["installed_runtime_test"]:
+        logs = testlogs / name
+        if not (logs / "test.xml").is_file():
+            errors.append(name + ": missing Bazel XML")
+            continue
+        shutil.copytree(logs, output / name, dirs_exist_ok=True, copy_function=retain)
+        receipt_name = "wheels.json" if name == "installed_runtime_test" else "source-tests.json"
+        outputs = logs / "test.outputs"
+        if (outputs / receipt_name).is_file():
+            receipt = json.loads((outputs / receipt_name).read_text())
+        else:
+            with zipfile.ZipFile(outputs / "outputs.zip") as archive:
+                receipt = json.loads(archive.read(receipt_name))
+        receipts[name] = receipt
+        if receipt["status"] != "passed":
+            errors.append(name + ": " + receipt["status"])
+    provenance = {
+        "revision": subprocess.check_output(["git", "-c", "safe.directory=" + str(root), "rev-parse", "HEAD"], cwd=root, text=True).strip(),
+        "ci_head_sha": os.environ.get("CI_HEAD_SHA", ""),
+        "artifacts": artifacts,
+        "test_receipts": receipts,
+        "errors": errors,
+        "scope": "AMD64, declared Trixie userland and Python 3.13; original owner suites and installed interfaces",
+    }
+    (output / "provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
+    if errors:
+        raise RuntimeError("; ".join(errors))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/bazel/installed_runtime_test.py b/tests/bazel/installed_runtime_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b60ba8b2639f61c0ae4d03c311d9da3debea4f3
--- /dev/null
+++ b/tests/bazel/installed_runtime_test.py
@@ -0,0 +1,210 @@
+"""Validate installed owner wheels against the original per-daemon setup contracts."""
+
+import argparse
+import base64
+import configparser
+import csv
+from email.parser import BytesParser
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import posixpath
+import subprocess
+import shutil
+import tarfile
+import unittest
+import zipfile
+
+from tools.bazel.tests.integration.installed_wheel_fixture import installed_wheels, write_wheel_receipt
+from tools.bazel.tests.integration.wheel_contract import setup_contract, expected_sources, normalized_requirement
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--source", type=Path, required=True)
+parser.add_argument("--owner-wheel", type=Path, action="append", required=True)
+parser.add_argument("--runtime", type=Path, action="append", required=True)
+parser.add_argument("--metadata", type=Path, action="append", required=True)
+parser.add_argument("--dependency-wheel", type=Path, action="append", required=True)
+ARGS, REST = parser.parse_known_args()
+DETAILS = {}
+
+
+class InstalledRuntimeTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = ARGS.source.absolute().parent.parent
+        cls.wheels = [p.absolute() for p in ARGS.dependency_wheel]
+        import sonic_py_common
+        import sonic_platform_base
+        import portconfig
+        import sonic_yang
+        roots = [cls.source,
+                 Path(sonic_py_common.__file__).absolute().parent.parent,
+                 Path(sonic_platform_base.__file__).absolute().parent.parent,
+                 Path(portconfig.__file__).absolute().parent,
+                 Path(sonic_yang.__file__).absolute().parent]
+        cls.installed = cls.enterClassContext(installed_wheels(cls.wheels, exclude_source_roots=roots))
+        # psud's import-time hardware provider is the same explicit fixture
+        # used by its original suite. Borrow only sonic_platform, retaining
+        # the real declared Common binding rather than mocked_libs/swsscommon.
+        cls.hardware_fixture = cls.installed.root / "hardware-fixture"
+        shutil.copytree(cls.source / "sonic-psud/tests/mocked_libs/sonic_platform",
+                        cls.hardware_fixture / "sonic_platform")
+        cls.payloads = []
+        for archive in ARGS.runtime:
+            files = {}
+            with tarfile.open(archive, "r:") as stream:
+                for member in stream:
+                    path = Path(member.name)
+                    assert not path.is_absolute() and ".." not in path.parts
+                    assert member.uid == member.gid == 0
+                    if member.isdir():
+                        assert member.mode == 0o755
+                        continue
+                    assert member.isfile()
+                    assert member.mode == (0o755 if path.is_relative_to("usr/local/bin") else 0o644)
+                    data = stream.extractfile(member).read()
+                    files[str(path)] = data
+                    if path.is_relative_to("usr/local/bin"):
+                        target = cls.installed.scripts / path.name
+                    else:
+                        target = cls.installed.site / path.relative_to("usr/local/lib/python3.13/dist-packages")
+                    target.parent.mkdir(parents=True, exist_ok=True)
+                    target.write_bytes(data)
+                    target.chmod(member.mode)
+            cls.payloads.append(files)
+
+    def test_original_payload_metadata_and_record(self):
+        metadata = {json.loads(p.read_text())["distribution"]: (p, json.loads(p.read_text())) for p in ARGS.metadata}
+        wheels = {path.name: path for path in ARGS.owner_wheel}
+        observed = []
+        site = "usr/local/lib/python3.13/dist-packages"
+        for files in self.payloads:
+            headers = [p for p in files if p.endswith(".dist-info/METADATA")]
+            self.assertEqual(len(headers), 1)
+            header = headers[0]
+            message = BytesParser().parsebytes(files[header])
+            name = message["Name"]
+            setup = self.source / name / "setup.py"
+            contract = setup_contract(setup)
+            prefix = header.rsplit("/", 1)[0]
+            expected = {site + "/" + p: source.read_bytes() for p, source in expected_sources(contract, setup.parent).items()}
+            # These two files are generated by the original setup GrpcTool,
+            # not present in the source checkout's find_packages enumeration.
+            if name == "sonic-ycabled":
+                generated = {site + "/proto_out/" + p for p in ("linkmgr_grpc_driver_pb2.py", "linkmgr_grpc_driver_pb2_grpc.py")}
+                self.assertTrue(generated <= files.keys())
+            else:
+                generated = set()
+            for script in contract.get("scripts", []):
+                path = "usr/local/bin/" + Path(script).name
+                self.assertEqual(files[path].split(b"\n", 1)[1], (setup.parent / script).read_bytes().split(b"\n", 1)[1])
+                self.assertEqual(files[path].split(b"\n", 1)[0], b"#!/usr/bin/python3")
+                expected[path] = files[path]
+            entries = contract.get("entry_points", {}).get("console_scripts", [])
+            if entries:
+                config = configparser.ConfigParser()
+                config.read_string(files[prefix + "/entry_points.txt"].decode())
+                expected_entries = dict(tuple(v.strip() for v in entry.split("=", 1)) for entry in entries)
+                self.assertEqual(dict(config["console_scripts"]), expected_entries)
+                for command in expected_entries:
+                    path = "usr/local/bin/" + command
+                    self.assertEqual(files[path].split(b"\n", 1)[0], b"#!/usr/bin/python3")
+                    expected[path] = files[path]
+            self.assertEqual({p for p in files if not p.startswith(prefix + "/")}, set(expected) | generated)
+            for path, data in expected.items():
+                self.assertEqual(files[path], data, path)
+            for header_name, field in {
+                "Name": "name", "Version": "version", "Summary": "description", "License": "license",
+                "Author": "author", "Author-email": "author_email", "Home-page": "url",
+                "Maintainer": "maintainer", "Maintainer-email": "maintainer_email", "Keywords": "keywords",
+            }.items():
+                self.assertEqual(message[header_name], contract.get(field), (name, field))
+            self.assertEqual(set(message.get_all("Classifier", [])), set(contract.get("classifiers", [])))
+            requires = set(map(normalized_requirement, contract.get("install_requires", [])))
+            for extra, values in contract.get("extras_require", {}).items():
+                for value in values:
+                    requires.add(normalized_requirement(value + '; extra == "' + extra + '"'))
+            self.assertEqual(set(map(normalized_requirement, message.get_all("Requires-Dist", []))), requires)
+            path, info = metadata[name]
+            self.assertEqual(info["version"], contract["version"])
+            self.assertEqual(set(map(normalized_requirement, info["requires_dist"])), requires)
+            self.assertEqual(info["requires_python"], contract.get("python_requires", ""))
+            wheel = wheels.pop(info["wheel"]["filename"])
+            self.assertEqual(info["wheel"]["sha256"], hashlib.sha256(wheel.read_bytes()).hexdigest())
+            with zipfile.ZipFile(wheel) as archive:
+                wheel_metadata = archive.read(Path(prefix).name + "/METADATA")
+            self.assertEqual(files[header], wheel_metadata)
+            self.assertEqual(info["wheel"]["metadata_sha256"], hashlib.sha256(wheel_metadata).hexdigest())
+            self.assertEqual(info["wheel"]["tags"], ["py3-none-any"])
+            record = prefix + "/RECORD"
+            rows = list(csv.reader(io.StringIO(files[record].decode())))
+            recorded = set()
+            for relative, digest, size in rows:
+                filename = posixpath.normpath(site + "/" + relative)
+                recorded.add(filename)
+                if filename == record:
+                    self.assertEqual((digest, size), ("", ""))
+                else:
+                    data = files[filename]
+                    algorithm = digest.split("=", 1)[0]
+                    expected_digest = algorithm + "=" + base64.urlsafe_b64encode(hashlib.new(algorithm, data).digest()).decode().rstrip("=")
+                    self.assertEqual((digest, size), (expected_digest, str(len(data))))
+            self.assertEqual(recorded, set(files))
+            observed.append({"distribution": name, "files": len(files), "runtime_metadata_sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
+        self.assertEqual(set(metadata), {v["distribution"] for v in observed})
+        self.assertFalse(wheels)
+        DETAILS["distributions"] = observed
+
+    def test_installed_interfaces_and_generated_grpc(self):
+        probe = r'''import concurrent.futures,importlib,importlib.metadata,json,pathlib,runpy,sys
+site=pathlib.Path(sys.argv[1]).resolve()
+scripts=pathlib.Path(sys.argv[2]).resolve()
+fixture=pathlib.Path(sys.argv[3]).resolve()
+sys.path.insert(0,str(fixture))
+import sonic_platform.psu
+assert pathlib.Path(sonic_platform.psu.__file__).resolve().is_relative_to(fixture)
+for name in sys.argv[4:]:
+    dist=importlib.metadata.distribution(name)
+    assert pathlib.Path(dist.locate_file('')).resolve()==site,(name,dist.locate_file(''))
+    for ep in dist.entry_points:
+        if ep.group=='console_scripts':
+            function=ep.load()
+            assert callable(function)
+            assert pathlib.Path(sys.modules[function.__module__].__file__).resolve().is_relative_to(site)
+for script in scripts.iterdir():
+    if script.name in ['ledd','pcied','psud','syseepromd','thermalctld','sensormond','chassisd','chassis_db_init','stormond','bmcctld']:
+        runpy.run_path(str(script),run_name='installed_'+script.name)
+from proto_out import linkmgr_grpc_driver_pb2 as pb,linkmgr_grpc_driver_pb2_grpc as rpc
+import grpc
+assert pathlib.Path(pb.__file__).resolve().is_relative_to(site)
+class Service(rpc.DualToRActiveServicer):
+    def QueryAdminForwardingPortState(self, request, context):
+        return pb.AdminReply(portid=request.portid,state=request.state)
+server=grpc.server(concurrent.futures.ThreadPoolExecutor(max_workers=1))
+rpc.add_DualToRActiveServicer_to_server(Service(),server)
+port=server.add_insecure_port('127.0.0.1:0')
+assert port
+server.start()
+try:
+    with grpc.insecure_channel('127.0.0.1:'+str(port)) as channel:
+        result=rpc.DualToRActiveStub(channel).QueryAdminForwardingPortState(pb.AdminRequest(portid=[3,27],state=[True,False]),timeout=10)
+        assert list(result.portid)==[3,27] and list(result.state)==[True,False]
+finally:
+    server.stop(0).wait()
+print(json.dumps({'installed_interfaces':'all daemon scripts and entry points','grpc':'original generated API localhost request/reply'}))
+'''
+        names = [BytesParser().parsebytes(files[next(p for p in files if p.endswith(".dist-info/METADATA"))])["Name"] for files in self.payloads]
+        result = subprocess.run([str(self.installed.python), "-I", "-c", probe, str(self.installed.site), str(self.installed.scripts), str(self.hardware_fixture), *names],
+                                cwd=self.installed.root, env=self.installed.env, text=True, capture_output=True, timeout=60)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        DETAILS.update(json.loads(result.stdout))
+        DETAILS["hardware_provider"] = "Original psud tests/mocked_libs/sonic_platform fixture only; all daemon and native Common interfaces remain real"
+
+
+if __name__ == "__main__":
+    result = unittest.main(argv=[__file__, *REST], exit=False).result
+    write_wheel_receipt(getattr(InstalledRuntimeTest, "wheels", None), required=True,
+                        status="passed" if result.wasSuccessful() else "failed", details=DETAILS)
+    raise SystemExit(not result.wasSuccessful())
