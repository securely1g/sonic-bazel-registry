index 0000000000000000000000000000000000000000..2746f507ef7fd4046f15a0dc0b24adad12bdb025
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,66 @@
+"""Platform daemon wheels, their installed runtime layers and provenance."""
+
+load("@rules_python//python:py_binary.bzl", "py_binary")
+load("@sonic_build_infra//python:source_package.bzl", "python_runtime_packages")
+load(":bazel/daemons.bzl", "DAEMONS", "daemon_distribution")
+
+py_binary(
+    name = "wheel_builder",
+    srcs = ["bazel/build_wheel.py"],
+    main = "bazel/build_wheel.py",
+    python_version = "3.13",
+    deps = [
+        "@platform_daemons_build_pip//pytest_runner",
+        "@platform_daemons_build_pip//setuptools",
+        "@platform_daemons_build_pip//wheel",
+    ],
+)
+
+py_binary(
+    name = "ycable_protoc",
+    main_module = "grpc_tools.protoc",
+    python_version = "3.13",
+    deps = ["@platform_daemons_build_pip//grpcio_tools"],
+)
+
+genrule(
+    name = "ycabled_proto",
+    srcs = ["sonic-ycabled/proto/proto_out/linkmgr_grpc_driver.proto"],
+    outs = ["proto_out/linkmgr_grpc_driver_pb2.py", "proto_out/linkmgr_grpc_driver_pb2_grpc.py"],
+    tools = [":ycable_protoc"],
+    cmd = """
+        source=$(location sonic-ycabled/proto/proto_out/linkmgr_grpc_driver.proto)
+        include=$${source%/proto_out/*}
+        $(execpath :ycable_protoc) -I"$$include" --python_out=$(RULEDIR) --grpc_python_out=$(RULEDIR) "$$source"
+    """,
+    visibility = ["//visibility:public"],
+)
+
+[daemon_distribution(name) for name in DAEMONS]
+
+filegroup(
+    name = "daemons.wheels",
+    srcs = [name + ".wheel" for name in DAEMONS],
+    visibility = ["//visibility:public"],
+)
+
+python_runtime_packages(
+    name = "daemons.runtime",
+    deps = [name + ".runtime" for name in DAEMONS],
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "daemons.runtime_metadata",
+    srcs = [":daemons.runtime"],
+    output_group = "metadata",
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "test_sources",
+    srcs = glob(["sonic-*/**/*.py", "sonic-*/scripts/*", "sonic-*/tests/**", "sonic-*/pytest.ini", "sonic-*/setup.cfg"], exclude = ["**/*.pyc", "**/__pycache__/**"]),
+    visibility = ["//visibility:public"],
+)
+
+exports_files(glob(["sonic-*/setup.py"]) + ["bazel/requirements-codegen-lock.txt"])
diff --git a/bazel/build_wheel.py b/bazel/build_wheel.py
new file mode 100644
index 0000000000000000000000000000000000000000..909099c9c11977b5e5caef5431bf7908993e349c
--- /dev/null
+++ b/bazel/build_wheel.py
@@ -0,0 +1,38 @@
+"""Run the daemon's setuptools backend in a private, writable source tree."""
+
+import argparse
+import os
+from pathlib import Path
+import shutil
+import tempfile
+
+from setuptools.build_meta import build_wheel
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--setup", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--sources", nargs="+", type=Path, required=True)
+    parser.add_argument("--generated", nargs="+", type=Path, default=[])
+    args = parser.parse_args()
+    output = args.output.absolute()
+    os.environ["SOURCE_DATE_EPOCH"] = "315532800"
+    with tempfile.TemporaryDirectory() as directory:
+        source_root = Path(directory)
+        for source in args.sources:
+            relative = source.relative_to(args.setup.parent)
+            staged = source_root / relative
+            staged.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, staged)
+            staged.chmod(0o755 if relative.parts[0] == "scripts" else 0o644)
+        for source in args.generated:
+            shutil.copyfile(source, source_root / "proto_out" / source.name)
+        os.chdir(source_root)
+        filename = build_wheel(str(output.parent))
+        if filename != output.name:
+            raise ValueError(f"setup.py produced {filename}, expected {output.name}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bazel/daemons.bzl b/bazel/daemons.bzl
new file mode 100644
index 0000000000000000000000000000000000000000..682b8a84a71df25840d3d47fc0693b82c383c77b
--- /dev/null
+++ b/bazel/daemons.bzl
@@ -0,0 +1,52 @@
+"""Build each daemon's setuptools wheel and install it through the shared rule."""
+
+load("@sonic_build_infra//python:wheel_layer.bzl", "wheel_layer")
+
+DAEMONS = [
+    "sonic-bmcctld",
+    "sonic-chassisd",
+    "sonic-ledd",
+    "sonic-pcied",
+    "sonic-psud",
+    "sonic-sensormond",
+    "sonic-stormond",
+    "sonic-syseepromd",
+    "sonic-thermalctld",
+    "sonic-xcvrd",
+    "sonic-ycabled",
+]
+
+def daemon_distribution(name):
+    """Expose a pure wheel and its installed image payload from the owner's setup.py."""
+    version = "1.1" if name == "sonic-ledd" else "1.0"
+    stem = name.replace("-", "_") + "-" + version
+    setup = name + "/setup.py"
+    generated = [":ycabled_proto"] if name == "sonic-ycabled" else []
+    native.filegroup(
+        name = name + ".sources",
+        srcs = native.glob([name + "/**/*.py", name + "/setup.cfg"]) +
+               native.glob([name + "/scripts/*"], allow_empty = True),
+    )
+    native.genrule(
+        name = name + ".wheel",
+        srcs = [setup, ":" + name + ".sources"] + generated,
+        outs = [stem + "-py3-none-any.whl"],
+        tools = [":wheel_builder"],
+        cmd = "PYTHONHASHSEED=0 $(execpath :wheel_builder) --output $@ --setup $(location " + setup +
+              ") --sources $(locations :" + name + ".sources)" +
+              (" --generated $(locations :ycabled_proto)" if generated else ""),
+        visibility = ["//visibility:public"],
+    )
+    wheel_layer(
+        name = name + ".runtime",
+        wheels = [":" + name + ".wheel"],
+        site_packages = "/usr/local/lib/python3.13/dist-packages",
+        headers = "/usr/local/include/python3.13",
+        visibility = ["//visibility:public"],
+    )
+    native.filegroup(
+        name = name + ".runtime_metadata",
+        srcs = [":" + name + ".runtime"],
+        output_group = "metadata",
+        visibility = ["//visibility:public"],
+    )
