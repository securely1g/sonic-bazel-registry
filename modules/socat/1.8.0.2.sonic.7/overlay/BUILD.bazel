# Preserve the original changelogs in full. Compression uses the shared
# source-built gzip toolchain, with no filename or timestamp in the header.
[
    gzip_compress(
        name = name,
        src = source,
        level = 9,
    )
    for name, source in {
        "compress_development": "@socat_source//:DEVELOPMENT",
        "compress_examples": "@socat_source//:EXAMPLES",
        "compress_readme": "@socat_source//:README",
        "compress_changelog": "@socat_source//:CHANGES",
        "compress_changelog_debian": "@socat_source//:debian/changelog",
        "compress_socat_manpage": "@socat_source//:doc/socat.1",
    }.items()
]

