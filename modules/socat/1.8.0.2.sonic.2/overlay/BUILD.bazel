load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Preserve the public targets while building the complete Debian source tree.
[
    alias(
        name = name,
        actual = "@socat_source//:" + name,
    )
    for name in [
        "sources",
        "socat_build",
        "built_socat1",
        "built_filan",
        "built_procan",
        "socat_config_log",
        "socat_pkg",
        "socat_pkg.debug_symbols",
    ]
]

# Load only the installed TAR and its explicitly declared Debian libraries.
py_test(
    name = "socat_package_test",
    srcs = ["socat_package_test.py"],
    args = [
        "$(rootpath :socat_pkg)",
        "$(rootpath :socat_pkg.debug_symbols)",
        "$(rootpath @socat_source//:doc/socat.1)",
        "$(rootpath :socat_config_log)",
        "$(locations @socat_deps//:packages)",
    ],
    data = [
        ":socat_config_log",
        ":socat_pkg",
        ":socat_pkg.debug_symbols",
        "@socat_deps//:packages",
        "@socat_source//:COPYING",
        "@socat_source//:debian/control",
        "@socat_source//:debian/copyright",
        "@socat_source//:doc/socat.1",
        "@socat_source//:socat-broker.sh",
        "@socat_source//:socat-chain.sh",
        "@socat_source//:socat-mux.sh",
    ],
    python_version = "3.13",
)

# Keep package identities beside the runtime TAR producers.
exports_files(
    [
        "runtime_packages.json",
        "runtime_packages.md",
    ],
    visibility = ["//visibility:public"],
)
