module(
    name = "socat",
    version = "1.8.0.2.sonic.2",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "sonic-build-infra", version = "0.0.16-b6ab14f2c71022244488e1f48e1c8366771fd640", repo_name = "sonic_build_infra")

# Reuse the infrastructure module's pinned Debian snapshot and native toolchain.
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "socat_deps",
    packages = [
        "libc6",
        "libreadline-dev",
        "libreadline8t64",
        "libssl-dev",
        "libssl3t64",
        "libtinfo6",
        "libwrap0",
        "libwrap0-dev",
        "libzstd-dev",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "socat_deps")

register_toolchains(
    "@sonic_build_infra//tools/build_tools:make_toolchain",
    "@sonic_build_infra//tools/build_tools:m4_toolchain",
    "@sonic_build_infra//tools/build_tools:pkgconfig_toolchain",
)

# Original Debian source packaging used by SONiC's pinned Make source build.
# The payload is compiled by this module; this archive supplies metadata only.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "socat_debian",
    build_file_content = "exports_files(glob([\"**\"]))",
    sha256 = "04b361cd91884eda6ca9fe2890ca83a6abe73dd8ce75fe9927b2d8443af36123",
    strip_prefix = "debian",
    urls = ["https://snapshot.debian.org/archive/debian/20241222T205329Z/pool/main/s/socat/socat_1.8.0.2-1.debian.tar.xz"],
)

bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
