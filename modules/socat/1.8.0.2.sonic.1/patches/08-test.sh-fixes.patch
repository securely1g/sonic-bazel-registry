-	if [ -z "$NTERNET" ]; then
+	if [ -z "$INTERNET" ]; then
 	    echo "Use test.sh option --internet"
 	    return 255
 	fi
     fi
+
+    if [ "$caps" ]; then
+	allcaps="$(getpcaps $$)"
+	if [ $? -ne 0 ]; then
+	    echo "getpcaps program missing but caps requested"
+	    return 255
+	fi
+	for i in $caps; do
+	    if ! echo "$allcaps" | grep -q "$i"; then
+		echo "capability $i not available on host"
+		return 255;
+	    fi
+	done
+    fi
     return 0
 }
 
