Description: Terminate the network namespace path before printing it
 readlink() returns a byte count and does not append a NUL. Leave room for
 the terminator and add it on success so procan does not print uninitialized
 stack bytes after the namespace link. The Debian 1.8.0.2-1 patch series
 does not fix this block; it is still present in upstream release 1.8.1.3.
Author: Guohan Lu <securely1g@gmail.com>
Forwarded: no
Last-Update: 2026-11-04
--- a/procan.c
+++ b/procan.c
@@ -328,8 +328,11 @@
    {
       char path[PATH_MAX];
       char link[PATH_MAX];
+      ssize_t len;
       snprintf(path, sizeof(path)-1, "/proc/"F_pid"/ns/net", getpid());
-      if (readlink(path, link, sizeof(link)-1) >= 0) {
+      len = readlink(path, link, sizeof(link)-1);
+      if (len >= 0) {
+	 link[len] = '\0';
 	 fprintf(outfile, "Network namespace: %s", link);
       }
    }
