Description: Normalize the compiler path printed by procan
 Remove EXT_BUILD_ROOT only from the literal CC diagnostic string embedded
 in procan. This patch does not change the actual compiler invocation;
 the separate configure_make prefix-map option handles debug paths.
 Ordinary Make without EXT_BUILD_ROOT retains the original diagnostic value.
Origin: https://github.com/securely1g/sonic-bazel-registry/blob/f1272b2465b9beee06123e4982e1177a82c8c8c1/modules/socat/1.8.0.2.sonic.4/overlay/bazel/compiler_metadata.patch
 Introduced in registry PR171 for Socat 1.8.0.2 after Debian's pinned series.
Status: Registry-specific downstream adaptation; no upstream inclusion is asserted.

--- a/Makefile.in
+++ b/Makefile.in
@@ -110,7 +110,7 @@
 	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ socat.o libxio.a $(CLIBS)
 
 procan.o: $(srcdir)/procan.c
-	$(CC) $(CFLAGS) -c -D CC="\"$(CC)\"" -o $@ $(srcdir)/procan.c
+	$(CC) $(CFLAGS) -c -D CC="\"$(if $(EXT_BUILD_ROOT),$(subst $(EXT_BUILD_ROOT)/,./,$(CC)),$(CC))\"" -o $@ $(srcdir)/procan.c
 
 PROCAN_OBJS=procan_main.o procan.o procan-cdefs.o hostan.o error.o sycls.o sysutils.o utils.o vsnprintf_r.o snprinterr.o
 procan: $(PROCAN_OBJS)
