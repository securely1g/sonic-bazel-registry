++def normalize_label(value):
++    if value.startswith("@@//"):
++        return value[2:]
++    if value.startswith("@//"):
++        return value[1:]
++    if value.startswith("@@sonic-swss-common+//"):
++        return "@sonic_swss_common//" + value.split("//", 1)[1]
++    if value.startswith("@@sonic-build-infra+//"):
++        return "@sonic_build_infra//" + value.split("//", 1)[1]
++    return value
