++        with self.assertRaises(FileNotFoundError):
++            check.snapshot(report, self.execroot)
++        report["status"] = "fail"
++        with self.assertRaisesRegex(AssertionError, "did not pass"):
++            check.snapshot(report, self.execroot)
++
++
++if __name__ == "__main__":
++    unittest.main()
