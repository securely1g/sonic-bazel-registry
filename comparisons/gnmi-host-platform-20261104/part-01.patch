+    cmd = "$(execpath //generator:generator) -path=$$(dirname $(location yang/uncompressed.yang)) -output_file=$@ -package_name=cschema -generate_fakeroot -fakeroot_name=root -generate_getters -compress_paths $(location yang/uncompressed.yang)",
