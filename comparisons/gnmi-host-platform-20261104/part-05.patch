@@ -0,0 +1,171 @@
+module(
+    name = "sonic-gnmi",
+    version = "0.1.0-ce49e93eb3a0cff8daf77a3092535d76265ebc3d",
+    bazel_compatibility = [
+        ">=8.5.1",
+        "<=8.5.1",
+    ],
+)
+
+bazel_dep(name = "sonic-mgmt-common", version = "1.0.0-71eb5f710b5347ca0510ee8e3f5294a7c64bb744", repo_name = "sonic_mgmt_common")
+bazel_dep(name = "gazelle", version = "0.54.0")
+bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.1-20200309174518-a00bece872fc", repo_name = "com_github_openconfig_goyang")
+bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.1", repo_name = "com_github_openconfig_ygot")
+bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "sonic-build-infra", version = "0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e", repo_name = "sonic_build_infra")
+
+go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
+go_deps.from_file(go_work = "//:go.bazel.work")
+use_repo(go_deps, "cc_mvdan_sh_v3", "com_github_agiledragon_gomonkey_v2", "com_github_alicebob_miniredis_v2", "com_github_c9s_goprocinfo", "com_github_dgrijalva_jwt_go", "com_github_fsnotify_fsnotify", "com_github_go_redis_redismock_v9", "com_github_godbus_dbus_v5", "com_github_gogo_protobuf", "com_github_golang_glog", "com_github_golang_mock", "com_github_golang_protobuf", "com_github_google_gnxi", "com_github_google_go_cmp", "com_github_google_shlex", "com_github_kylelemons_godebug", "com_github_maruel_natural", "com_github_msteinert_pam", "com_github_openconfig_gnmi", "com_github_openconfig_gnoi", "com_github_openconfig_gnsi", "com_github_opencontainers_go_digest", "com_github_opencontainers_image_spec", "com_github_redis_go_redis_v9", "com_github_stretchr_testify", "com_github_workiva_go_datastructures", "in_gopkg_yaml_v2", "in_gopkg_yaml_v3", "land_oras_oras_go_v2", "org_golang_google_grpc", "org_golang_google_grpc_security_advancedtls", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_net", "org_golang_x_term", "org_golang_x_time")
+
+go_patches = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
+
+# The public goyang/ygot owners supply the same Go types as Management
+# Common. Keep the remaining upstream Go dependency settings unchanged.
+go_patches.gazelle_override(
+    directives = ["gazelle:proto disable_global"],
+    path = "github.com/openconfig/gnmi",
+)
+
+# These modules ship C++/proto Bazel files for their own workspace. Generate
+# their checked-in Go bindings as native Go packages for this consuming graph.
+[go_patches.gazelle_override(
+    build_file_generation = "clean",
+    directives = ["gazelle:proto disable_global"],
+    path = path,
+) for path in [
+    "github.com/openconfig/gnoi",
+    "github.com/openconfig/gnsi",
+]]
+
+# These are the existing Make/vendor patches, applied to isolated dependency
+# repositories. Build actions never modify go.mod, vendor, or the checkout.
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:jsonquery.patch"],
+    path = "github.com/antchfx/jsonquery",
+)
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:xmlquery.patch"],
+    path = "github.com/antchfx/xmlquery",
+)
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["@sonic_mgmt_common//patches:xpath.patch"],
+    path = "github.com/antchfx/xpath",
+)
+
+[go_patches.module_override(
+    patch_strip = 1,
+    patches = ["//patches/bazel:" + patch] + (["//patches/bazel:" + {
+        "0001-gnxi.patch": "0005-gnxi-build.patch",
+        "0002-gnmi.patch": "0006-gnmi-build.patch",
+    }[patch]] if path in [
+        "github.com/google/gnxi",
+        "github.com/openconfig/gnmi",
+    ] else []),
+    path = path,
+) for path, patch in [
+    ("github.com/google/gnxi", "0001-gnxi.patch"),
+    ("github.com/openconfig/gnmi", "0002-gnmi.patch"),
+    ("github.com/fsnotify/fsnotify", "0003-fsnotify.patch"),
+    ("google.golang.org/grpc/security/advancedtls", "0004-advancedtls.patch"),
+]]
+# Native gNMI deliberately omits Common's glog.patch for glog v1.2.4.
+
+# Match the owner generators and source toolchain in this consuming root.
+bazel_dep(name = "rules_python", version = "1.9.0")
+
+python = use_extension("@rules_python//python/extensions:python.bzl", "python")
+python.toolchain(python_version = "3.13")
+
+go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
+go_sdk.download(
+    name = "go_sdk",
+    version = "1.25.9",
+)
+
+bazel_dep(name = "sonic-swss-common", version = "0.0.8-43598143ef4a46431eae0859915cd7d951dad1ed", repo_name = "sonic_swss_common")
+
+# CodeQL stages the public native libraries required by Common.
+bazel_dep(name = "libnl3", version = "3.7.0.sonic.7", dev_dependency = True)
+
+bazel_dep(name = "bazel_skylib", version = "1.9.2")
+bazel_dep(name = "platforms", version = "1.1.0")
+bazel_dep(name = "rules_cc", version = "0.2.22")
+bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.14")
+bazel_dep(name = "rules_pkg", version = "1.1.0")
+bazel_dep(name = "rules_shell", version = "0.8.0")
+bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.1")
+
+gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
+use_repo(gcc, "gcc_toolchains")
+
+register_toolchains("@gcc_toolchains//:all")
+
+tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
+use_repo(tar_toolchains, "bsd_tar_toolchains")
+
+register_toolchains("@bsd_tar_toolchains//:all")
+
+# Common registers the Rust toolchain extension even for a Go-only consumer.
+bazel_dep(name = "rules_rs", version = "0.1.0")
+
+rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
+use_repo(rules_rust, "rules_rust")
+
+rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
+rust.toolchain(
+    edition = "2021",
+    versions = ["1.90.0"],
+)
+use_repo(rust, "rust_toolchains")
+
+register_toolchains(
+    "@rust_toolchains//:all",
+    dev_dependency = True,
+)
+
+pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
+pip.parse(
+    hub_name = "gnmi_pip",
+    python_version = "3.13",
+    requirements_lock = "//:requirements_lock.txt",
+)
+use_repo(pip, "gnmi_pip", "mgmt_pip")
+
+# Upstream proto rules require protoc29 options absent from Trixie protoc3.21.
+# Keep the existing upstream source compiler and the legacy Go plugin versions.
+bazel_dep(name = "protobuf", version = "29.1", repo_name = "com_google_protobuf")
+
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["//patches/bazel:0007-gnoi-build.patch"],
+    path = "github.com/openconfig/gnoi",
+)
+
+# Reuse the shared target APT set for the native Python embedding and PAM APIs.
+apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
+apt.install(
+    dependency_set = "trixie",
+    packages = [
+        "libpam0g:amd64",
+        "libpam0g-dev:amd64",
+    ],
+    suites = [
+        "trixie",
+        "trixie-updates",
+        "trixie-security",
+    ],
+)
+use_repo(apt, "trixie")
+
+go_patches.module_override(
+    patch_strip = 1,
+    patches = ["//patches/bazel:0008-pam-build.patch"],
+    path = "github.com/msteinert/pam",
+)
+
+bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
+bazel_dep(name = "libyang", version = "3.12.2.sonic.5")
diff --git a/modules/sonic-gnmi/0.1.0-ce49e93eb3a0cff8daf77a3092535d76265ebc3d/README.md b/modules/sonic-gnmi/0.1.0-ce49e93eb3a0cff8daf77a3092535d76265ebc3d/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..fc08006e71acab4b027ff4b40c9440284f3282a5
--- /dev/null
+++ b/modules/sonic-gnmi/0.1.0-ce49e93eb3a0cff8daf77a3092535d76265ebc3d/README.md
@@ -0,0 +1,28 @@
+# Native AMD64 gNMI runtime and source TARs
+
+Register the unchanged gNMI source `ce49e93eb3a0cff8daf77a3092535d76265ebc3d` from [gNMI #2](https://github.com/securely1g/sonic-gnmi/pull/2), which includes [#1](https://github.com/securely1g/sonic-gnmi/pull/1), for [buildimage #148](https://github.com/securely1g/sonic-buildimage/pull/148) and [issue #126](https://github.com/securely1g/sonic-buildimage/issues/126).
+
+The owner builds the existing nine telemetry, dialout and gNMI/gNOI programs and exports runtime, matching debug symbols, component sources and runtime metadata. SWSS Common owns the reusable CGo binding; Management Common owns generated schemas and Go interfaces. Legacy Make remains available. No DEB producer is selected.
+
+The registry and separate consumer select the same current shared dependencies:
+
+| Dependency | Selected input | Registration |
+| --- | --- | --- |
+| SWSS Common | `0.0.8-43598143ef4a46431eae0859915cd7d951dad1ed` | [#199](https://github.com/securely1g/sonic-bazel-registry/pull/199) |
+| Build infrastructure | `0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e` | [#218](https://github.com/securely1g/sonic-bazel-registry/pull/218) |
+| Management Common | `1.0.0-71eb5f710b5347ca0510ee8e3f5294a7c64bb744` | [#219](https://github.com/securely1g/sonic-bazel-registry/pull/219), child of [#216](https://github.com/securely1g/sonic-bazel-registry/pull/216) |
+| Shared goyang / ygot | `0.0.0.sonic.1-20200309174518-a00bece872fc` / `0.7.1.sonic.1` | published [#212](https://github.com/securely1g/sonic-bazel-registry/pull/212) / [#214](https://github.com/securely1g/sonic-bazel-registry/pull/214) |
+| libnl / Distroless | published `3.7.0.sonic.7` / `0.9.4.sonic.16` | [#181](https://github.com/securely1g/sonic-bazel-registry/pull/181) / [#200](https://github.com/securely1g/sonic-bazel-registry/pull/200) |
+
+The existing MODULE patch aligns the fetched source with these registry declarations byte-for-byte. The ordinary consumer uses public owner mappings without module/source overrides or duplicated goyang/ygot patches. The source archive integrity stays unchanged. Its Go workspace also receives the existing shared-root compatibility patch, selecting `golang.org/x/text v0.39.0` and `golang.org/x/sync v0.21.0`; both replacements match the composed consumer graph and retain Go 1.25.9. The `rules_go@0.64.1-sonic.1` declaration, unrelated feature patches, optimized configuration and empty global Go tags are unchanged.
+
+All six build targets and three tests are preserved. They build a separate public-library consumer plus runtime/debug/source artifacts and the generated YANG server; checks inspect package/source contracts and exercise telemetry/gnmi_get against private Redis fixtures. Source CI separately owns the original suites, CodeQL and compiler canaries. Fresh ordinary-consumer and downstream image acceptance is required for this updated dependency graph. Historical receipts remain associated with their original source/catalog revisions.
+
+This initial registration is scoped to native AMD64 Trixie; ARM, ASAN and full VS installer acceptance remain outside it. Keep Draft until the required source and registry changes land, the registration targets maintained main, and its current CI passes.
+
+This dependency refresh selects maintained infrastructure source 3ee15ec9 through
+registry #218. Its numeric version is .25; published .26 entries remain intact.
+Fresh module-graph checks must verify the selected version, followed by the
+unchanged ordinary-consumer outputs and tests. This metadata/source-patch proof
+does not establish native or image acceptance. Existing worker runs and earlier
+receipts retain their exact preceding dependency inputs.
