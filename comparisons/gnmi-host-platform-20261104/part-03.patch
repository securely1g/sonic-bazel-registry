+diff --git a/ygot/sonic_map_merge_test.go b/ygot/sonic_map_merge_test.go
+new file mode 100644
+--- /dev/null
++++ b/ygot/sonic_map_merge_test.go
+@@ -0,0 +1,75 @@
++package ygot
++
++import (
++	"reflect"
++	"testing"
++)
++
++func TestSONiCMapMergePreservesDestinationOnlyEntries(t *testing.T) {
++	for _, tt := range []struct {
++		name string
++		dst  map[string]*copyTest
++		src  map[string]*copyTest
++		want map[string]*copyTest
++	}{
++		{
++			name: "nil source retains destination",
++			dst:  map[string]*copyTest{"retained": {StringField: String("old")}},
++			want: map[string]*copyTest{"retained": {StringField: String("old")}},
++		},
++		{
++			name: "empty source retains destination",
++			dst:  map[string]*copyTest{"retained": {StringField: String("old")}},
++			src:  map[string]*copyTest{},
++			want: map[string]*copyTest{"retained": {StringField: String("old")}},
++		},
++		{
++			name: "disjoint source adds entry",
++			dst:  map[string]*copyTest{"retained": {StringField: String("old")}},
++			src:  map[string]*copyTest{"added": {StringField: String("new")}},
++			want: map[string]*copyTest{"retained": {StringField: String("old")}, "added": {StringField: String("new")}},
++		},
++		{
++			name: "matching source merges fields without dropping unrelated entry",
++			dst:  map[string]*copyTest{"retained": {StringField: String("old")}, "shared": {Uint32Field: Uint32(42)}},
++			src:  map[string]*copyTest{"shared": {StringField: String("new")}},
++			want: map[string]*copyTest{"retained": {StringField: String("old")}, "shared": {StringField: String("new"), Uint32Field: Uint32(42)}},
++		},
++	} {
++		t.Run(tt.name, func(t *testing.T) {
++			if err := copyMapField(reflect.ValueOf(&tt.dst).Elem(), reflect.ValueOf(tt.src)); err != nil {
++				t.Fatal(err)
++			}
++			if !reflect.DeepEqual(tt.dst, tt.want) {
++				t.Fatalf("merged map = %#v, want %#v", tt.dst, tt.want)
++			}
++		})
++	}
++}
++
++func TestSONiCMapMergePreservesSemanticKeyMatching(t *testing.T) {
++	dstKey, srcKey, retainedKey := String("same"), String("same"), String("retained")
++	if dstKey == srcKey {
++		t.Fatal("test requires distinct pointers with equal contents")
++	}
++	dst := map[*string]*copyTest{
++		dstKey:      {Uint32Field: Uint32(42)},
++		retainedKey: {StringField: String("old")},
++	}
++	src := map[*string]*copyTest{srcKey: {StringField: String("new")}}
++	if err := copyMapField(reflect.ValueOf(&dst).Elem(), reflect.ValueOf(src)); err != nil {
++		t.Fatal(err)
++	}
++	if len(dst) != 2 || dst[dstKey] != nil || dst[srcKey] == nil || dst[retainedKey] == nil {
++		t.Fatalf("expected source canonical key plus destination-only key, got %#v", dst)
++	}
++	if got := dst[srcKey]; got.StringField == nil || *got.StringField != "new" || got.Uint32Field == nil || *got.Uint32Field != 42 {
++		t.Fatalf("semantic key did not merge fields: %#v", got)
++	}
++	if got := dst[retainedKey]; got.StringField == nil || *got.StringField != "old" {
++		t.Fatalf("destination-only value changed: %#v", got)
++	}
++	if src[srcKey].Uint32Field != nil || *src[srcKey].StringField != "new" {
++		t.Fatal("source value was mutated")
++	}
++}
