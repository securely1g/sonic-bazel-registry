+module sonic-ordering {
+  namespace "urn:sonic:ordering";
+  prefix ordering;
+  identity ZULU;
+  identity ZULU_CHILD { base ZULU; }
+  identity ALPHA;
+  identity ALPHA_CHILD { base ALPHA; }
+  container root {
+    leaf selected {
+      type union {
+        type identityref { base ZULU; }
+        type identityref { base ALPHA; }
+      }
+    }
+  }
+}
diff --git a/modules/openconfig_ygot/0.7.1.sonic.1/overlay/ygen/sonic_union_order_test.go b/modules/openconfig_ygot/0.7.1.sonic.1/overlay/ygen/sonic_union_order_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fbeed0e64283f743e2353170f530a2a73562d820
--- /dev/null
+++ b/modules/openconfig_ygot/0.7.1.sonic.1/overlay/ygen/sonic_union_order_test.go
@@ -0,0 +1,30 @@
+package ygen
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSONiCUnionEnumReflectionOrder(t *testing.T) {
+	var first string
+	for round := 0; round < 64; round++ {
+		generator := NewYANGCodeGenerator(&GeneratorConfig{
+			PackageName: "ordering", Caller: "sonic-ordering-test",
+			GenerateJSONSchema: true,
+		})
+		generated, errors := generator.GenerateGoCode([]string{"sonic_union_order.yang"}, nil)
+		if len(errors) != 0 {
+			t.Fatal(errors)
+		}
+		reflection := strings.ToLower(generated.EnumTypeMap)
+		zulu, alpha := strings.Index(reflection, "zulu"), strings.Index(reflection, "alpha")
+		if zulu < 0 || alpha <= zulu || !strings.Contains(reflection, "/selected") {
+			t.Fatalf("declared union order lost in reflection map: %s", generated.EnumTypeMap)
+		}
+		if round == 0 {
+			first = generated.EnumTypeMap
+		} else if first != generated.EnumTypeMap {
+			t.Fatalf("round %d changed the union reflection output", round)
+		}
+	}
+}
