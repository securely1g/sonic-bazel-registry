+int
+Interface_Scan_Get_Count(void)
+{
+    int             i, sd;
+
+    if ((sd = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+        return (0);
+    if (ioctl(sd, SIOCGIFNUM, &i) == -1) {
+        close(sd);
+        return (0);
+    } else {
+        close(sd);
+        return (i);
+    }
+}
