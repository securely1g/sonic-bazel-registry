+int
+Interface_Scan_Get_Count(void)
+{
+    static time_t   scan_time = 0;
+    time_t          time_now = time(NULL);
+
+    if (!Interface_Count || (time_now > scan_time + 60)) {
+        scan_time = time_now;
+        Interface_Scan_Init();
+        Interface_Count = 0;
+        while (Interface_Scan_NextInt(NULL, NULL, NULL, NULL) != 0) {
+            Interface_Count++;
+        }
+    }
+    return (Interface_Count);
+}
