+int
+Interface_Scan_Get_Count(void)
+{
+    if (!Interface_Count) {
+        int             fd;
+        struct nmparms  p;
+        int             val;
+        unsigned int    ulen;
+        int             ret;
+
+        if ((fd = open_mib("/dev/ip", O_RDONLY, 0, NM_ASYNC_OFF)) >= 0) {
+            p.objid = ID_ifNumber;
+            p.buffer = (void *) &val;
+            ulen = sizeof(int);
+            p.len = &ulen;
+            if ((ret = get_mib_info(fd, &p)) == 0)
+                Interface_Count = val;
+            close_mib(fd);
+        }
+    }
+    return (Interface_Count);
+}
