diff --git a/modules/sonic-build-infra/0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e/patches/0003-retain-cli-tools.patch b/modules/sonic-build-infra/0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e/patches/0003-retain-cli-tools.patch
new file mode 100644
index 0000000000000000000000000000000000000000..6e9ffd1d2aeab0041b4c43c5ea4dce7fd1695fdf
--- /dev/null
+++ b/modules/sonic-build-infra/0.0.25-3ee15ec9b4d99d7f8eae3e324cead79b203b451e/patches/0003-retain-cli-tools.patch
@@ -0,0 +1,134 @@
+From: SONiC Bazel Registry <securely1g@gmail.com>
+Subject: [PATCH] Retain the registered CLI XML and patch tools
+
+Keep the existing registered tool interface while native component interfaces
+are now provided by the merged source.
+
+diff --git a/MODULE.bazel b/MODULE.bazel
+--- a/MODULE.bazel
++++ b/MODULE.bazel
+@@ -166,6 +166,7 @@
+             "libtool",
+             "libtool-bin",
+             "libxml-simple-perl",
++            "libxml2-utils",
+             "libzstd1",
+             "lz4",
+             "m4",
+@@ -173,6 +174,7 @@
+             "openssl",
+             "opensp",
+             "pahole",
++            "patch",
+             "perl",
+             "pkgconf",
+             "protobuf-compiler",
+@@ -186,6 +188,7 @@
+             "ss-dev",
+             "thrift-compiler",
+             "util-linux",
++            "xsltproc",
+             "xz-utils",
+             "zlib1g",
+             "zstd",
+diff --git a/tools/build_tools/BUILD.bazel b/tools/build_tools/BUILD.bazel
+--- a/tools/build_tools/BUILD.bazel
++++ b/tools/build_tools/BUILD.bazel
+@@ -490,6 +490,7 @@
+                 "libtool", "libtool-bin", "coreutils", "diffutils", "grep", "sed", "mawk",
+                 "findutils", "bash", "dash", "protobuf-compiler", "protobuf-compiler-grpc",
+                 "thrift-compiler", "python3", "python3-sphinx", "python3-pytest", "texinfo", "libxml-simple-perl", "graphviz", "fonts-dejavu-core", "debianutils",
++                "patch", "libxml2-utils", "xsltproc",
+             ]
+         ] + ["@build_tools//libprotobuf-dev:data"],
+     )
+@@ -507,7 +508,7 @@
+ 
+ [
+     build_tool(name = tool, tool = tool, runtime = ":foreign_runtime", visibility = ["//visibility:public"])
+-    for tool in ["autoreconf", "automake", "aclocal", "libtoolize", "protoc", "grpc_cpp_plugin", "grpc_python_plugin", "thrift", "python3", "sphinx-build", "makeinfo", "dot"]
++    for tool in ["autoreconf", "automake", "aclocal", "libtoolize", "protoc", "grpc_cpp_plugin", "grpc_python_plugin", "thrift", "python3", "sphinx-build", "makeinfo", "dot", "patch", "xmllint", "xsltproc"]
+ ]
+ 
+ py_test(
+diff --git a/tools/build_tools/defs.bzl b/tools/build_tools/defs.bzl
+--- a/tools/build_tools/defs.bzl
++++ b/tools/build_tools/defs.bzl
+@@ -163,7 +163,7 @@
+     implementation = _executable_impl,
+     executable = True,
+     attrs = {
+-        "tool": attr.string(mandatory = True, values = ["aspell", "doxygen", "make", "m4", "pkgconf", "perl", "bison", "flex", "autoconf", "autoheader", "autom4te", "compile_et", "mk_cmds", "autoreconf", "automake", "aclocal", "libtoolize", "protoc", "grpc_cpp_plugin", "grpc_python_plugin", "thrift", "python3", "sphinx-build", "makeinfo", "dot", "valgrind", "tclsh", "po2debconf", "msgcat", "docbook2man"]),
++        "tool": attr.string(mandatory = True, values = ["aspell", "doxygen", "make", "m4", "pkgconf", "perl", "bison", "flex", "autoconf", "autoheader", "autom4te", "compile_et", "mk_cmds", "autoreconf", "automake", "aclocal", "libtoolize", "protoc", "grpc_cpp_plugin", "grpc_python_plugin", "thrift", "python3", "sphinx-build", "makeinfo", "dot", "valgrind", "tclsh", "po2debconf", "msgcat", "docbook2man", "patch", "xmllint", "xsltproc"]),
+         "_launcher": attr.label(default = Label(":launcher.py"), allow_single_file = True, cfg = "exec"),
+         "runtime": attr.label(default = Label(":runtime"), allow_single_file = True, cfg = "exec"),
+         "_python": attr.label(default = Label(":python_runtime"), providers = [PythonRuntimeInfo], cfg = "exec"),
+diff --git a/tools/build_tools/prepare_runtime.py b/tools/build_tools/prepare_runtime.py
+--- a/tools/build_tools/prepare_runtime.py
++++ b/tools/build_tools/prepare_runtime.py
+@@ -149,7 +149,8 @@
+                      "thrift", "python3", "sphinx-build", "makeinfo", "dot", "bash", "dash", "sed", "mawk", "find", "xargs",
+                      "basename", "cat", "chmod", "cp", "cut", "dirname", "echo", "expr", "head", "install",
+                      "ln", "mkdir", "mv", "od", "printf", "readlink", "realpath", "rm", "rmdir",
+-                     "sleep", "sort", "tail", "test", "touch", "tr", "uname", "wc", "cmp", "diff"):
++                     "sleep", "sort", "tail", "test", "touch", "tr", "uname", "wc", "cmp", "diff",
++                     "patch", "xmllint", "xsltproc"):
+             tools[name] = root / "usr/bin" / name
+         for name in ("automake", "aclocal"):
+             candidates = sorted((root / "usr/bin").glob(name + "-[0-9]*"))
+@@ -349,6 +350,10 @@
+             script += 'pkgdatadir="$root/usr/share/libtool"\naclocaldir="$root/usr/share/aclocal"\nexport pkgdatadir aclocaldir\n'
+             script += 'exec "$root/bin/sh" "$root/' + str(binary.relative_to(root)) + '" "$@"\n'
+         else:
++            if name in ("xmllint", "xsltproc"):
++                # A caller supplies schemas/stylesheets explicitly. Never consult
++                # the worker's mutable /etc/xml/catalog as a hidden build input.
++                script += 'XML_CATALOG_FILES=\nexport XML_CATALOG_FILES\n'
+             argv0 = ' --argv0 "$root/bin/python3"' if name == "python3" else ""
+             script += 'exec "$root/' + str(loader.relative_to(root)) + '"' + argv0 + ' --library-path "' + library_path + '" "$root/' + str(binary.relative_to(root)) + '" "$@"\n'
+         write_launcher(root, name, script, executable)
+diff --git a/tools/build_tools/foreign_runtime_test.py b/tools/build_tools/foreign_runtime_test.py
+--- a/tools/build_tools/foreign_runtime_test.py
++++ b/tools/build_tools/foreign_runtime_test.py
+@@ -119,7 +119,31 @@
+         assert all(not p.startswith(("/usr/", "/lib/")) for p in python), python
+         perl = json.loads(run("perl", ["-MJSON::PP", "-MXML::Simple", "-MData::Dumper", "-MGetopt::Long", "-e", 'print encode_json(\\%INC)']))
+         assert all(str(runtime) in p for p in perl.values()), perl
++        # Framework CLI owns normal-diff patches and XSD/XSLT inputs. Exercise
++        # the real shared tools after relocation with no worker tools on PATH.
++        (work / "patched.txt").write_text("before\n")
++        (work / "change.diff").write_text("1c1\n< before\n---\n> after\n")
++        run("patch", ["--batch", "--forward", "--fuzz=0", "patched.txt", "change.diff"])
++        assert (work / "patched.txt").read_text() == "after\n"
++        reverse = subprocess.run([str(tools / "patch"), "--batch", "--forward", "--fuzz=0",
++                                  "patched.txt", "change.diff"], cwd=work, env=env, capture_output=True)
++        assert reverse.returncode != 0 and (work / "patched.txt").read_text() == "after\n"
++        (work / "schema.xsd").write_text(
++            '<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">'
++            '<xs:element name="value" type="xs:integer"/></xs:schema>')
++        (work / "input.xml").write_text('<value>42</value>')
++        run("xmllint", ["--nonet", "--noout", "--schema", "schema.xsd", "input.xml"])
++        (work / "invalid.xml").write_text('<value>invalid</value>')
++        invalid = subprocess.run([str(tools / "xmllint"), "--nonet", "--noout", "--schema",
++                                  "schema.xsd", "invalid.xml"], cwd=work, env=env, capture_output=True)
++        assert invalid.returncode != 0, invalid
++        (work / "transform.xsl").write_text(
++            '<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">'
++            '<xsl:output method="text"/><xsl:template match="/">'
++            '<xsl:value-of select="value"/></xsl:template></xsl:stylesheet>')
++        assert run("xsltproc", ["--nonet", "transform.xsl", "input.xml"]) == b"42"
+         manifest = json.loads((runtime / "toolchain.json").read_text())
++        assert all(name in manifest["tools"] for name in ("patch", "xmllint", "xsltproc"))
+         graph = run("dot", ["-Tsvg"], data=b"digraph G { a -> b }\n")
+         assert b"<svg" in graph and b"a" in graph
+         metadata = root / "relocated-metadata"
+@@ -130,7 +154,8 @@
+         print(json.dumps({"architecture": platform.machine(), "profile": manifest["profile"],
+                           "relocated": True, "empty_path": True, "autotools": True,
+                           "protobuf_cpp_python_grpc": True, "thrift_cpp": True,
+-                          "graphviz_svg": True, "private_python": python, "private_perl": perl}, indent=2))
++                          "patch_apply_reject_reverse": True, "xml_schema_reject_invalid": True,
++                          "xslt_transform": True, "graphviz_svg": True, "private_python": python, "private_perl": perl}, indent=2))
+ 
+ 
+ if __name__ == "__main__":
