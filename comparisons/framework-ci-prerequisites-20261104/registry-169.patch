+/*
+ * snmp_sess_perror(): print a error stored in a session pointer 
+ */
+void
+snmp_sess_perror(const char *prog_string, netsnmp_session * ss)
+{
+    netsnmp_sess_log_error(LOG_ERR, prog_string, ss);
+}
