index 0000000000000000000000000000000000000000..0077ca4fd157dbbb2969f22768d2a67e9d6d5fb1
--- /dev/null
+++ b/modules/openconfig_ygot/0.7.1.sonic.1/integration/MODULE.bazel
@@ -0,0 +1,19 @@
+module(name = "sonic_ygot_consumer")
+
+bazel_dep(name = "openconfig_ygot", version = "0.7.1.sonic.1")
+bazel_dep(name = "openconfig_goyang", version = "0.0.0.sonic.1-20200309174518-a00bece872fc")
+bazel_dep(name = "gazelle", version = "0.54.0")
+bazel_dep(name = "rules_go", version = "0.64.1-sonic.1", repo_name = "io_bazel_rules_go")
+bazel_dep(name = "sonic-build-infra", version = "0.0.25-34de7330abc72229dfc8dab88dec71b89c52aa88", repo_name = "sonic_build_infra")
+
+go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
+go_sdk.download(version = "1.25.9")
+
+go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
+go_deps.from_file(go_mod = "//:go.mod")
+
+# Preserve management-common's existing treatment of checked-in gNMI protobufs.
+go_deps.gazelle_override(
+    directives = ["gazelle:proto disable_global"],
+    path = "github.com/openconfig/gnmi",
+)
