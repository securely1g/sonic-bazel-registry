+    visibility = ["//visibility:public"],
+)
+
+# Match the original go:generate preparation required by upstream Make/CI.
+genrule(
+    name = "generated_uncompressed",
+    srcs = glob(["yang/**"]),
+    outs = ["generated_uncompressed.go"],
+    cmd = "$(execpath //generator:generator) -path=$$(dirname $(location yang/uncompressed.yang)) -output_file=$@ -package_name=uschema -generate_fakeroot -fakeroot_name=root -generate_getters $(location yang/uncompressed.yang)",
+    tools = ["//generator"],
+    visibility = ["//visibility:public"],
+)
