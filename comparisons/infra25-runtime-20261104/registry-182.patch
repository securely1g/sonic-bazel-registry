+    name = "uncompressed_test",
+    srcs = ["cp_test.go"],
+    args = ["-test.v"],
+    embed = [":uncompressed"],
+    deps = [
+        "//integration_tests/uncompressed/cschema",
+        "//integration_tests/uncompressed/uschema",
+        "//ygot",
+    ],
