+load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
+
+go_library(
+    name = "uncompressed",
+    srcs = ["cp.go"],
+    importpath = "github.com/openconfig/ygot/integration_tests/uncompressed",
+    visibility = ["//visibility:public"],
