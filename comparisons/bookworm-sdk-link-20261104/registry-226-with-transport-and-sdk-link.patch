+    "gcc-14.2.0-linux-target-x86_64-host-x86_64",
+    "gcc_toolchains",
+)
+
+# Architectures with native build tools and general C/C++ toolchain setup.
+NATIVE_ARCHITECTURES = [
+    "amd64",
+    "arm64",
+]
