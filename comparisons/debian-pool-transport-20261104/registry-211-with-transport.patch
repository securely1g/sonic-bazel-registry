diff --git a/modules/sonic-build-infra/0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec/MODULE.bazel b/modules/sonic-build-infra/0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec/MODULE.bazel
new file mode 100644
index 0000000000000000000000000000000000000000..f133964e7263a944845dc85885780e9b841afe26
--- /dev/null
+++ b/modules/sonic-build-infra/0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec/MODULE.bazel
@@ -0,0 +1,1186 @@
+# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
+module(
+    name = "sonic-build-infra",
+    version = "0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec",
+    bazel_compatibility = [
+        ">=8.5.1",
+        "<=8.5.1",
+    ],
+)
+
+bazel_dep(name = "swig", version = "4.3.0.bcr.2")
+bazel_dep(name = "rules_cc", version = "0.2.16")
+bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
+bazel_dep(name = "rules_python", version = "1.7.0")
+bazel_dep(name = "platforms", version = "1.0.0")
+bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
+
+sysroot_tar = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
+use_repo(sysroot_tar, "bsd_tar_toolchains_linux_amd64", "bsd_tar_toolchains_linux_arm64")
+
+# Root builds must select the patch even when another dependency requests the
+# upstream release, which sorts above its SONiC prerelease version.
+single_version_override(
+    module_name = "tar.bzl",
+    version = "0.10.5-sonic.1",
+)
+
+bazel_dep(name = "bazel_skylib", version = "1.9.0")
+bazel_dep(name = "bazel_lib", version = "3.1.1")
+bazel_dep(name = "aspect_rules_py", version = "1.11.2")
+bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
+
+# A local module providing a cc_binary in a separate module, used only by our
+# tests to prove that we correctly package binaries from another module.
+bazel_dep(name = "deploy_tar_external_binary", version = "0.0.0", dev_dependency = True)
+local_path_override(
+    module_name = "deploy_tar_external_binary",
+    path = "tests/external_binary_module",
+)
+
+bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
+
+# The SONiC patch sorts above upstream 0.9.4 without a root override.
+bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.15")
+
+# One multiarch directory shared by GCC and Clang on both architectures.
+# Consumers import this same repository through use_extension/use_repo.
+sysroots = use_extension("//toolchains/sysroot:extensions.bzl", "sysroots")
+sysroots.debian(name = "sonic_sysroot")
+use_repo(sysroots, "sonic_sysroot")
+
+gcc = use_extension("//toolchains/gcc:extensions.bzl", "gcc")
+use_repo(
+    gcc,
+    "gcc-14.2.0-linux-target-aarch64-host-aarch64",
+    "gcc-14.2.0-linux-target-aarch64-host-x86_64",
+    "gcc-14.2.0-linux-target-x86_64-host-x86_64",
