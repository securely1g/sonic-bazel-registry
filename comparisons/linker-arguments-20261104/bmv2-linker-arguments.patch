diff --git a/modules/sonic-build-infra/0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec/README.md b/modules/sonic-build-infra/0.0.26-f6da55505437cb139fdf610db8c61cb9420b0fec/README.md
